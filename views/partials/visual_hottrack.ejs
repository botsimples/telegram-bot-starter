/* ======= TigerFy Gold — Modo Claro e Escuro ======= */

:root {
  --bg-color: #0a0a0a;
  --text-color: #fff;
  --muted-color: #b4b4b4;
  --accent-color: #ffcc00;
  --card-bg: rgba(18,18,18,0.85);
  --card-border: rgba(255,204,0,0.12);
  --input-bg: #111;
  --hover-bg: rgba(255,204,0,0.08);
}

[data-theme="light"] {
  --bg-color: #f8f8f8;
  --text-color: #111;
  --muted-color: #555;
  --accent-color: #d4a100;
  --card-bg: #fff;
  --card-border: rgba(0,0,0,0.08);
  --input-bg: #f2f2f2;
  --hover-bg: rgba(0,0,0,0.04);
}

/* ======= Base ======= */
body {
  background: var(--bg-color);
  color: var(--text-color);
  font-family: "Inter", sans-serif;
  transition: background 0.3s, color 0.3s;
}

/* ======= Títulos ======= */
h1, h2, h3, h4 {
  color: var(--accent-color);
  font-weight: 700;
}

/* ======= Cards e Boxes ======= */
.card, .box, .stats-container {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 0 15px rgba(255,204,0,0.08);
  transition: background 0.3s, border 0.3s;
}

/* ======= Tabelas ======= */
table {
  width: 100%;
  border-collapse: collapse;
  background: var(--card-bg);
  border-radius: 8px;
  overflow: hidden;
  transition: background 0.3s;
}

table th {
  background: var(--hover-bg);
  color: var(--accent-color);
  font-weight: 600;
  padding: 10px;
  text-align: left;
  border-bottom: 1px solid var(--card-border);
}

table td {
  padding: 10px;
  border-bottom: 1px solid var(--card-border);
  color: var(--muted-color);
}

table tr:hover {
  background: var(--hover-bg);
}

/* ======= Botões ======= */
button, .btn, input[type="submit"] {
  background: linear-gradient(90deg, var(--accent-color), #b38f00);
  border: none;
  color: #000;
  font-weight: 700;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  transition: 0.25s;
}
button:hover, .btn:hover { filter: brightness(1.15); }

/* ======= Inputs ======= */
input, select, textarea {
  background: var(--input-bg);
  border: 1px solid var(--card-border);
  color: var(--text-color);
  border-radius: 6px;
  padding: 8px 10px;
  transition: background 0.3s, border 0.3s;
}

input:focus, select:focus, textarea:focus {
  border-color: var(--accent-color);
  outline: none;
}

/* ======= Textos gerais ======= */
label, small, span, p {
  color: var(--muted-color);
}

/* ======= Seções ======= */
section { margin-bottom: 25px; }

/* ======= Placeholder de gráficos ======= */
.chart-box {
  border: 1px dashed var(--card-border);
  border-radius: 10px;
  padding: 30px;
  text-align: center;
  color: var(--muted-color);
  background: var(--card-bg);
}

/* ======= Scrollbar ======= */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-thumb {
  background: var(--accent-color);
  border-radius: 4px;
}

/* ======= Responsivo ======= */
@media (max-width: 1024px) {
  table th, table td { font-size: 13px; }
  button, .btn { padding: 8px 14px; font-size: 14px; }
}
