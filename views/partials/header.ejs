    <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16v16H4zM8 8h8v8H8z" />
