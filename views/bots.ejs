<div class="manage-offers fade-in">
  <header class="manage-header">
    <div>
      <h1>📦 Gerenciar Ofertas</h1>
      <p>Edite e personalize seus bots e rastreamentos diretamente pelo painel.</p>
    </div>
    <button class="btn-gold" id="btn-new-offer">+ Nova Oferta</button>
  </header>

  <section class="offers-list">
    <div class="offer-card">
      <div class="offer-info">
        <h3>Acesso VIP 🔥</h3>
        <span class="tag">Bot Padrão</span>
        <p>Criada em: 10/11/2025</p>
      </div>

      <div class="offer-actions">
        <button class="btn-dark-sm" onclick="openSettings()">⚙️ Editar</button>
        <button class="btn-dark-sm">➕ Adicionar Bot</button>
        <button class="btn-outline-sm">🗑️ Excluir</button>
      </div>
    </div>

    <div class="offer-card empty">
      <p>Nenhuma oferta criada ainda.</p>
    </div>
  </section>
</div>

<!-- SIDEBAR MODAL DE CONFIGURAÇÃO -->
<div id="sidebar-settings" class="settings-sidebar">
  <div class="sidebar-content">
    <div class="sidebar-header">
      <h2>⚙️ Configurações da Oferta</h2>
      <button class="close-sidebar" onclick="closeSettings()">✕</button>
    </div>

    <form>
      <label>Token do Bot (BotFather)</label>
      <input type="text" placeholder="Insira o token gerado pelo BotFather" />

      <label>Nome do Bot (opcional)</label>
      <input type="text" placeholder="Ex: caronavip_bot" />

      <label>Tipo de Traqueamento</label>
      <select>
        <option>Usar seu Traqueamento Próprio</option>
        <option>Facebook Pixel Apenas</option>
        <option disabled>UTMify + Pixel Facebook (em breve)</option>
        <option disabled>UTMify + Pixel UTMIFY (em breve)</option>
      </select>

      <label>Tipo de Bot</label>
      <select>
        <option>Bot Padrão</option>
        <option>Fluxo Estilo ManyChat</option>
        <option disabled>Fluxo Bot (em breve)</option>
      </select>

      <div class="sidebar-actions">
        <button type="button" class="btn-gold">💾 Salvar Alterações</button>
      </div>
    </form>
  </div>
</div>

<style>
  .manage-offers { padding:40px; }
  .manage-header { display:flex; justify-content:space-between; align-items:center; }
  .manage-header h1 { color:#ffcc00; margin-bottom:4px; }
  .manage-header p { color:#b4b4b4; }

  .offers-list { display:flex; flex-direction:column; gap:18px; margin-top:30px; }
  .offer-card {
    background:rgba(25,25,25,.85);
    border:1px solid rgba(255,204,0,.08);
    border-radius:10px;
    padding:20px;
    display:flex; justify-content:space-between; align-items:center;
  }

  .offer-info h3 { color:#fff; margin:0; }
  .offer-info .tag { background:rgba(255,204,0,.1); color:#ffcc00; font-size:.8rem; padding:2px 8px; border-radius:6px; margin-top:5px; display:inline-block; }

  .offer-actions { display:flex; gap:10px; }
  .btn-dark-sm, .btn-outline-sm {
    background:rgba(30,30,30,.9);
    border:1px solid rgba(255,204,0,.15);
    color:#ffcc00; font-size:.85rem;
    border-radius:8px; padding:8px 14px;
    cursor:pointer; transition:all .25s ease;
  }
  .btn-dark-sm:hover { background:rgba(255,204,0,.1); }
  .btn-outline-sm { color:#b4b4b4; border:1px solid rgba(255,255,255,.05); }
  .btn-outline-sm:hover { color:#fff; }

  .empty { text-align:center; color:#777; font-size:.9rem; padding:40px 0; }

  /* SIDEBAR SETTINGS */
  .settings-sidebar {
    display:none;
    position:fixed;
    top:0; right:0;
    width:400px; height:100vh;
    background:rgba(10,10,10,.95);
    border-left:1px solid rgba(255,204,0,.1);
    box-shadow:-4px 0 15px rgba(0,0,0,.4);
    z-index:9999;
    animation:slideIn .4s ease;
  }

  .sidebar-content { padding:30px; overflow-y:auto; height:100%; }
  .sidebar-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
  .sidebar-header h2 { color:#ffcc00; font-size:1.3rem; }
  .close-sidebar { background:none; border:none; color:#fff; font-size:1.3rem; cursor:pointer; }

  .sidebar-content label { color:#ffcc00; display:block; margin:16px 0 6px; font-weight:600; }
  .sidebar-content input, select {
    width:100%; padding:10px 12px;
    background:rgba(25,25,25,.85);
    border:1px solid rgba(255,204,0,.1);
    border-radius:8px; color:#fff;
  }

  .sidebar-actions { margin-top:25px; text-align:right; }

  @keyframes slideIn {
    from { right:-420px; opacity:0; }
    to { right:0; opacity:1; }
  }
</style>

<script>
  function openSettings() {
    document.getElementById("sidebar-settings").style.display = "block";
  }
  function closeSettings() {
    document.getElementById("sidebar-settings").style.display = "none";
  }
</script>
