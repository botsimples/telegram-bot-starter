<%- include('partials/visual_hottrack') %>

<div class="tiger-offers">
  <div class="offers-header">
    <h1>Minhas Ofertas</h1>
    <p>Gerencie, crie e visualize fluxos inteligentes, automações e métricas dos seus bots Telegram.</p>
  </div>

  <div class="offers-grid">
    <div class="offer-card">
      <div class="icon">
        <svg width="36" height="36" stroke="#ffcc00" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="30" height="20" rx="4"/>
          <path d="M8 28h20M12 32h12"/>
          <circle cx="18" cy="13" r="4"/>
        </svg>
      </div>
      <h3>Criar Oferta</h3>
      <p>Defina nome, valor e parâmetros de traqueamento para seu bot Telegram.</p>
      <button class="btn-primary">Criar</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg width="36" height="36" stroke="#ffcc00" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="30" height="28" rx="4"/>
          <path d="M3 12h30M12 4v28M18 20h9M18 25h9"/>
        </svg>
      </div>
      <h3>Gerenciar Ofertas</h3>
      <p>Edite, duplique e acompanhe o desempenho das suas campanhas.</p>
      <button class="btn-primary">Acessar</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg width="36" height="36" stroke="#ffcc00" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="12" height="8" rx="2"/>
          <rect x="21" y="3" width="12" height="8" rx="2"/>
          <rect x="3" y="17" width="12" height="8" rx="2"/>
          <rect x="21" y="17" width="12" height="8" rx="2"/>
          <path d="M9 11v6M27 11v6"/>
        </svg>
      </div>
      <h3>Criar Fluxo Visual</h3>
      <p>Monte visualmente o funil do bot com blocos e conexões interativas.</p>
      <button class="btn-primary" onclick="openFlow()">Abrir Editor</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg width="36" height="36" stroke="#ffcc00" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="30" height="22" rx="3"/>
          <polygon points="15,12 24,18 15,24" fill="#ffcc00"/>
        </svg>
      </div>
      <h3>Ver Tutoriais</h3>
      <p>Aprenda passo a passo com vídeos e estratégias avançadas.</p>
      <button class="btn-primary" onclick="openTutorial()">Assistir</button>
    </div>
  </div>
</div>

<!-- MODAL: TIGERFLOW -->
<div class="modal" id="flowModal">
  <div class="modal-content huge">
    <span class="close" onclick="closeFlow()">&times;</span>
    <h2>Editor Visual — TigerFlow 2.0</h2>
    <p class="sub">Arraste blocos, conecte nós e salve seu funil.</p>

    <div id="flowCanvas">
      <svg id="connectionLayer"></svg>
      <div id="nodesLayer"></div>
    </div>

    <div class="flow-controls">
      <button onclick="addNode()">+ Adicionar Bloco</button>
      <button onclick="saveFlow()">💾 Salvar</button>
      <button onclick="clearFlow()">🧹 Limpar</button>
    </div>
  </div>
</div>

<script>
  // --- FLOW MODAL ---
  const flowModal = document.getElementById("flowModal");
  const canvas = document.getElementById("nodesLayer");
  const svgLayer = document.getElementById("connectionLayer");

  let nodes = [];
  let connections = [];
  let connecting = null;

  // Abrir e restaurar fluxo salvo
  function openFlow() {
    flowModal.style.display = "flex";
    restoreFlow();
  }

  function closeFlow() {
    flowModal.style.display = "none";
  }

  // Adicionar bloco
  function addNode() {
    const node = document.createElement("div");
    node.className = "node";
    node.innerText = "Novo Bloco";
    node.contentEditable = true;
    node.style.left = 100 + Math.random() * 500 + "px";
    node.style.top = 100 + Math.random() * 300 + "px";
    node.draggable = false;

    node.addEventListener("mousedown", e => startDrag(e, node));
    node.addEventListener("dblclick", e => startConnection(node));
    canvas.appendChild(node);
    nodes.push(node);
  }

  // Arrastar blocos
  let offsetX, offsetY, draggingNode = null;
  function startDrag(e, node) {
    if (connecting) return;
    draggingNode = node;
    offsetX = e.clientX - node.offsetLeft;
    offsetY = e.clientY - node.offsetTop;
    document.addEventListener("mousemove", drag);
    document.addEventListener("mouseup", stopDrag);
  }

  function drag(e) {
    if (!draggingNode) return;
    draggingNode.style.left = e.clientX - offsetX + "px";
    draggingNode.style.top = e.clientY - offsetY + "px";
    updateConnections();
  }

  function stopDrag() {
    draggingNode = null;
    document.removeEventListener("mousemove", drag);
    document.removeEventListener("mouseup", stopDrag);
    saveFlow();
  }

  // Conectar blocos
  function startConnection(node) {
    if (!connecting) {
      connecting = node;
      node.classList.add("selected");
    } else if (connecting !== node) {
      createConnection(connecting, node);
      connecting.classList.remove("selected");
      connecting = null;
      updateConnections();
      saveFlow();
    }
  }

  // Criar linha
  function createConnection(a, b) {
    const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
    line.setAttribute("stroke", "#ffcc00");
    line.setAttribute("stroke-width", "2");
    line.dataset.from = a.innerText;
    line.dataset.to = b.innerText;
    svgLayer.appendChild(line);
    connections.push({ from: a.innerText, to: b.innerText, line });
  }

  // Atualizar conexões
  function updateConnections() {
    connections.forEach(conn => {
      const a = nodes.find(n => n.innerText === conn.from);
      const b = nodes.find(n => n.innerText === conn.to);
      if (!a || !b) return;
      const x1 = a.offsetLeft + a.offsetWidth / 2;
      const y1 = a.offsetTop + a.offsetHeight / 2;
      const x2 = b.offsetLeft + b.offsetWidth / 2;
      const y2 = b.offsetTop + b.offsetHeight / 2;
      conn.line.setAttribute("x1", x1);
      conn.line.setAttribute("y1", y1);
      conn.line.setAttribute("x2", x2);
      conn.line.setAttribute("y2", y2);
    });
  }

  // Salvar e restaurar fluxo
  function saveFlow() {
    const data = nodes.map(n => ({
      text: n.innerText,
      x: n.style.left,
      y: n.style.top
    }));
    const conns = connections.map(c => ({ from: c.from, to: c.to }));
    localStorage.setItem("tigerflow", JSON.stringify({ nodes: data, connections: conns }));
  }

  function restoreFlow() {
    const saved = localStorage.getItem("tigerflow");
    if (!saved) return;
    const { nodes: savedNodes, connections: savedConns } = JSON.parse(saved);

    canvas.innerHTML = "";
    svgLayer.innerHTML = "";
    nodes = [];
    connections = [];

    savedNodes.forEach(n => {
      const node = document.createElement("div");
      node.className = "node";
      node.innerText = n.text;
      node.style.left = n.x;
      node.style.top = n.y;
      node.addEventListener("mousedown", e => startDrag(e, node));
      node.addEventListener("dblclick", e => startConnection(node));
      canvas.appendChild(node);
      nodes.push(node);
    });

    savedConns.forEach(c => {
      const a = nodes.find(n => n.innerText === c.from);
      const b = nodes.find(n => n.innerText === c.to);
      if (a && b) createConnection(a, b);
    });

    updateConnections();
  }

  function clearFlow() {
    if (confirm("Limpar todo o fluxo?")) {
      localStorage.removeItem("tigerflow");
      canvas.innerHTML = "";
      svgLayer.innerHTML = "";
      nodes = [];
      connections = [];
    }
  }

  window.addEventListener("resize", updateConnections);
</script>

<style>
  html,body{margin:0;padding:0;background:#0a0a0a;color:#fff;font-family:Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased;}
  *{box-sizing:border-box;}
  ::-webkit-scrollbar{display:none!important;}
  .tiger-offers{padding:60px 80px 100px 130px;transform:scale(0.9) translateX(70px);transform-origin:top left;}
  .offers-header{text-align:center;margin-bottom:10px;}
  .offers-header h1{color:#ffcc00;font-size:2rem;margin:0;}
  .offers-header p{color:#b4b4b4;font-size:.95rem;margin-top:8px;}
  .offers-grid{display:grid;grid-template-columns:repeat(4,minmax(260px,1fr));gap:30px;margin-top:30px;}
  .offer-card{background:rgba(255,255,255,0.03);border:1px solid rgba(255,204,0,0.12);border-radius:16px;padding:28px 22px;text-align:center;transition:.3s;}
  .offer-card:hover{transform:translateY(-5px);box-shadow:0 0 20px rgba(255,204,0,0.25);}
  .icon{margin-bottom:15px;transition:filter .3s,transform .3s;}
  .offer-card:hover .icon{filter:drop-shadow(0 0 8px rgba(255,204,0,0.6));transform:scale(1.1);}
  .btn-primary{background:linear-gradient(90deg,#ffcc00,#d4a100);border:none;padding:10px 20px;border-radius:8px;color:#000;font-weight:700;cursor:pointer;}
  
  .modal{display:none;position:fixed;z-index:99;inset:0;background:rgba(0,0,0,0.85);align-items:center;justify-content:center;}
  .modal-content.huge{width:90%;max-width:1600px;height:90vh;display:flex;flex-direction:column;gap:10px;background:#0a0a0a;border:1px solid rgba(255,204,0,0.25);border-radius:12px;padding:20px;position:relative;}
  .close{position:absolute;top:10px;right:15px;font-size:1.8rem;cursor:pointer;color:#ffcc00;}
  
  #flowCanvas{flex:1;position:relative;overflow:hidden;border-radius:10px;background:radial-gradient(rgba(255,255,255,0.05) 1px,transparent 1px);background-size:25px 25px;}
  #nodesLayer{position:absolute;inset:0;}
  #connectionLayer{position:absolute;inset:0;width:100%;height:100%;}
  .node{position:absolute;background:rgba(255,204,0,0.1);border:1px solid rgba(255,204,0,0.4);border-radius:8px;padding:10px 14px;min-width:120px;text-align:center;cursor:grab;font-size:.9rem;}
  .node.selected{outline:2px solid #ffcc00;}
  .flow-controls{text-align:center;gap:10px;margin-top:8px;}
  .flow-controls button{margin:0 10px;padding:10px 18px;border:none;border-radius:8px;background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;font-weight:700;cursor:pointer;}
</style>
