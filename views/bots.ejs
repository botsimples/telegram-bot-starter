<% title = "Bots - BotSimples"; %>
<main class="space-y-6">
  <h1 class="text-2xl font-semibold text-hot-primary">Bots</h1>

  <div class="panel p-4">
    <h3 class="font-medium mb-3">Criar novo bot</h3>
    <div class="grid md:grid-cols-3 gap-3">
      <input id="botName" placeholder="Nome do bot" class="input">
      <input id="botToken" placeholder="Token do Telegram" class="input">
      <input id="botWebhook" placeholder="Webhook URL (opcional)" class="input">
    </div>
    <button class="btn mt-3" onclick="criarBot()">Criar</button>
  </div>

  <div class="panel overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="bg-neutral-800">
          <th class="p-3 text-left">Nome</th>
          <th class="p-3 text-left">Token</th>
          <th class="p-3 text-left">Webhook</th>
          <th class="p-3 text-left">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% (bots || []).forEach(b => { %>
        <tr class="odd:bg-neutral-900/40">
          <td class="p-3"><%= b.name %></td>
          <td class="p-3"><code class="text-xs"><%= (b.token||'').slice(0,15) %>…</code></td>
          <td class="p-3"><%= b.webhookUrl || '' %></td>
          <td class="p-3">
            <button class="btn" onclick="testar('<%= b._id %>')">Testar</button>
            <button class="btn" onclick="excluir('<%= b._id %>')">Excluir</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<script>
async function criarBot(){
  const payload = {
    name: document.getElementById('botName').value,
    token: document.getElementById('botToken').value,
    webhookUrl: document.getElementById('botWebhook').value,
  };
  const res = await fetch('/admin/bots',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  if(res.ok){ location.reload(); }
}
async function excluir(id){
  if(!confirm('Excluir este bot?')) return;
  const res = await fetch('/admin/bots/'+id,{method:'DELETE'});
  if(res.ok){ location.reload(); }
}
async function testar(id){
  await fetch('/admin/bots/test/'+id);
  alert('Teste disparado (ver logs).');
}
</script>
