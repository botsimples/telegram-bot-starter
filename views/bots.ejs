<div class="offers-central fade-in">
  <div class="animated-bg"></div>

  <div class="offers-header">
    <h1>⚡ Minhas Ofertas</h1>
    <p>Gerencie e crie automações inteligentes de forma prática e visual.</p>
  </div>

  <div class="action-grid">
    <div class="action-card" id="manage-offers">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <h3>Gerenciar Ofertas</h3>
      <p>Veja e edite todas as suas ofertas existentes no painel TigerFy.</p>
    </div>

    <div class="action-card" id="create-offer">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4" />
      </svg>
      <h3>Criar Nova Oferta</h3>
      <p>Configure um novo bot e escolha o tipo de traqueamento ideal.</p>
    </div>
  </div>
</div>

<!-- MODAL -->
<div id="create-offer-modal" class="modal">
  <div class="modal-inner">
    <h2>🚀 Criar Nova Oferta</h2>
    <p class="subtitle">
      Defina o nome e as opções iniciais do seu bot. <br />
      <span class="tip">Você poderá editar tudo isso depois.</span>
    </p>

    <form>
      <label>Nome da Oferta</label>
      <input type="text" placeholder="Ex: Acesso VIP, HotPrime..." required />

      <label>Tipo de Bot</label>
      <select>
        <option>Bot Padrão</option>
        <option>Fluxo Estilo ManyChat</option>
        <option disabled>Fluxo Bot (em breve)</option>
      </select>

      <label>Tipo de Traqueamento (opcional)</label>
      <select>
        <option>Usar seu Traqueamento Próprio</option>
        <option>Facebook Pixel Apenas</option>
        <option disabled>UTMify + Pixel Facebook (em breve)</option>
        <option disabled>UTMify + Pixel UTMIFY (em breve)</option>
      </select>

      <div class="modal-actions">
        <button type="button" class="btn-outline" id="tutorial-offer">📘 Ver Tutorial</button>
        <div class="btn-group">
          <button type="button" class="btn-outline" id="cancel-offer">Cancelar</button>
          <button type="submit" class="btn-gold">Criar</button>
        </div>
      </div>
    </form>
  </div>
</div>

<style>
  /* Fundo animado */
  .animated-bg {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at center, rgba(255, 204, 0, 0.08) 0%, transparent 80%);
    background-size: 200% 200%;
    animation: glowMove 8s infinite linear;
    z-index: -1;
  }

  @keyframes glowMove {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .offers-central {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: calc(100vh - 80px);
    text-align: center;
    gap: 60px;
  }

  .offers-header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: #ffcc00;
    margin-bottom: 8px;
  }

  .offers-header p {
    color: #b4b4b4;
    font-size: 1rem;
  }

  .action-grid {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .action-card {
    background: rgba(15, 15, 15, 0.85);
    border: 1px solid rgba(255, 204, 0, 0.08);
    border-radius: 16px;
    padding: 40px 50px;
    width: 280px;
    transition: all 0.3s ease;
    cursor: pointer;
    box-shadow: 0 0 0 1px rgba(255, 204, 0, 0.02);
  }

  .action-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 204, 0, 0.3);
    box-shadow: 0 0 20px rgba(255, 204, 0, 0.15);
  }

  .action-card svg {
    width: 40px;
    height: 40px;
    stroke: #ffcc00;
    margin-bottom: 15px;
  }

  .action-card h3 {
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .action-card p {
    color: #aaa;
    font-size: 0.9rem;
  }

  /* MODAL */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }

  .modal-inner {
    background: rgba(15, 15, 15, 0.95);
    border: 1px solid rgba(255, 204, 0, 0.1);
    border-radius: 14px;
    padding: 40px 45px;
    width: 430px;
    animation: popIn 0.35s ease;
  }

  .modal-inner h2 {
    color: #ffcc00;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .subtitle {
    color: #b4b4b4;
    margin-bottom: 25px;
    line-height: 1.4;
  }

  .tip {
    color: #ffcc00;
    font-size: 0.85rem;
  }

  label {
    display: block;
    color: #ffcc00;
    font-weight: 600;
    margin: 14px 0 6px;
    text-align: left;
  }

  input, select {
    width: 100%;
    background: rgba(20, 20, 20, 0.9);
    border: 1px solid rgba(255, 204, 0, 0.1);
    color: #fff;
    border-radius: 8px;
    padding: 10px 12px;
  }

  .modal-actions {
    margin-top: 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .btn-group {
    display: flex;
    gap: 10px;
  }

  .btn-gold {
    background: linear-gradient(90deg, #ffcc00, #d3a900);
    color: #000;
    border: none;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: 8px;
    cursor: pointer;
  }

  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255, 204, 0, 0.3);
    color: #ffcc00;
    padding: 10px 22px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-outline:hover {
    background: rgba(255, 204, 0, 0.1);
  }

  @keyframes popIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  const manageBtn = document.getElementById("manage-offers");
  const createBtn = document.getElementById("create-offer");
  const modal = document.getElementById("create-offer-modal");
  const cancelBtn = document.getElementById("cancel-offer");
  const tutorialBtn = document.getElementById("tutorial-offer");

  manageBtn.addEventListener("click", () => window.location.href = "/bots/manage");
  createBtn.addEventListener("click", () => modal.style.display = "flex");
  cancelBtn.addEventListener("click", () => modal.style.display = "none");
  tutorialBtn.addEventListener("click", () => window.open("https://t.me/tigerfy_tutorial", "_blank"));
  window.addEventListener("click", (e) => { if (e.target === modal) modal.style.display = "none"; });
</script>
