<%- include('partials/visual_hottrack') %>

<div class="tiger-offers">
  <!-- HEADER -->
  <div class="offers-header">
    <div>
      <h1>Minhas Ofertas</h1>
      <p>Gerencie, crie e otimize fluxos inteligentes dos seus bots no Telegram.</p>
    </div>
  </div>

  <!-- GRID DE OPÇÕES -->
  <div class="offers-grid">
    <div class="offer-card">
      <div class="icon">⚙️</div>
      <h3>Criar Oferta</h3>
      <p>Defina nome, valor e parâmetros de traqueamento para o seu bot Telegram.</p>
      <button class="btn-primary" onclick="window.location.href='/create-offer'">Criar</button>
    </div>

    <div class="offer-card">
      <div class="icon">📂</div>
      <h3>Gerenciar Ofertas</h3>
      <p>Edite, duplique e acompanhe o desempenho das ofertas criadas.</p>
      <button class="btn-primary">Acessar</button>
    </div>

    <div class="offer-card">
      <div class="icon">🧠</div>
      <h3>Criar Fluxo Visual</h3>
      <p>Monte visualmente o funil de mensagens e interações do seu bot.</p>
      <button class="btn-primary">Criar Funil</button>
    </div>

    <div class="offer-card">
      <div class="icon">🎓</div>
      <h3>Ver Tutoriais</h3>
      <p>Aprenda passo a passo como criar bots e automatizações de alto nível.</p>
      <button class="btn-primary">Assistir</button>
    </div>

    <div class="offer-card">
      <div class="icon">📈</div>
      <h3>Calcular ROI</h3>
      <p>Visualize o retorno das suas campanhas e calcule o ROI por oferta.</p>
      <button class="btn-primary">Calcular</button>
    </div>

    <div class="offer-card">
      <div class="icon">🤖</div>
      <h3>IA Ilimitada — Tiger IA</h3>
      <p>Crie mensagens, fluxos e automações com a inteligência exclusiva TigerFy.</p>
      <button class="btn-disabled">Em Breve</button>
    </div>
  </div>
</div>

<style>
  html,body{
    margin:0;padding:0;height:100%;width:100%;
    background:#0a0a0a;
    overflow-x:hidden;overflow-y:auto;
    -webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}
  ::-webkit-scrollbar{display:none!important;}

  .tiger-offers{
    position:relative;
    z-index:1;
    min-height:100vh;
    padding:60px 80px 80px 130px;
    display:flex;
    flex-direction:column;
    gap:40px;
    transform:scale(0.9) translateX(70px);
    transform-origin:top left;
  }

  .offers-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
  }

  .offers-header h1{
    color:#ffcc00;
    font-size:2rem;
    margin:0;
  }
  .offers-header p{
    color:#b4b4b4;
    margin-top:8px;
    font-size:.95rem;
  }

  .offers-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:30px;
    justify-content:center;
    margin-top:10px;
  }

  .offer-card{
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:16px;
    padding:30px 25px;
    text-align:center;
    transition:all .3s ease-out;
    position:relative;
    overflow:hidden;
  }

  .offer-card:hover{
    transform:translateY(-5px);
    background:rgba(255,204,0,0.05);
    box-shadow:0 0 25px rgba(255,204,0,0.25);
  }

  .offer-card .icon{
    font-size:2rem;
    margin-bottom:15px;
    filter:drop-shadow(0 0 8px rgba(255,204,0,0.3));
  }

  .offer-card h3{
    color:#fff;
    font-size:1.2rem;
    margin:0 0 8px;
  }

  .offer-card p{
    color:#b4b4b4;
    font-size:.9rem;
    margin:0 0 18px;
  }

  .btn-primary{
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    border:none;
    padding:10px 20px;
    border-radius:8px;
    color:#000;
    font-weight:700;
    cursor:pointer;
    transition:filter .25s;
    box-shadow:0 0 10px rgba(255,204,0,0.25);
  }
  .btn-primary:hover{filter:brightness(1.1);}

  .btn-disabled{
    background:rgba(255,255,255,0.05);
    border:none;
    padding:10px 20px;
    border-radius:8px;
    color:#777;
    font-weight:700;
    cursor:not-allowed;
  }
</style>
