<div class="offers-container fade-in">
  <header class="offers-header">
    <div class="text-center">
      <h1>⚡ Minhas Ofertas</h1>
      <p>Gerencie e crie novas automações diretamente pelo painel TigerFy.</p>
    </div>

    <div class="offers-actions">
      <button class="btn-gold-outline">Gerenciar Ofertas</button>
      <button id="btn-create-offer" class="btn-gold">Criar Nova Oferta</button>
      <button class="btn-dark">📘 Ver Tutorial</button>
    </div>
  </header>
</div>

<!-- MODAL DE CRIAÇÃO DE OFERTA -->
<div id="create-offer-modal" class="modal">
  <div class="modal-content compact">
    <h2>⚙️ Criar Nova Oferta</h2>
    <p class="modal-subtitle">Defina o nome da oferta e as configurações iniciais.</p>

    <form id="step1-form">
      <div class="form-group">
        <label for="offerName">Nome da Oferta</label>
        <input type="text" id="offerName" placeholder="Ex: Acesso VIP, HotPrime, Mundo Oculto..." required />
      </div>

      <!-- Tipo de Bot -->
      <h3 class="section-title"><svg class="icon" viewBox="0 0 24 24"><path fill="#ffcc00" d="M12 2a2 2 0 0 1 2 2v1h4a2 2 0 0 1 2 2v4h1a2 2 0 0 1 0 4h-1v4a2 2 0 0 1-2 2h-4v1a2 2 0 0 1-4 0v-1H6a2 2 0 0 1-2-2v-4H3a2 2 0 0 1 0-4h1V7a2 2 0 0 1 2-2h4V4a2 2 0 0 1 2-2Z"/></svg> Tipo de Bot</h3>

      <div class="option-grid compact">
        <div class="option-card selected" data-bot="default">
          <h4>Bot Padrão</h4>
          <p>Funil completo com upsell, downsell e remarketing automático.</p>
        </div>

        <div class="option-card" data-bot="manychat">
          <h4>Fluxo Estilo ManyChat</h4>
          <p>Fluxo interativo visual com automações personalizadas.</p>
        </div>

        <div class="option-card disabled" data-bot="flow">
          <h4>Fluxo Bot (em breve)</h4>
          <p>Fluxos inteligentes com lógica visual.</p>
        </div>
      </div>

      <!-- Tipo de Traqueamento -->
      <h3 class="section-title"><svg class="icon" viewBox="0 0 24 24"><path fill="#ffcc00" d="M12 2a10 10 0 1 1-7.07 2.93A10 10 0 0 1 12 2Zm0 18a8 8 0 1 0-5.66-2.34A8 8 0 0 0 12 20Zm-1-13h2v6h-2V7Zm0 8h2v2h-2v-2Z"/></svg> Tipo de Traqueamento <span class="optional-text">(opcional)</span></h3>

      <div class="option-grid compact">
        <div class="option-card selected" data-value="custom_tracking">
          <h4>Usar seu Traqueamento Próprio</h4>
          <p>Configure páginas de Presell e Obrigado com seu próprio pixel e UTMs.</p>
        </div>

        <div class="option-card disabled" data-value="utmify_pixel_utmify">
          <h4>UTMify + Pixel UTMIFY (em breve)</h4>
          <p>Integração automática com rastreamento completo.</p>
        </div>

        <div class="option-card disabled" data-value="utmify_pixel_fb">
          <h4>UTMify + Pixel Facebook (em breve)</h4>
          <p>Combinação de Meta Pixel e dados UTMify.</p>
        </div>

        <div class="option-card" data-value="pixel_fb_only">
          <h4>Facebook Pixel Apenas</h4>
          <p>Rastreamento nativo via pixel do Facebook.</p>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-gold-outline" id="cancel-offer">Cancelar</button>
        <button type="submit" class="btn-gold">Avançar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .offers-container { display:flex; flex-direction:column; align-items:center; gap:40px; padding:50px 0; }
  .offers-header h1 { font-size:2rem; font-weight:700; color:#ffcc00; }
  .offers-header p { color:#b4b4b4; }
  .offers-actions { display:flex; justify-content:center; gap:18px; margin-top:25px; }

  .btn-gold,.btn-gold-outline,.btn-dark {
    padding:12px 28px;border-radius:10px;font-weight:600;cursor:pointer;transition:all .25s ease;
  }
  .btn-gold {background:linear-gradient(90deg,#ffcc00,#d3a900);color:#000;border:none;}
  .btn-gold-outline {border:1px solid #ffcc00;background:transparent;color:#ffcc00;}
  .btn-dark {background:rgba(30,30,30,.8);border:1px solid rgba(255,204,0,.1);color:#ffcc00;}

  .modal {display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(6px);justify-content:center;align-items:center;z-index:9999;}
  .modal-content {background:rgba(15,15,15,.95);border:1px solid rgba(255,204,0,.1);border-radius:14px;width:540px;max-width:90%;padding:35px;animation:popIn .4s ease;}
  .compact {padding:30px;width:540px;}
  .modal-content h2 {color:#ffcc00;font-size:1.5rem;margin-bottom:8px;}
  .modal-subtitle {color:#b4b4b4;margin-bottom:25px;}

  .form-group {margin-bottom:25px;}
  label {color:#ffcc00;font-weight:600;}
  input[type="text"] {width:100%;background:rgba(20,20,20,.85);border:1px solid rgba(255,204,0,.1);border-radius:8px;padding:10px 12px;color:#fff;margin-top:6px;}

  .section-title {margin:25px 0 10px;color:#ffcc00;font-weight:700;font-size:1.05rem;display:flex;align-items:center;gap:8px;}
  .optional-text {color:#777;font-size:.85rem;font-weight:500;}
  .icon {width:20px;height:20px;}

  .option-grid.compact {display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .option-card {
    background:rgba(25,25,25,.85);
    border:1px solid rgba(255,204,0,.08);
    border-radius:10px;
    padding:14px 16px;
    cursor:pointer;
    transition:all .25s ease;
  }
  .option-card h4 {color:#ffcc00;font-weight:700;margin-bottom:4px;}
  .option-card p {color:#b4b4b4;font-size:.8rem;line-height:1.3;}
  .option-card:hover {border-color:rgba(255,204,0,.4);}
  .option-card.selected {border-color:#ffcc00;box-shadow:0 0 10px rgba(255,204,0,.25);}
  .option-card.disabled {opacity:.35;cursor:not-allowed;}

  .form-actions {display:flex;justify-content:flex-end;gap:10px;margin-top:25px;}

  @keyframes popIn {from{opacity:0;transform:scale(.95);}to{opacity:1;transform:scale(1);}}
</style>

<script>
  const modal = document.getElementById("create-offer-modal");
  const btnOpen = document.getElementById("btn-create-offer");
  const btnCancel = document.getElementById("cancel-offer");

  btnOpen.addEventListener("click", () => (modal.style.display = "flex"));
  btnCancel.addEventListener("click", () => (modal.style.display = "none"));
  window.addEventListener("click", (e) => { if (e.target === modal) modal.style.display = "none"; });

  document.querySelectorAll(".option-card").forEach((card) => {
    card.addEventListener("click", () => {
      if (card.classList.contains("disabled")) return;
      const group = card.dataset.bot ? "[data-bot]" : "[data-value]";
      document.querySelectorAll(group).forEach(c => c.classList.remove("selected"));
      card.classList.add("selected");
    });
  });
</script>
