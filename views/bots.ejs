  max-width: 420px;
  text-align: center;
  background: rgba(17,17,17,0.95);
  border: 1px solid rgba(255,204,0,0.3);
  box-shadow: 0 0 25px rgba(255,204,0,0.15);
  transition: all .3s ease;
}

#roiModal input {
  width: 100%;
  margin: 8px 0;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid rgba(255,204,0,0.3);
  background: rgba(255,255,255,0.05);
  color: #fff;
  font-size: .95rem;
  text-align: center;
}
#roiModal button {
  width: 100%;
  margin-top: 12px;
  background: linear-gradient(90deg,#ffcc00,#d4a100);
