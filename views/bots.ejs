<div class="offers-wrapper fade-in">
  <div class="offers-header">
    <h1>⚡ Minhas Ofertas</h1>
    <p>Gerencie e crie novas automações de forma rápida e elegante.</p>
  </div>

  <div class="offers-list">
    <div class="offer-card">
      <h3>Acesso VIP 🔥</h3>
      <span class="tag">Bot Padrão</span>
      <p>Criada em 10/11/2025</p>
    </div>

    <div class="offer-card empty">
      <p>Nenhuma oferta criada ainda</p>
    </div>
  </div>

  <button id="new-offer-btn" class="floating-btn">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
    </svg>
    Nova Oferta
  </button>
</div>

<!-- MODAL -->
<div id="create-offer-modal" class="modal">
  <div class="modal-inner">
    <h2>Criar Nova Oferta</h2>
    <p class="subtitle">Escolha as opções iniciais do seu bot.</p>

    <form>
      <label>Nome da Oferta</label>
      <input type="text" placeholder="Ex: Acesso VIP, HotPrime..." required />

      <label>Tipo de Bot</label>
      <select>
        <option>Bot Padrão</option>
        <option>Fluxo Estilo ManyChat</option>
        <option disabled>Fluxo Bot (em breve)</option>
      </select>

      <label>Tipo de Traqueamento (opcional)</label>
      <select>
        <option>Usar seu Traqueamento Próprio</option>
        <option>Facebook Pixel Apenas</option>
        <option disabled>UTMify + Pixel Facebook (em breve)</option>
        <option disabled>UTMify + Pixel UTMIFY (em breve)</option>
      </select>

      <div class="modal-actions">
        <button type="button" class="btn-outline" id="cancel-offer">Cancelar</button>
        <button type="submit" class="btn-gold">Criar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .offers-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 70px 20px;
    gap: 40px;
  }

  .offers-header h1 {
    font-size: 2.1rem;
    font-weight: 800;
    color: #ffcc00;
    margin-bottom: 5px;
  }

  .offers-header p {
    color: #b4b4b4;
    font-size: 0.95rem;
  }

  .offers-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    width: 100%;
    max-width: 850px;
  }

  .offer-card {
    background: rgba(15, 15, 15, 0.85);
    border: 1px solid rgba(255, 204, 0, 0.08);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.3s ease;
    box-shadow: inset 0 0 0 1px rgba(255, 204, 0, 0.03);
  }

  .offer-card:hover {
    border-color: rgba(255, 204, 0, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 0 15px rgba(255, 204, 0, 0.08);
  }

  .offer-card h3 {
    color: #fff;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .offer-card p {
    color: #aaa;
    font-size: 0.85rem;
  }

  .tag {
    display: inline-block;
    background: rgba(255, 204, 0, 0.1);
    color: #ffcc00;
    font-size: 0.75rem;
    border-radius: 6px;
    padding: 3px 8px;
    margin-bottom: 10px;
  }

  .empty {
    opacity: 0.4;
  }

  /* FLOATING BUTTON */
  .floating-btn {
    position: fixed;
    bottom: 50px;
    right: 50%;
    transform: translateX(50%);
    background: linear-gradient(90deg, #ffcc00, #d3a900);
    color: #000;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(255, 204, 0, 0.4);
    transition: all 0.25s ease;
  }

  .floating-btn:hover {
    transform: translateX(50%) scale(1.05);
    box-shadow: 0 0 20px rgba(255, 204, 0, 0.6);
  }

  .floating-btn svg {
    width: 20px;
    height: 20px;
    stroke: #000;
  }

  /* MODAL */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }

  .modal-inner {
    background: rgba(15, 15, 15, 0.95);
    border: 1px solid rgba(255, 204, 0, 0.1);
    border-radius: 14px;
    padding: 35px 45px;
    width: 420px;
    animation: popIn 0.35s ease;
  }

  .modal-inner h2 {
    color: #ffcc00;
    margin-bottom: 6px;
    font-size: 1.5rem;
  }

  .modal-inner .subtitle {
    color: #b4b4b4;
    margin-bottom: 25px;
  }

  label {
    display: block;
    color: #ffcc00;
    font-weight: 600;
    margin: 14px 0 6px;
    text-align: left;
  }

  input,
  select {
    width: 100%;
    background: rgba(20, 20, 20, 0.9);
    border: 1px solid rgba(255, 204, 0, 0.1);
    color: #fff;
    border-radius: 8px;
    padding: 10px 12px;
  }

  .modal-actions {
    margin-top: 25px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .btn-gold {
    background: linear-gradient(90deg, #ffcc00, #d3a900);
    color: #000;
    border: none;
    font-weight: 700;
    padding: 10px 22px;
    border-radius: 8px;
    cursor: pointer;
  }

  .btn-outline {
    background: transparent;
    border: 1px solid rgba(255, 204, 0, 0.3);
    color: #ffcc00;
    padding: 10px 22px;
    border-radius: 8px;
    cursor: pointer;
  }

  @keyframes popIn {
    from {
      transform: scale(0.95);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  const newOfferBtn = document.getElementById("new-offer-btn");
  const modal = document.getElementById("create-offer-modal");
  const cancelBtn = document.getElementById("cancel-offer");

  newOfferBtn.addEventListener("click", () => (modal.style.display = "flex"));
  cancelBtn.addEventListener("click", () => (modal.style.display = "none"));
  window.addEventListener("click", (e) => {
    if (e.target === modal) modal.style.display = "none";
  });
</script>
