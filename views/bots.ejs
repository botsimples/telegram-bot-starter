<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <title>Bots Conectados</title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="bg-hot-bg text-slate-100 min-h-screen">
  <div class="max-w-6xl mx-auto py-10 px-4">
    <h1 class="text-2xl font-semibold mb-6">🤖 Bots Conectados</h1>

    <!-- Add Bot -->
    <div class="panel p-5 mb-8">
      <h2 class="text-lg font-medium mb-4">Adicionar Novo Bot</h2>
      <div class="grid gap-3 md:grid-cols-3">
        <input id="in_user" class="input" placeholder="Username (sem @)" />
        <input id="in_token" class="input" placeholder="Token do Bot" />
        <input id="in_note" class="input" placeholder="Observação (opcional)" />
      </div>
      <button class="btn mt-4" onclick="addBot()">Adicionar Bot</button>
    </div>

    <!-- List -->
    <div class="panel p-5">
      <h2 class="text-lg font-medium mb-4">Bots Salvos</h2>
      <div id="list" class="space-y-3">
        <% bots.forEach(b => { %>
          <div class="flex flex-col md:flex-row md:items-center justify-between border border-white/10 rounded-lg p-3">
            <div>
              <div class="font-semibold">@<%= b.username %></div>
              <div class="text-xs text-white/60 break-all">Token: <%= b.token %></div>
              <% if (b.note) { %><div class="text-xs text-white/70 mt-1"><%= b.note %></div><% } %>
            </div>
            <div class="mt-3 md:mt-0 flex gap-2">
              <button class="btn" onclick="toggleActive('<%= b._id %>', <%= !b.isActive %>)">
                <%= b.isActive ? 'Desativar' : 'Ativar' %>
              </button>
              <button class="btn bg-red-500 hover:bg-red-400" onclick="delBot('<%= b._id %>')">Excluir</button>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <script>
    async function addBot() {
      const username = document.getElementById('in_user').value.trim();
      const token = document.getElementById('in_token').value.trim();
      const note = document.getElementById('in_note').value.trim();
      if (!username || !token) return alert('Informe username e token.');
      const r = await fetch('/bots', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ username, token, note }) });
      if (r.ok) location.reload(); else alert('Erro ao criar bot');
    }
    async function delBot(id) {
      if (!confirm('Excluir este bot?')) return;
      const r = await fetch('/bots/' + id, { method:'DELETE' });
      if (r.ok) location.reload();
    }
    async function toggleActive(id, val) {
      const r = await fetch('/bots/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ isActive: val }) });
      if (r.ok) location.reload();
    }
  </script>
</body>
</html>
