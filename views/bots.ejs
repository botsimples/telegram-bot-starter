<%- include('partials/visual_hottrack') %>

<div class="tiger-offers">
  <!-- HEADER -->
  <div class="offers-header">
    <h1>Minhas Ofertas</h1>
    <p>Gerencie, crie e visualize fluxos, métricas e automações inteligentes dos seus bots Telegram.</p>
  </div>

  <!-- GRID DE OPÇÕES -->
  <div class="offers-grid">
    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v4M4.22 4.22l2.83 2.83M1 12h4M4.22 19.78l2.83-2.83M12 23v-4M19.78 19.78l-2.83-2.83M23 12h-4M19.78 4.22l-2.83 2.83M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
      </div>
      <h3>Criar Oferta</h3>
      <p>Defina nome, valor e parâmetros de traqueamento para seu bot Telegram.</p>
      <button class="btn-primary">Criar</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h18v16H3z"/><path d="M3 8h18M7 4v16"/></svg>
      </div>
      <h3>Gerenciar Ofertas</h3>
      <p>Edite, duplique e acompanhe o desempenho das suas campanhas.</p>
      <button class="btn-primary">Acessar</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l9 6 9-6-9-6-9 6z"/><path d="M3 6v12l9 6 9-6V6"/></svg>
      </div>
      <h3>Criar Fluxo Visual</h3>
      <p>Monte visualmente o funil de mensagens e interações do seu bot.</p>
      <button class="btn-primary">Criar Funil</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M12 4h9"/><path d="M12 12h9"/><path d="M3 6h.01M3 18h.01M3 12h.01"/></svg>
      </div>
      <h3>Ver Tutoriais</h3>
      <p>Aprenda passo a passo como dominar automações e bots TigerFy.</p>
      <button class="btn-primary">Assistir</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M21 10V3h-7"/></svg>
      </div>
      <h3>Calcular ROI</h3>
      <p>Visualize retorno das campanhas e calcule ROI por oferta.</p>
      <button class="btn-primary">Calcular</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8 2 5 5 5 9c0 3.54 3.64 7.36 6.35 10.1a1 1 0 001.3 0C15.36 16.36 19 12.54 19 9c0-4-3-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
      </div>
      <h3>IA Ilimitada — Tiger IA</h3>
      <p>Crie mensagens e fluxos com inteligência automatizada exclusiva.</p>
      <button class="btn-disabled">Em Breve</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v4H3zM3 9h18v12H3z"/><path d="M7 13h4v4H7zM15 13h4v4h-4z"/></svg>
      </div>
      <h3>Histórico de Vendas</h3>
      <p>Veja todas as vendas e performance detalhada das suas ofertas.</p>
      <button class="btn-primary">Ver Histórico</button>
    </div>

    <div class="offer-card">
      <div class="icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="#ffcc00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15A7 7 0 0012 5a7 7 0 00-7.4 10M12 19v4"/></svg>
      </div>
      <h3>Integrações</h3>
      <p>Conecte gateways, APIs e webhooks externos ao TigerFy.</p>
      <button class="btn-primary">Gerenciar</button>
    </div>
  </div>
</div>

<style>
  html,body{
    margin:0;padding:0;height:100%;width:100%;
    background:#0a0a0a;
    overflow-x:hidden;overflow-y:auto;
    -webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}
  ::-webkit-scrollbar{display:none!important;}

  .tiger-offers{
    position:relative;
    z-index:1;
    min-height:100vh;
    padding:60px 80px 100px 130px;
    display:flex;
    flex-direction:column;
    gap:30px;
    transform:scale(0.9) translateX(70px);
    transform-origin:top left;
  }

  .offers-header{
    text-align:center;
    margin-bottom:10px;
  }
  .offers-header h1{
    color:#ffcc00;
    font-size:2rem;
    margin:0;
  }
  .offers-header p{
    color:#b4b4b4;
    margin-top:8px;
    font-size:.95rem;
  }

  .offers-grid{
    display:grid;
    grid-template-columns:repeat(4, minmax(260px,1fr));
    gap:28px;
    justify-content:center;
  }

  .offer-card{
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:16px;
    padding:28px 22px;
    text-align:center;
    transition:all .3s ease-out;
    position:relative;
    overflow:hidden;
  }

  .offer-card:hover{
    transform:translateY(-6px);
    background:rgba(255,204,0,0.05);
    box-shadow:0 0 25px rgba(255,204,0,0.25);
  }

  .icon{
    display:flex;
    justify-content:center;
    align-items:center;
    margin-bottom:15px;
    transition:transform .3s ease, filter .3s ease;
  }
  .offer-card:hover .icon{
    transform:scale(1.1);
    filter:drop-shadow(0 0 12px rgba(255,204,0,0.6));
  }

  .offer-card h3{
    color:#fff;
    font-size:1.1rem;
    margin:0 0 8px;
  }

  .offer-card p{
    color:#b4b4b4;
    font-size:.9rem;
    margin:0 0 18px;
  }

  .btn-primary{
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    border:none;
    padding:10px 20px;
    border-radius:8px;
    color:#000;
    font-weight:700;
    cursor:pointer;
    transition:filter .25s;
    box-shadow:0 0 10px rgba(255,204,0,0.25);
  }
  .btn-primary:hover{filter:brightness(1.1);}
  .btn-disabled{
    background:rgba(255,255,255,0.05);
    border:none;
    padding:10px 20px;
    border-radius:8px;
    color:#777;
    font-weight:700;
    cursor:not-allowed;
  }
</style>
