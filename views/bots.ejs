<div class="offers-container fade-in">
  <header class="offers-header">
    <div class="text-center">
      <h1>⚡ Minhas Ofertas</h1>
      <p>Gerencie e crie novas automações diretamente pelo painel TigerFy.</p>
    </div>

    <div class="offers-actions">
      <button class="btn-gold-outline">Gerenciar Ofertas</button>
      <button id="btn-create-offer" class="btn-gold">Criar Nova Oferta</button>
    </div>
  </header>
</div>

<!-- FUTURO MODAL DE CRIAÇÃO DE OFERTA -->
<div id="create-offer-modal" class="modal">
  <div class="modal-content">
    <h2>🧩 Criar Nova Oferta</h2>
    <p class="modal-subtitle">Configure o bot e as opções de rastreamento.</p>

    <form>
      <div class="form-group">
        <label for="telegramToken">Token do Bot do Telegram (BotFather)</label>
        <input type="text" id="telegramToken" placeholder="Insira o token gerado pelo BotFather" />
      </div>

      <div class="form-group">
        <label for="botName">Nome do Bot (opcional)</label>
        <input type="text" id="botName" placeholder="Ex: caronavip_bot" />
      </div>

      <div class="form-group">
        <label>Integrações de Rastreamento</label>
        <div class="radio-options">
          <label><input type="radio" name="tracking" value="utmify_pixel" checked /> Usar UTMify + Pixel do Facebook</label>
          <label><input type="radio" name="tracking" value="utmify_only" /> Utilizar apenas UTMify</label>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-gold-outline" id="cancel-offer">Cancelar</button>
        <button type="submit" class="btn-gold">Salvar Oferta</button>
      </div>
    </form>
  </div>
</div>

<style>
  .offers-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 40px 0;
    animation: fadeIn 0.6s ease forwards;
  }

  .offers-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #ffcc00;
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .offers-header p {
    color: #b4b4b4;
    font-size: 0.95rem;
  }

  .offers-actions {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-top: 25px;
  }

  .btn-gold,
  .btn-gold-outline {
    padding: 12px 28px;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    transition: all 0.25s ease;
  }

  .btn-gold {
    background: linear-gradient(90deg, #ffcc00, #d3a900);
    border: none;
    color: #000;
    box-shadow: 0 0 10px rgba(255, 204, 0, 0.3);
  }
  .btn-gold:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 18px rgba(255, 204, 0, 0.45);
  }

  .btn-gold-outline {
    border: 1px solid #ffcc00;
    background: transparent;
    color: #ffcc00;
  }
  .btn-gold-outline:hover {
    background: rgba(255, 204, 0, 0.1);
  }

  /* === MODAL === */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }

  .modal-content {
    background: rgba(20, 20, 20, 0.95);
    border: 1px solid rgba(255, 204, 0, 0.15);
    border-radius: 14px;
    width: 480px;
    max-width: 90%;
    padding: 35px;
    text-align: left;
    animation: popIn 0.4s ease;
  }

  .modal-content h2 {
    color: #ffcc00;
    font-size: 1.6rem;
    margin-bottom: 8px;
  }

  .modal-subtitle {
    color: #b4b4b4;
    font-size: 0.9rem;
    margin-bottom: 20px;
  }

  .form-group {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
  }

  label {
    color: #ffcc00;
    font-weight: 600;
    margin-bottom: 6px;
  }

  input[type="text"] {
    background: rgba(15, 15, 15, 0.85);
    border: 1px solid rgba(255, 204, 0, 0.1);
    border-radius: 8px;
    padding: 10px 12px;
    color: #fff;
    font-size: 0.9rem;
    outline: none;
    transition: 0.2s;
  }

  input[type="text"]:focus {
    border-color: rgba(255, 204, 0, 0.4);
    box-shadow: 0 0 6px rgba(255, 204, 0, 0.25);
  }

  .radio-options label {
    display: block;
    color: #d1d1d1;
    font-size: 0.9rem;
    margin-bottom: 6px;
    cursor: pointer;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 25px;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  // MODAL
  const modal = document.getElementById("create-offer-modal");
  const btnOpen = document.getElementById("btn-create-offer");
  const btnCancel = document.getElementById("cancel-offer");

  btnOpen.addEventListener("click", () => (modal.style.display = "flex"));
  btnCancel.addEventListener("click", () => (modal.style.display = "none"));
  window.addEventListener("click", e => {
    if (e.target === modal) modal.style.display = "none";
  });
</script>
