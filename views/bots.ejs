<div class="offers-container fade-in">
  <header class="offers-header">
    <div class="text-center">
      <h1>⚡ Minhas Ofertas</h1>
      <p>Gerencie e crie novas automações diretamente pelo painel TigerFy.</p>
    </div>

    <div class="offers-actions">
      <button class="btn-gold-outline">Gerenciar Ofertas</button>
      <button id="btn-create-offer" class="btn-gold">Criar Nova Oferta</button>
      <button class="btn-dark">📘 Ver Tutorial</button>
    </div>
  </header>
</div>

<!-- NOVO MODAL DE CRIAÇÃO -->
<div id="create-offer-modal" class="modal">
  <div class="modal-content modal-step1">
    <h2>🧠 Criar Nova Oferta</h2>
    <p class="modal-subtitle">Defina o nome da oferta e selecione o tipo de operação.</p>

    <form id="step1-form">
      <div class="form-group">
        <label for="offerName">Nome da Oferta</label>
        <input type="text" id="offerName" placeholder="Ex: Acesso VIP, HotPrime, Mundo Oculto..." required />
      </div>

      <h3 class="section-title">🎯 Tipo de Traqueamento</h3>
      <div class="option-grid">
        <div class="option-card selected" data-value="utmify_pixel_utmify">
          <h4>UTMify + Pixel UTMIFY</h4>
          <p>Integração nativa com o painel UTMify para marcação automática de leads e vendas.</p>
        </div>

        <div class="option-card" data-value="utmify_pixel_fb">
          <h4>UTMify + Pixel Facebook</h4>
          <p>Combine o poder do UTMify com o rastreamento avançado do Meta Pixel.</p>
        </div>

        <div class="option-card" data-value="pixel_fb_only">
          <h4>Facebook Pixel Apenas</h4>
          <p>Rastreamento direto via Meta Pixel, sem dependência de UTMify.</p>
        </div>
      </div>

      <h3 class="section-title">🤖 Tipo de Bot</h3>
      <div class="option-grid">
        <div class="option-card selected" data-bot="default">
          <h4>Bot Padrão</h4>
          <p>Funil completo com upsell, downsell, orderbump e remarketing automático.</p>
        </div>

        <div class="option-card disabled" data-bot="flow">
          <h4>Fluxo Bot (em breve)</h4>
          <p>Integração visual para fluxos customizados com lógica e automações inteligentes.</p>
        </div>
      </div>

      <div class="form-actions">
        <button type="button" class="btn-gold-outline" id="cancel-offer">Cancelar</button>
        <button type="submit" class="btn-gold">Avançar</button>
      </div>
    </form>
  </div>
</div>

<style>
  .offers-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 50px 0;
  }

  .offers-header h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #ffcc00;
  }

  .offers-header p {
    color: #b4b4b4;
  }

  .offers-actions {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-top: 25px;
  }

  .btn-gold, .btn-gold-outline, .btn-dark {
    padding: 12px 28px;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-gold {
    background: linear-gradient(90deg, #ffcc00, #d3a900);
    border: none;
    color: #000;
  }

  .btn-gold-outline {
    border: 1px solid #ffcc00;
    background: transparent;
    color: #ffcc00;
  }

  .btn-dark {
    background: rgba(30,30,30,0.8);
    border: 1px solid rgba(255,204,0,0.1);
    color: #ffcc00;
  }

  /* ===== MODAL ===== */
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(6px);
    justify-content: center;
    align-items: center;
    z-index: 9999;
  }

  .modal-content {
    background: rgba(15,15,15,0.95);
    border: 1px solid rgba(255,204,0,0.1);
    border-radius: 16px;
    width: 650px;
    max-width: 90%;
    padding: 35px;
    animation: popIn 0.4s ease;
  }

  .modal-content h2 {
    color: #ffcc00;
    font-size: 1.7rem;
    margin-bottom: 8px;
  }

  .modal-subtitle {
    color: #b4b4b4;
    margin-bottom: 25px;
  }

  .form-group {
    margin-bottom: 30px;
  }

  label {
    color: #ffcc00;
    font-weight: 600;
  }

  input[type="text"] {
    width: 100%;
    background: rgba(20,20,20,0.85);
    border: 1px solid rgba(255,204,0,0.1);
    border-radius: 8px;
    padding: 10px 12px;
    color: #fff;
    margin-top: 6px;
  }

  .section-title {
    margin: 20px 0 10px;
    color: #ffcc00;
    font-weight: 700;
    font-size: 1.05rem;
  }

  /* ===== CARDS ===== */
  .option-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .option-card {
    background: rgba(25,25,25,0.85);
    border: 1px solid rgba(255,204,0,0.08);
    border-radius: 10px;
    padding: 16px 20px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .option-card h4 {
    color: #ffcc00;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .option-card p {
    color: #b4b4b4;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .option-card:hover {
    border-color: rgba(255,204,0,0.4);
    transform: translateY(-2px);
  }

  .option-card.selected {
    border-color: #ffcc00;
    box-shadow: 0 0 12px rgba(255,204,0,0.25);
  }

  .option-card.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 25px;
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<script>
  const modal = document.getElementById("create-offer-modal");
  const btnOpen = document.getElementById("btn-create-offer");
  const btnCancel = document.getElementById("cancel-offer");

  btnOpen.addEventListener("click", () => modal.style.display = "flex");
  window.addEventListener("click", e => { if (e.target === modal) modal.style.display = "none"; });

  // Seleção de cards
  document.querySelectorAll(".option-card").forEach(card => {
    card.addEventListener("click", () => {
      if (card.classList.contains("disabled")) return;
      const group = card.dataset.value ? "[data-value]" : "[data-bot]";
      document.querySelectorAll(group).forEach(c => c.classList.remove("selected"));
      card.classList.add("selected");
    });
  });
</script>
