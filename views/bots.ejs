<% title = "Ofertas - TigerFy"; %>

<div class="panel fade-in center">
  <h1 class="title"><i class="fa-solid fa-layer-group"></i> Ofertas</h1>
  <p class="subtitle">Crie e gerencie suas ofertas e bots integrados.</p>

  <div class="form-area">
    <input placeholder="Nome da oferta" class="input" />
    <input placeholder="Token do bot" class="input" />
    <input placeholder="Webhook (opcional)" class="input" />
    <button class="btn">Criar Oferta</button>
  </div>

  <table class="tabela">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Token</th>
        <th>Webhook</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <tr><td colspan="4">Nenhuma oferta cadastrada</td></tr>
    </tbody>
  </table>
</div>
