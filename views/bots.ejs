<% layout('layout') %>

<div class="page-container">
  <div class="page-header">
    <h1>Ofertas</h1>
    <p>Gerencie seus bots e fluxos conectados ao sistema TigerFy.</p>
  </div>

  <div class="actions">
    <button onclick="openModal('modalOferta')" class="btn-primary">+ Nova Oferta</button>
  </div>

  <div class="cards-grid">
    <% if (bots && bots.length > 0) { %>
      <% bots.forEach(bot => { %>
        <div class="dash-card wide">
          <div class="card-header">
            <h2><%= bot.username %></h2>
            <span class="tag">Ativo</span>
          </div>
          <p><%= bot.note || 'Nenhuma observação adicionada.' %></p>
          <div class="card-footer">
            <button class="btn-secondary">Editar</button>
            <button class="btn-danger">Excluir</button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="empty-text">Nenhuma oferta cadastrada.</p>
    <% } %>
  </div>
</div>

<!-- MODAL NOVA OFERTA -->
<div id="modalOferta" class="modal-bg">
  <div class="modal-box">
    <h2>Nova Oferta</h2>
    <form action="/bots/add" method="POST">
      <input type="text" name="username" placeholder="Nome do bot" required />
      <input type="text" name="token" placeholder="Token de acesso" required />
      <textarea name="note" placeholder="Descrição / Observação"></textarea>
      <div class="modal-actions">
        <button type="submit" class="btn-primary">Salvar</button>
        <button type="button" class="btn-cancel" onclick="closeModal('modalOferta')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
