<%- include('layout',{title:'Ofertas',active:'bots',body:`
<canvas id="bgParticles"></canvas>

<div class="offers-page">
  <div class="offers-container">
    <div class="offers-header">
      <h1>⚡ Minhas Ofertas</h1>
      <p>Gerencie, crie e visualize fluxos e métricas de suas ofertas de forma prática e visual.</p>
    </div>

    <div class="offers-grid">
      <!-- cards -->
      <div class="offer-card"><h3>Gerenciar Ofertas</h3><p>Veja e edite todas as ofertas criadas no painel TigerFy.</p><button class="offer-btn">Acessar</button></div>
      <div class="offer-card"><h3>Criar Nova Oferta</h3><p>Defina o nome, tipo e traqueamento da sua nova oferta.</p><button class="offer-btn">Criar</button></div>
      <div class="offer-card"><h3>Criar Funil Visual</h3><p>Monte visualmente o fluxo de cada etapa da oferta.</p><button class="offer-btn">Criar Funil</button></div>
      <div class="offer-card" onclick="openTutorial()"><h3>Ver Tutorial</h3><p>Aprenda passo a passo a dominar o painel TigerFy.</p><button class="offer-btn">Assistir</button></div>
      <div class="offer-card"><h3>Calcular ROI</h3><p>Veja o ROI diário, mensal ou anual das suas ofertas.</p><button class="offer-btn">Calcular</button></div>
      <div class="offer-card disabled"><h3>IA Ilimitada ⚡</h3><p>Automatize análises e decisões com IA avançada. <b>Em breve.</b></p><button class="offer-btn disabled-btn">Em Breve</button></div>
    </div>
  </div>
</div>

<script>
const c=document.getElementById('bgParticles'),ctx=c.getContext('2d');
function resize(){c.width=innerWidth;c.height=innerHeight}
addEventListener('resize',resize);resize();
const p=[];for(let i=0;i<70;i++)p.push({x:Math.random()*c.width,y:Math.random()*c.height,r:Math.random()*1.2+0.3,dx:(Math.random()-.5)*.25,dy:(Math.random()-.5)*.25});
function draw(){
  ctx.clearRect(0,0,c.width,c.height);
  ctx.fillStyle='rgba(255,204,0,0.25)';
  for(const o of p){ctx.beginPath();ctx.arc(o.x,o.y,o.r,0,Math.PI*2);ctx.fill();
    o.x+=o.dx;o.y+=o.dy;
    if(o.x<0||o.x>c.width)o.dx*=-1;
    if(o.y<0||o.y>c.height)o.dy*=-1;}
  requestAnimationFrame(draw);
}
draw();
</script>

<style>
html,body{margin:0;height:100%;overflow:hidden;background:#0a0a0a;}
#bgParticles{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-2;mix-blend-mode:screen;pointer-events:none;}

.offers-page{
  height:100vh;display:flex;justify-content:center;align-items:center;
  transform:translateX(-80px); /* compensa sidebar */
}
.offers-container{text-align:center;width:90%;max-width:1100px;}
.offers-header h1{color:#ffcc00;margin:0 0 10px;}
.offers-header p{color:#b4b4b4;margin:0 0 40px;}
.offers-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:25px;justify-items:center;}
.offer-card{width:260px;height:260px;background:rgba(255,255,255,.03);border:1px solid rgba(255,204,0,.12);border-radius:14px;padding:25px;display:flex;flex-direction:column;justify-content:space-between;align-items:center;transition:.3s;}
.offer-card:hover:not(.disabled){background:rgba(255,204,0,.07);box-shadow:0 0 12px rgba(255,204,0,.25);}
.offer-btn{background:linear-gradient(90deg,#ffcc00,#d4a100);border:none;border-radius:8px;padding:8px 16px;font-weight:600;cursor:pointer;}
.disabled{opacity:.4;pointer-events:none;}
.disabled-btn{background:#333;color:#aaa;}
</style>
`})%>
