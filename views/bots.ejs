<%- include('layout', { title: 'Ofertas', active: 'bots', body: `
  <!-- ===============================
       ⚡ MINHAS OFERTAS - TIGERFY
       Painel elegante com opções centrais
  =============================== -->

  <div class="offers-wrapper fade-in">
    <div class="offers-header">
      <h1>⚡ Minhas Ofertas</h1>
      <p>Gerencie e crie automações inteligentes de forma prática e visual.</p>
    </div>

    <div class="offers-grid">
      <div class="offer-card">
        <div class="offer-icon">📋</div>
        <h3>Gerenciar Ofertas</h3>
        <p>Veja e edite todas as suas ofertas existentes no painel TigerFy.</p>
        <button class="offer-btn" onclick="window.location.href='/bots/manage'">Acessar</button>
      </div>

      <div class="offer-card">
        <div class="offer-icon">➕</div>
        <h3>Criar Nova Oferta</h3>
        <p>Configure uma nova oferta e escolha o tipo de traqueamento ideal.</p>
        <div class="offer-actions">
          <button class="offer-btn" onclick="window.location.href='/bots/create'">Criar</button>
          <button class="offer-btn-secondary" onclick="openTutorial()">Ver Tutorial</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ===============================
       🎥 MODAL DE TUTORIAL
  =============================== -->
  <div class="tutorial-modal" id="tutorialModal">
    <div class="tutorial-content">
      <h2>🎬 Tutorial de Criação</h2>
      <p>Aprenda a criar suas ofertas com rastreamento e integrações em menos de 2 minutos.</p>
      <iframe 
        src="https://www.youtube.com/embed/dQw4w9WgXcQ" 
        title="Tutorial TigerFy" 
        frameborder="0" 
        allowfullscreen>
      </iframe>
      <button class="close-btn" onclick="closeTutorial()">Fechar</button>
    </div>
  </div>

  <script>
    function openTutorial() {
      document.getElementById('tutorialModal').classList.add('show');
    }
    function closeTutorial() {
      document.getElementById('tutorialModal').classList.remove('show');
    }
  </script>

  <style>
    /* ===============================
       🌌 ESTILO GERAL CENTRALIZADO
    =============================== */
    .offers-wrapper {
      text-align: center;
      padding-top: 60px;
      position: relative;
      animation: fadeIn 0.8s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .offers-header h1 {
      font-size: 2rem;
      color: #ffcc00;
      margin-bottom: 10px;
      text-shadow: 0 0 8px rgba(255, 204, 0, 0.4);
    }

    .offers-header p {
      color: #b4b4b4;
      font-size: 0.95rem;
    }

    .offers-grid {
      display: flex;
      justify-content: center;
      gap: 35px;
      margin-top: 60px;
      flex-wrap: wrap;
    }

    .offer-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 204, 0, 0.15);
      border-radius: 14px;
      padding: 30px 28px;
      width: 320px;
      text-align: center;
      transition: 0.3s ease;
      box-shadow: inset 0 0 10px rgba(255, 204, 0, 0.04);
    }

    .offer-card:hover {
      background: rgba(255, 204, 0, 0.06);
      transform: translateY(-3px);
      box-shadow: 0 0 12px rgba(255, 204, 0, 0.15);
    }

    .offer-icon {
      font-size: 38px;
      margin-bottom: 12px;
      filter: drop-shadow(0 0 5px rgba(255, 204, 0, 0.6));
    }

    .offer-card h3 {
      font-size: 1.1rem;
      color: #fff;
      margin-bottom: 6px;
    }

    .offer-card p {
      font-size: 0.9rem;
      color: #b4b4b4;
      margin-bottom: 16px;
    }

    .offer-btn {
      background: linear-gradient(90deg, #ffcc00, #d4a100);
      border: none;
      border-radius: 8px;
      color: #000;
      font-weight: 600;
      padding: 10px 18px;
      cursor: pointer;
      transition: 0.25s;
    }

    .offer-btn:hover {
      filter: brightness(1.15);
    }

    .offer-btn-secondary {
      background: transparent;
      border: 1px solid #ffcc00;
      border-radius: 8px;
      color: #ffcc00;
      font-weight: 500;
      padding: 9px 16px;
      margin-left: 8px;
      cursor: pointer;
      transition: 0.3s;
    }

    .offer-btn-secondary:hover {
      background: rgba(255, 204, 0, 0.1);
    }

    /* ===============================
       🎥 MODAL DE TUTORIAL
    =============================== */
    .tutorial-modal {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 999;
    }

    .tutorial-modal.show {
      display: flex;
    }

    .tutorial-content {
      background: rgba(15, 15, 15, 0.95);
      border: 1px solid rgba(255, 204, 0, 0.2);
      border-radius: 14px;
      padding: 25px 30px;
      width: 600px;
      text-align: center;
      animation: slideUp 0.5s ease;
      box-shadow: 0 0 25px rgba(255, 204, 0, 0.1);
    }

    @keyframes slideUp {
      from { transform: translateY(30px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .tutorial-content h2 {
      color: #ffcc00;
      margin-bottom: 10px;
    }

    .tutorial-content p {
      color: #ccc;
      margin-bottom: 20px;
      font-size: 0.95rem;
    }

    .tutorial-content iframe {
      width: 100%;
      height: 315px;
      border-radius: 10px;
      margin-bottom: 20px;
    }

    .close-btn {
      background: #ffcc00;
      color: #000;
      border: none;
      border-radius: 8px;
      padding: 10px 18px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.3s;
    }

    .close-btn:hover {
      filter: brightness(1.15);
    }
  </style>
` }) %>
