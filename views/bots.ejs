<%- include('partials/visual_hottrack') %>

<div class="tiger-create">
  <!-- HEADER -->
  <div class="create-header">
    <div>
      <h1>Criar Nova Oferta</h1>
      <p>Defina nome, tipo e parâmetros de rastreamento da sua oferta.</p>
    </div>
    <button class="return-btn" onclick="window.location.href='/bots'">Voltar</button>
  </div>

  <!-- CONTAINER CENTRAL -->
  <div class="create-container">
    <form id="create-offer-form">
      <div class="input-group">
        <label for="offerName">Nome da Oferta</label>
        <input type="text" id="offerName" name="offerName" placeholder="Ex: Acesso VIP 🔥" required>
      </div>

      <div class="input-group">
        <label for="offerType">Tipo de Oferta</label>
        <select id="offerType" name="offerType" required>
          <option value="">Selecione</option>
          <option value="assinatura">Assinatura</option>
          <option value="pagamento-unico">Pagamento Único</option>
          <option value="teste-gratuito">Teste Gratuito</option>
        </select>
      </div>

      <div class="input-group">
        <label for="offerValue">Valor</label>
        <input type="number" id="offerValue" name="offerValue" placeholder="Ex: 29.90" required>
      </div>

      <div class="input-group">
        <label for="tracking">Parâmetro de Rastreamento (UTM)</label>
        <input type="text" id="tracking" name="tracking" placeholder="utm_source=FB&utm_campaign=VIP_Oferta" required>
      </div>

      <div class="actions">
        <button type="submit" class="save-btn">Salvar Oferta</button>
        <button type="reset" class="reset-btn">Limpar</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.getElementById('create-offer-form').addEventListener('submit', e=>{
    e.preventDefault();
    alert('Oferta criada com sucesso!');
  });
</script>

<style>
  html,body{
    margin:0;padding:0;height:100%;width:100%;
    background:#0a0a0a;overflow-x:hidden;overflow-y:auto;
    -webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}
  ::-webkit-scrollbar{display:none!important;}

  .tiger-create{
    position:relative;
    z-index:1;
    min-height:100vh;
    padding:60px 80px 80px 130px;
    display:flex;
    flex-direction:column;
    gap:40px;
    transform:scale(0.9) translateX(70px);
    transform-origin:top left;
  }

  .create-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
  }
  .create-header h1{
    color:#ffcc00;
    font-size:2rem;
    margin:0;
  }
  .create-header p{
    color:#b4b4b4;
    margin-top:8px;
    font-size:.95rem;
  }

  .return-btn{
    background:transparent;
    border:1px solid rgba(255,204,0,0.4);
    color:#ffcc00;
    padding:10px 18px;
    border-radius:8px;
    font-weight:600;
    cursor:pointer;
    transition:all .25s;
  }
  .return-btn:hover{
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    color:#000;
    box-shadow:0 0 15px rgba(255,204,0,0.35);
  }

  .create-container{
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:16px;
    padding:40px 50px;
    width:60%;
    margin:auto;
    box-shadow:0 0 25px rgba(255,204,0,0.08);
  }

  form{
    display:flex;
    flex-direction:column;
    gap:30px;
  }

  .input-group{
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  label{
    color:#ffcc00;
    font-weight:600;
    font-size:.95rem;
  }
  input,select{
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,204,0,0.2);
    border-radius:10px;
    padding:12px 15px;
    color:#fff;
    font-size:1rem;
    outline:none;
    transition:border .2s;
  }
  input:focus,select:focus{
    border-color:#ffcc00;
    box-shadow:0 0 8px rgba(255,204,0,0.3);
  }

  .actions{
    display:flex;
    justify-content:center;
    gap:20px;
    margin-top:10px;
  }

  .save-btn{
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    border:none;
    color:#000;
    font-weight:700;
    padding:12px 30px;
    border-radius:10px;
    cursor:pointer;
    box-shadow:0 0 10px rgba(255,204,0,0.25);
    transition:filter .2s;
  }
  .save-btn:hover{filter:brightness(1.1);}

  .reset-btn{
    background:transparent;
    border:1px solid rgba(255,204,0,0.3);
    color:#ffcc00;
    padding:12px 30px;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
    transition:all .2s;
  }
  .reset-btn:hover{
    background:rgba(255,204,0,0.1);
    box-shadow:0 0 10px rgba(255,204,0,0.25);
  }
</style>
