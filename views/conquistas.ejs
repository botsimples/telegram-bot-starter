<%- include('partials/visual_hottrack') %>

<main class="journey">
  <h1 class="journey-title">Jornada de Conquistas</h1>
  <p class="journey-sub">Acompanhe seus marcos e veja até onde sua performance te leva.</p>

  <div class="timeline">
    <div class="line"></div>

    <div class="achievement" style="--delay:0s">
      <div class="achievement-content">
        <div class="achievement-text">
          <h2>Rumo ao Sucesso — Pacote 10K</h2>
          <span class="badge">R$ 10.000</span>
          <p>Parabéns por alcançar R$ 10.000 em faturamento! Continue escalando suas campanhas rumo a novos patamares.</p>
        </div>
        <img src="https://i.ibb.co/XVmHLvN/placa10k.png" alt="Placa 10k" class="achievement-img">
      </div>
    </div>

    <div class="achievement" style="--delay:0.2s">
      <div class="achievement-content">
        <div class="achievement-text">
          <h2>Visão Estratégica — Pacote 50K</h2>
          <span class="badge">R$ 50.000</span>
          <p>Você atingiu um marco importante com visão e consistência. Continue crescendo com estratégia.</p>
        </div>
        <img src="https://i.ibb.co/2Z1ZYjn/placa50k.png" alt="Placa 50k" class="achievement-img">
      </div>
    </div>

    <div class="achievement" style="--delay:0.4s">
      <div class="achievement-content">
        <div class="achievement-text">
          <h2>Força e Foco — Pacote 100K</h2>
          <span class="badge">R$ 100.000</span>
          <p>Com determinação e foco, você superou o desafio dos seis dígitos. Mantenha o ritmo.</p>
        </div>
        <img src="https://i.ibb.co/djS5w1y/placa100k.png" alt="Placa 100k" class="achievement-img">
      </div>
    </div>

    <div class="achievement" style="--delay:0.6s">
      <div class="achievement-content">
        <div class="achievement-text">
          <h2>Liderança — Pacote 250K</h2>
          <span class="badge">R$ 250.000</span>
          <p>Você se destacou com liderança e resultados sólidos. Um verdadeiro exemplo de alta performance.</p>
        </div>
        <img src="https://i.ibb.co/JF6ZKWh/placa250k.png" alt="Placa 250k" class="achievement-img">
      </div>
    </div>

    <div class="achievement" style="--delay:0.8s">
      <div class="achievement-content">
        <div class="achievement-text">
          <h2>Domínio — Pacote 500K</h2>
          <span class="badge">R$ 500.000</span>
          <p>Agora você domina o jogo. Suas campanhas atingem patamares de elite.</p>
        </div>
        <img src="https://i.ibb.co/XVbWqvJ/placa500k.png" alt="Placa 500k" class="achievement-img">
      </div>
    </div>

    <div class="achievement" style="--delay:1s">
      <div class="achievement-content">
        <div class="achievement-text">
          <h2>Lenda — Pacote 1 Milhão</h2>
          <span class="badge">R$ 1.000.000</span>
          <p>Um marco lendário. Você entrou para o topo da TigerFy, com resultados extraordinários.</p>
        </div>
        <img src="https://i.ibb.co/BtfsN7K/placa1m.png" alt="Placa 1M" class="achievement-img">
      </div>
    </div>
  </div>
</main>

<script>
  // Animação suave ao rolar
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        entry.target.classList.add('show');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.achievement').forEach(el => observer.observe(el));
</script>

<style>
  html, body {
    background:#0a0a0a;
    color:#fff;
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    margin:0;
    padding:0;
  }

  main.journey {
    max-width:1100px;
    margin:0 auto;
    padding:100px 20px;
    position:relative;
  }

  .journey-title {
    text-align:center;
    color:#ffcc00;
    font-size:2.2rem;
    margin-bottom:10px;
  }

  .journey-sub {
    text-align:center;
    color:#a0a0a0;
    margin-bottom:60px;
  }

  .timeline {
    position:relative;
    padding-left:30px;
  }

  .line {
    position:absolute;
    top:0;
    left:14px;
    width:3px;
    height:100%;
    background:linear-gradient(180deg,rgba(255,204,0,0.6),rgba(255,204,0,0.1));
  }

  .achievement {
    opacity:0;
    transform:translateY(50px);
    transition:all 0.6s ease;
    margin-bottom:50px;
  }

  .achievement.show {
    opacity:1;
    transform:translateY(0);
  }

  .achievement-content {
    background:linear-gradient(90deg,rgba(255,255,255,0.04),rgba(255,255,255,0.02));
    border:1px solid rgba(255,204,0,0.15);
    border-radius:12px;
    padding:30px 35px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 0 20px rgba(255,204,0,0.05);
    transition:0.3s;
  }

  .achievement-content:hover {
    border-color:rgba(255,204,0,0.4);
    box-shadow:0 0 25px rgba(255,204,0,0.15);
  }

  .achievement-text {
    max-width:70%;
  }

  .achievement-text h2 {
    margin:0 0 8px 0;
    font-size:1.3rem;
    color:#ffcc00;
  }

  .achievement-text p {
    margin:10px 0 0;
    color:#b5b5b5;
    line-height:1.5;
  }

  .badge {
    display:inline-block;
    background:rgba(255,204,0,0.15);
    color:#ffcc00;
    font-weight:600;
    border-radius:20px;
    padding:5px 15px;
    font-size:0.9rem;
  }

  .achievement-img {
    width:120px;
    height:auto;
    border-radius:8px;
    object-fit:cover;
  }

  @media(max-width:800px){
    .achievement-content{
      flex-direction:column;
      align-items:flex-start;
      gap:20px;
    }
    .achievement-text{max-width:100%;}
    .achievement-img{width:100%;max-width:200px;align-self:center;}
  }
</style>
