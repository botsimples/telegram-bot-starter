<%- include('partials/visual_hottrack') %>

<main class="achievements-page">
  <section class="achievements-container">
    <header class="achievements-header">
      <h1>Conquistas</h1>
      <p>Veja seu progresso, metas e desbloqueie recompensas do painel TigerFy.</p>
    </header>

    <div class="achievements-list">
      <div class="achievement-row">
        <div class="achievement-info">
          <h3>Primeira Venda</h3>
          <p>Parabéns pela primeira conversão!</p>
        </div>
        <button class="achievement-btn">Ver</button>
      </div>

      <div class="achievement-row">
        <div class="achievement-info">
          <h3>10 Vendas</h3>
          <p>Continue escalando suas campanhas.</p>
        </div>
        <button class="achievement-btn">Ver</button>
      </div>

      <div class="achievement-row">
        <div class="achievement-info">
          <h3>100 Leads</h3>
          <p>Excelente tração! Você está crescendo.</p>
        </div>
        <button class="achievement-btn">Ver</button>
      </div>

      <div class="achievement-row">
        <div class="achievement-info">
          <h3>Top Afiliado</h3>
          <p>Reconhecimento por alta performance.</p>
        </div>
        <button class="achievement-btn">Ver</button>
      </div>
    </div>
  </section>
</main>

<script>
  // Fundo discreto com partículas douradas leves
  const c=document.createElement('canvas');
  c.id='bgParticles';document.body.appendChild(c);
  const ctx=c.getContext('2d',{alpha:true});
  let w,h,DPR=window.devicePixelRatio||1;
  function resize(){w=innerWidth;h=innerHeight;c.width=w*DPR;c.height=h*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);}
  resize();addEventListener('resize',resize,{passive:true});
  const p=[];for(let i=0;i<20;i++)p.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1+0.3,dx:(Math.random()-.5)*.2,dy:(Math.random()-.5)*.2});
  function draw(){ctx.clearRect(0,0,w,h);ctx.fillStyle='rgba(255,204,0,0.08)';for(const o of p){ctx.beginPath();ctx.arc(o.x,o.y,o.r,0,Math.PI*2);ctx.fill();o.x+=o.dx;o.y+=o.dy;if(o.x<0||o.x>w)o.dx*=-1;if(o.y<0||o.y>h)o.dy*=-1;}requestAnimationFrame(draw);}draw();
</script>

<style>
  html,body {
    margin:0;padding:0;height:100%;width:100%;
    background:#0a0a0a;
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}
  ::-webkit-scrollbar{display:none!important;}

  #bgParticles {
    position:fixed;inset:0;width:100vw;height:100vh;
    z-index:0;mix-blend-mode:screen;pointer-events:none;
    background-image:radial-gradient(rgba(255,255,255,0.02) 1px,transparent 1px);
    background-size:20px 20px;
  }

  main.achievements-page {
    position:relative;z-index:1;
    display:flex;justify-content:center;align-items:flex-start;
    padding:100px 60px 80px 60px;
    min-height:100vh;
  }

  .achievements-container {
    width:100%;
    max-width:1100px;
  }

  .achievements-header {
    text-align:center;
    margin-bottom:40px;
  }
  .achievements-header h1 {
    font-size:2rem;
    color:#ffcc00;
    margin-bottom:10px;
  }
  .achievements-header p {
    color:#b5b5b5;
  }

  .achievements-list {
    display:flex;
    flex-direction:column;
    gap:20px;
  }

  .achievement-row {
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.1);
    border-radius:12px;
    padding:25px 30px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    transition:all .25s ease;
  }
  .achievement-row:hover {
    background:rgba(255,204,0,0.07);
    border-color:rgba(255,204,0,0.25);
  }

  .achievement-info h3 {
    font-size:1.1rem;
    margin:0 0 6px 0;
    color:#fff;
  }
  .achievement-info p {
    color:#a0a0a0;
    margin:0;
    font-size:.95rem;
  }

  .achievement-btn {
    background:#ffcc00;
    color:#000;
    border:none;
    border-radius:8px;
    font-weight:600;
    padding:10px 40px;
    cursor:pointer;
    transition:all .25s ease;
  }
  .achievement-btn:hover {
    background:#ffd633;
    transform:translateY(-1px);
  }

  @media(max-width:700px){
    .achievement-row{
      flex-direction:column;
      align-items:flex-start;
      gap:15px;
    }
    .achievement-btn{
      width:100%;
    }
  }
</style>
