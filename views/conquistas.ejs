<%- include('partials/visual_hottrack') %>

<main class="journey">
  <h1 class="journey-title">Jornada de Conquistas</h1>
  <p class="journey-sub">Acompanhe seus marcos e veja seu progresso evoluir.</p>

  <div class="timeline">
    <div class="line"></div>

    <% const conquistas = [
      {titulo: 'Rumo ao Sucesso — Pacote 10K', valor: 'R$ 10.000', progresso: 40, descricao: 'Parabéns por alcançar R$ 10.000 em faturamento! Continue escalando suas campanhas rumo a novos patamares.', imagem: 'https://i.ibb.co/XVmHLvN/placa10k.png'},
      {titulo: 'Visão Estratégica — Pacote 50K', valor: 'R$ 50.000', progresso: 15, descricao: 'Você atingiu um marco importante com visão e consistência. Continue crescendo com estratégia.', imagem: 'https://i.ibb.co/2Z1ZYjn/placa50k.png'},
      {titulo: 'Força e Foco — Pacote 100K', valor: 'R$ 100.000', progresso: 0, descricao: 'Com determinação e foco, você superou o desafio dos seis dígitos. Mantenha o ritmo.', imagem: 'https://i.ibb.co/djS5w1y/placa100k.png'},
      {titulo: 'Liderança — Pacote 250K', valor: 'R$ 250.000', progresso: 0, descricao: 'Você se destacou com liderança e resultados sólidos. Um verdadeiro exemplo de alta performance.', imagem: 'https://i.ibb.co/JF6ZKWh/placa250k.png'},
      {titulo: 'Domínio — Pacote 500K', valor: 'R$ 500.000', progresso: 0, descricao: 'Agora você domina o jogo. Suas campanhas atingem patamares de elite.', imagem: 'https://i.ibb.co/XVbWqvJ/placa500k.png'},
      {titulo: 'Lenda — Pacote 1 Milhão', valor: 'R$ 1.000.000', progresso: 0, descricao: 'Um marco lendário. Você entrou para o topo da TigerFy, com resultados extraordinários.', imagem: 'https://i.ibb.co/BtfsN7K/placa1m.png'}
    ]; %>

    <% conquistas.forEach((c,i)=>{ %>
      <div class="achievement <%= i % 2 === 0 ? 'left' : 'right' %>" style="--delay:<%= i * 0.2 %>s">
        <div class="achievement-content">
          <div class="achievement-text">
            <h2><%= c.titulo %></h2>
            <span class="badge"><%= c.valor %></span>
            <p><%= c.descricao %></p>

            <div class="progress-box">
              <div class="progress-info">
                <span>Progresso</span>
                <span><%= c.progresso %>%</span>
              </div>
              <div class="progress-bar">
                <div class="progress" style="width:<%= c.progresso %>%"></div>
              </div>
            </div>
          </div>
          <img src="<%= c.imagem %>" alt="<%= c.titulo %>" class="achievement-img">
        </div>
      </div>
    <% }) %>
  </div>
</main>

<script>
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        entry.target.classList.add('show');
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('.achievement').forEach(el => observer.observe(el));
</script>

<style>
  html,body{
    background:#0a0a0a;
    color:#fff;
    font-family:'Inter',sans-serif;
    margin:0;padding:0;
    -webkit-font-smoothing:antialiased;
  }

  main.journey {
    max-width:1200px;
    margin:0 auto;
    padding:100px 30px;
    position:relative;
  }

  .journey-title {
    text-align:center;
    color:#ffcc00;
    font-size:2.4rem;
    margin-bottom:8px;
  }
  .journey-sub {
    text-align:center;
    color:#a0a0a0;
    margin-bottom:70px;
  }

  .timeline {
    position:relative;
    padding-left:50%;
  }

  .line {
    position:absolute;
    left:50%;
    top:0;
    width:3px;
    height:100%;
    background:linear-gradient(180deg,rgba(255,204,0,0.6),rgba(255,204,0,0.1));
    transform:translateX(-50%);
  }

  .achievement {
    width:calc(50% - 60px);
    opacity:0;
    transform:translateY(60px);
    transition:all 0.6s ease;
    margin-bottom:80px;
    position:relative;
  }
  .achievement.show {
    opacity:1;
    transform:translateY(0);
  }

  .achievement.left { left:0; }
  .achievement.right { left:50%; }

  .achievement-content {
    background:linear-gradient(90deg,rgba(255,255,255,0.05),rgba(255,255,255,0.02));
    border:1px solid rgba(255,204,0,0.15);
    border-radius:12px;
    padding:35px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 0 25px rgba(255,204,0,0.05);
    transition:.3s;
  }

  .achievement-content:hover {
    border-color:rgba(255,204,0,0.35);
    box-shadow:0 0 30px rgba(255,204,0,0.15);
  }

  .achievement-text {
    max-width:65%;
  }

  .achievement-text h2 {
    margin:0 0 8px 0;
    color:#ffcc00;
    font-size:1.4rem;
  }

  .achievement-text p {
    color:#b5b5b5;
    line-height:1.5;
    margin:10px 0 20px 0;
  }

  .badge {
    display:inline-block;
    background:rgba(255,204,0,0.15);
    color:#ffcc00;
    padding:6px 16px;
    font-weight:600;
    border-radius:20px;
    font-size:.9rem;
  }

  .achievement-img {
    width:180px;
    height:auto;
    border-radius:10px;
    object-fit:cover;
  }

  /* Barras de progresso */
  .progress-box {
    margin-top:10px;
  }
  .progress-info {
    display:flex;
    justify-content:space-between;
    font-size:0.85rem;
    color:#b5b5b5;
    margin-bottom:5px;
  }
  .progress-bar {
    width:100%;
    height:8px;
    background:rgba(255,255,255,0.07);
    border-radius:6px;
    overflow:hidden;
  }
  .progress {
    height:100%;
    background:linear-gradient(90deg,#ffcc00,#ffd84a);
    transition:width 0.5s ease;
  }

  @media(max-width:950px){
    .timeline {padding-left:0;}
    .line {left:10px;transform:none;}
    .achievement{width:100%;left:0!important;}
    .achievement-content{flex-direction:column;align-items:flex-start;gap:20px;}
    .achievement-img{width:100%;max-width:250px;}
  }
</style>
