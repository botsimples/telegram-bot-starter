  #bgParticles{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;mix-blend-mode:screen;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,0.03) 1px,transparent 1px);background-size:20px 20px;}
  main.offers-page{position:relative;z-index:1;min-height:100vh;display:flex;justify-content:center;align-items:center;padding-left:70px;transform:translateY(-90px);}
  .offers-container{text-align:center;width:90%;max-width:1100px;}
  .offers-header h1{color:#ffcc00;font-size:2rem;margin-bottom:10px;}
  .offers-header p{color:#b4b4b4;margin-bottom:40px;}
  .offers-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:25px;justify-items:center;}
