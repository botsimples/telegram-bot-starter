<%- include('partials/visual_hottrack') %>

<main class="offers-page">
  <section class="offers-container">
    <header class="offers-header">
      <h1>Conquistas</h1>
      <p>Veja seu progresso, metas e desbloqueie recompensas do painel TigerFy.</p>
    </header>

    <div class="offers-grid">
      <div class="offer-card"><h3>Primeira Venda</h3><p>Parabéns pela primeira conversão!</p><button class="offer-btn">Ver</button></div>
      <div class="offer-card"><h3>10 Vendas</h3><p>Continue escalando suas campanhas.</p><button class="offer-btn">Ver</button></div>
      <div class="offer-card"><h3>100 Leads</h3><p>Excelente tração! Você está crescendo.</p><button class="offer-btn">Ver</button></div>
      <div class="offer-card"><h3>Top Afiliado</h3><p>Reconhecimento por alta performance.</p><button class="offer-btn">Ver</button></div>
    </div>
  </section>
</main>

<script>
  const c=document.createElement('canvas');c.id='bgParticles';document.body.appendChild(c);
  const ctx=c.getContext('2d',{alpha:true});
  let w,h,DPR=window.devicePixelRatio||1;
  function resize(){w=innerWidth;h=innerHeight;c.width=w*DPR;c.height=h*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);}
  resize();addEventListener('resize',resize,{passive:true});
  const p=[];for(let i=0;i<25;i++)p.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.2+0.4,dx:(Math.random()-.5)*.25,dy:(Math.random()-.5)*.25});
  function draw(){ctx.clearRect(0,0,w,h);ctx.fillStyle='rgba(255,204,0,0.15)';for(const o of p){ctx.beginPath();ctx.arc(o.x,o.y,o.r,0,Math.PI*2);ctx.fill();o.x+=o.dx;o.y+=o.dy;if(o.x<0||o.x>w)o.dx*=-1;if(o.y<0||o.y>h)o.dy*=-1;}requestAnimationFrame(draw);}draw();
</script>

<style>
  html,body{margin:0;padding:0;height:100%;width:100%;overflow-x:hidden;overflow-y:auto;background:#0a0a0a;-webkit-font-smoothing:antialiased;}
  *{box-sizing:border-box;transform:translateZ(0);will-change:transform;}::-webkit-scrollbar{display:none!important;}
  #bgParticles{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;mix-blend-mode:screen;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,0.03) 1px,transparent 1px);background-size:20px 20px;}
  main.offers
