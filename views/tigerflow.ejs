<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TigerFlow ⚡</title>
  <style>
    :root {
      --bg-dark: #0a0a0a;
      --bg-light: #f5f5f5;
      --dot-dark: rgba(255, 204, 0, 0.08);
      --dot-light: rgba(0, 0, 0, 0.08);
      --block-dark: rgba(255,255,255,0.05);
      --block-light: rgba(0,0,0,0.05);
      --border-dark: rgba(255,204,0,0.25);
      --border-light: rgba(0,0,0,0.15);
      --accent-dark: #ffcc00;
      --accent-light: #b38b00;
    }

    body {
      margin: 0;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
      user-select: none;
      transition: background 0.4s, color 0.4s;
      background-color: var(--bg-dark);
      color: white;
    }

    /* Fundo pontilhado + linhas */
    canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      background-image:
        radial-gradient(var(--dot-dark) 1px, transparent 1px),
        linear-gradient(var(--dot-dark) 1px, transparent 1px),
        linear-gradient(90deg, var(--dot-dark) 1px, transparent 1px);
      background-size: 25px 25px, 100px 100px, 100px 100px;
      background-position: 0 0, 0 0, 0 0;
      transition: background-image 0.4s;
      cursor: grab;
    }

    .flow-ui {
      position: fixed;
      top: 20px;
      left: 20px;
      z-index: 10;
      display: flex;
      gap: 10px;
      align-items: center;
    }

    button {
      background: linear-gradient(90deg,#ffcc00,#d4a100);
      border: none;
      color: #000;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      transition: all .2s;
      box-shadow: 0 0 8px rgba(255,204,0,0.3);
    }

    button:hover { filter: brightness(1.15); }

    .node {
      position: absolute;
      width: 200px;
      min-height: 90px;
      background: var(--block-dark);
      border: 1px solid var(--border-dark);
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(255,204,0,0.15);
      color: #fff;
      padding: 10px;
      cursor: move;
      z-index: 2;
      transition: background 0.4s, border 0.4s;
    }

    .node h4 {
      margin: 0 0 6px;
      color: var(--accent-dark);
      font-size: 1rem;
      font-weight: 600;
      cursor: text;
    }

    .node p {
      margin: 0;
      font-size: .85rem;
      color: #ccc;
      cursor: text;
    }

    #themeToggle {
      background: #111;
      color: #ffcc00;
      font-weight: 500;
      border: 1px solid rgba(255,204,0,0.3);
    }

    body.light {
      background-color: var(--bg-light);
      color: #111;
    }

    body.light canvas {
      background-image:
        radial-gradient(var(--dot-light) 1px, transparent 1px),
        linear-gradient(var(--dot-light) 1px, transparent 1px),
        linear-gradient(90deg, var(--dot-light) 1px, transparent 1px);
    }

    body.light .node {
      background: var(--block-light);
      border: 1px solid var(--border-light);
      color: #111;
    }

    body.light .node h4 {
      color: var(--accent-light);
    }

    body.light button {
      background: linear-gradient(90deg,#f5c400,#a07900);
      color: #000;
    }

  </style>
</head>
<body>
  <canvas id="flowCanvas"></canvas>

  <div class="flow-ui">
    <button id="addNode">+ Bloco</button>
    <button id="saveFlow">💾 Salvar</button>
    <button id="exportPNG">🖼️ Exportar</button>
    <button id="themeToggle">🌙 Modo Claro</button>
  </div>

  <script>
    const canvas = document.getElementById('flowCanvas');
    const ctx = canvas.getContext('2d');
    let w = window.innerWidth, h = window.innerHeight;
    canvas.width = w; canvas.height = h;

    let scale = 1, offsetX = 0, offsetY = 0;
    let nodes = [], lines = [], isPanning = false;
    let startNode = null, selectedNode = null;

    function resize() {
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = w; canvas.height = h;
      draw();
    }
    window.addEventListener('resize', resize);

    function draw() {
      ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);
      ctx.clearRect(-offsetX/scale, -offsetY/scale, w/scale, h/scale);
      lines.forEach(line => {
        const n1 = nodes.find(n => n.id === line.from);
        const n2 = nodes.find(n => n.id === line.to);
        if (n1 && n2) {
          const x1 = n1.x + 100, y1 = n1.y + 45;
          const x2 = n2.x + 100, y2 = n2.y + 45;
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = 'rgba(255,204,0,0.6)';
          ctx.lineWidth = 2;
          ctx.stroke();
        }
      });
    }

    canvas.addEventListener('mousedown', e => {
      if (e.button === 2) { isPanning = true; panStart = {x:e.clientX,y:e.clientY}; canvas.style.cursor='grabbing'; }
    });
    canvas.addEventListener('mousemove', e => {
      if (isPanning){
        offsetX += (e.clientX - panStart.x);
        offsetY += (e.clientY - panStart.y);
        panStart = {x:e.clientX,y:e.clientY};
        draw();
      }
    });
    canvas.addEventListener('mouseup', ()=>{ isPanning=false; canvas.style.cursor='grab'; });
    canvas.addEventListener('contextmenu', e=>e.preventDefault());
    canvas.addEventListener('wheel', e=>{
      e.preventDefault();
      scale *= e.deltaY > 0 ? 0.9 : 1.1;
      draw();
    });

    function makeNode(x,y,title='Novo Bloco',desc='Descrição...'){
      const id = Date.now()+Math.random();
      const div = document.createElement('div');
      div.className = 'node';
      div.style.left = x+'px';
      div.style.top = y+'px';
      div.innerHTML = `<h4 contenteditable="true">${title}</h4><p contenteditable="true">${desc}</p>`;
      div.dataset.id = id;
      document.body.appendChild(div);
      drag(div);
      nodes.push({id,x,y,el:div});
    }

    function drag(el){
      let isDown=false, dx, dy;
      el.addEventListener('mousedown',e=>{
        if(e.button===0){isDown=true;dx=e.offsetX;dy=e.offsetY;selectedNode=el;}
      });
      window.addEventListener('mousemove',e=>{
        if(isDown){
          el.style.left=(e.clientX-dx)+'px';
          el.style.top=(e.clientY-dy)+'px';
          const node = nodes.find(n=>n.id==el.dataset.id);
          if(node){node.x=parseInt(el.style.left);node.y=parseInt(el.style.top);}
          draw();
        }
      });
      window.addEventListener('mouseup',()=>isDown=false);
      el.addEventListener('dblclick',()=>{
        if(startNode && startNode!==el){
          lines.push({from:startNode.dataset.id,to:el.dataset.id});
          startNode=null;
          draw();
        } else startNode=el;
      });
    }

    document.getElementById('addNode').onclick = ()=>makeNode(300,200);

    document.getElementById('saveFlow').onclick = async ()=>{
      const flowData = {
        name:'TigerFlow',
        nodes:nodes.map(n=>({id:n.id,x:n.x,y:n.y,title:n.el.querySelector('h4').innerText,desc:n.el.querySelector('p').innerText})),
        edges:lines
      };
      await fetch('/api/flows',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(flowData)});
      alert('💾 Fluxo salvo!');
    };

    document.getElementById('exportPNG').onclick = ()=>{
      html2canvas(document.body).then(canvas=>{
        const a=document.createElement('a');
        a.href=canvas.toDataURL('image/png');
        a.download='tigerflow.png';
        a.click();
      });
    };

    // modo claro / escuro
    const toggle=document.getElementById('themeToggle');
    toggle.onclick=()=>{
      document.body.classList.toggle('light');
      toggle.textContent = document.body.classList.contains('light') ? '🌑 Modo Escuro' : '🌙 Modo Claro';
    };

    draw();
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
</body>
</html>
