<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TigerFlow ⚡ Studio</title>
  <style>
    :root {
      --bg-dark: #0a0a0a;
      --bg-light: #f8f8f8;
      --dot-dark: rgba(255,204,0,0.08);
      --dot-light: rgba(0,0,0,0.08);
      --accent-dark: #ffcc00;
      --accent-light: #b38b00;
      --block-dark: rgba(255,255,255,0.05);
      --block-light: rgba(0,0,0,0.05);
    }

    body {
      margin: 0;
      overflow: hidden;
      font-family: 'Inter', sans-serif;
      background: var(--bg-dark);
      color: #fff;
      transition: background 0.3s, color 0.3s;
      user-select: none;
    }

    canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      background-image:
        radial-gradient(var(--dot-dark) 1px, transparent 1px),
        linear-gradient(var(--dot-dark) 1px, transparent 1px),
        linear-gradient(90deg, var(--dot-dark) 1px, transparent 1px);
      background-size: 25px 25px, 100px 100px, 100px 100px;
      cursor: grab;
    }

    body.light {
      background: var(--bg-light);
      color: #000;
    }

    body.light canvas {
      background-image:
        radial-gradient(var(--dot-light) 1px, transparent 1px),
        linear-gradient(var(--dot-light) 1px, transparent 1px),
        linear-gradient(90deg, var(--dot-light) 1px, transparent 1px);
    }

    .ui {
      position: fixed;
      top: 20px;
      left: 20px;
      display: flex;
      gap: 10px;
      z-index: 10;
    }

    button {
      background: linear-gradient(90deg, #ffcc00, #d4a100);
      border: none;
      color: #000;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      box-shadow: 0 0 8px rgba(255,204,0,0.3);
      transition: filter .2s;
    }

    button:hover { filter: brightness(1.15); }

    .node {
      position: absolute;
      width: 200px;
      background: var(--block-dark);
      border: 1px solid rgba(255,204,0,0.25);
      border-radius: 12px;
      color: inherit;
      box-shadow: 0 0 10px rgba(255,204,0,0.15);
      padding: 10px;
      text-align: center;
      z-index: 2;
      transition: background 0.3s, border 0.3s;
    }

    .node h4 {
      margin: 0 0 6px;
      color: var(--accent-dark);
      font-size: 1rem;
      cursor: text;
    }

    .node p {
      margin: 0;
      font-size: 0.85rem;
      color: #ccc;
      cursor: text;
    }

    .handle {
      position: absolute;
      width: 10px;
      height: 10px;
      background: var(--accent-dark);
      border-radius: 50%;
      cursor: crosshair;
      box-shadow: 0 0 6px rgba(255,204,0,0.7);
      transition: transform 0.2s;
    }

    .handle:hover { transform: scale(1.3); }

    .handle.top { top: -6px; left: 50%; transform: translateX(-50%); }
    .handle.bottom { bottom: -6px; left: 50%; transform: translateX(-50%); }
    .handle.left { left: -6px; top: 50%; transform: translateY(-50%); }
    .handle.right { right: -6px; top: 50%; transform: translateY(-50%); }

    body.light .node { background: var(--block-light); }
    body.light .node h4 { color: var(--accent-light); }
    body.light .handle { background: var(--accent-light); }

    #themeToggle {
      background: #111;
      color: #ffcc00;
      border: 1px solid rgba(255,204,0,0.3);
    }
  </style>
</head>
<body>
  <canvas id="flowCanvas"></canvas>
  <div class="ui">
    <button id="addNode">+ Bloco</button>
    <button id="saveFlow">💾 Salvar</button>
    <button id="themeToggle">🌙 Modo Claro</button>
  </div>

  <script>
    const canvas = document.getElementById('flowCanvas');
    const ctx = canvas.getContext('2d');
    let w = window.innerWidth, h = window.innerHeight;
    canvas.width = w; canvas.height = h;

    let nodes = [], lines = [];
    let draggingCanvas = false, scale = 1, offsetX = 0, offsetY = 0;
    let startHandle = null;

    function draw() {
      ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);
      ctx.clearRect(-offsetX/scale, -offsetY/scale, w/scale, h/scale);
      lines.forEach(line => {
        const n1 = document.getElementById(line.from.node);
        const n2 = document.getElementById(line.to.node);
        if (n1 && n2) {
          const p1 = n1.querySelector(`.${line.from.side}`).getBoundingClientRect();
          const p2 = n2.querySelector(`.${line.to.side}`).getBoundingClientRect();
          const x1 = p1.left + 5 - offsetX, y1 = p1.top + 5 - offsetY;
          const x2 = p2.left + 5 - offsetX, y2 = p2.top + 5 - offsetY;
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = 'rgba(255,204,0,0.8)';
          ctx.lineWidth = 2.2;
          ctx.shadowBlur = 8;
          ctx.shadowColor = 'rgba(255,204,0,0.8)';
          ctx.stroke();
          ctx.shadowBlur = 0;
        }
      });
    }

    function makeNode(x, y) {
      const id = 'node' + Date.now();
      const div = document.createElement('div');
      div.className = 'node';
      div.id = id;
      div.style.left = x + 'px';
      div.style.top = y + 'px';
      div.innerHTML = `
        <h4 contenteditable="true">Novo Bloco</h4>
        <p contenteditable="true">Descrição...</p>
        <div class="handle top"></div>
        <div class="handle bottom"></div>
        <div class="handle left"></div>
        <div class="handle right"></div>`;
      document.body.appendChild(div);

      dragNode(div);
      handleConnection(div);
      nodes.push(div);
    }

    function dragNode(el) {
      let drag = false, dx, dy;
      el.addEventListener('mousedown', e => {
        if (e.target.classList.contains('handle')) return;
        drag = true; dx = e.offsetX; dy = e.offsetY;
      });
      window.addEventListener('mousemove', e => {
        if (drag) {
          el.style.left = (e.clientX - dx) + 'px';
          el.style.top = (e.clientY - dy) + 'px';
          draw();
        }
      });
      window.addEventListener('mouseup', () => drag = false);
    }

    function handleConnection(el) {
      el.querySelectorAll('.handle').forEach(h => {
        h.addEventListener('mousedown', e => {
          startHandle = { node: el.id, side: h.classList[1] };
          e.stopPropagation();
        });
      });
      document.addEventListener('mouseup', e => {
        if (startHandle) {
          const endHandle = e.target;
          if (endHandle.classList.contains('handle') && endHandle.closest('.node').id !== startHandle.node) {
            const endNode = endHandle.closest('.node').id;
            const endSide = endHandle.classList[1];
            lines.push({ from: startHandle, to: { node: endNode, side: endSide } });
            draw();
          }
          startHandle = null;
        }
      });
    }

    canvas.addEventListener('mousedown', e => {
      if (e.button === 2) {
        draggingCanvas = true;
        panStart = { x: e.clientX, y: e.clientY };
        canvas.style.cursor = 'grabbing';
      }
    });

    canvas.addEventListener('mousemove', e => {
      if (draggingCanvas) {
        offsetX += (e.clientX - panStart.x);
        offsetY += (e.clientY - panStart.y);
        panStart = { x: e.clientX, y: e.clientY };
        draw();
      }
    });

    canvas.addEventListener('mouseup', () => {
      draggingCanvas = false;
      canvas.style.cursor = 'grab';
    });

    canvas.addEventListener('contextmenu', e => e.preventDefault());
    canvas.addEventListener('wheel', e => {
      e.preventDefault();
      scale *= e.deltaY > 0 ? 0.9 : 1.1;
      draw();
    });

    document.getElementById('addNode').onclick = () => makeNode(200, 200);

    document.getElementById('saveFlow').onclick = async () => {
      const data = {
        nodes: nodes.map(n => ({
          id: n.id,
          title: n.querySelector('h4').innerText,
          desc: n.querySelector('p').innerText,
          left: n.style.left,
          top: n.style.top
        })),
        lines
      };
      await fetch('/api/flows', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      alert('💾 Fluxo salvo!');
    };

    const themeToggle = document.getElementById('themeToggle');
    themeToggle.onclick = () => {
      document.body.classList.toggle('light');
      themeToggle.textContent = document.body.classList.contains('light')
        ? '🌑 Modo Escuro'
        : '🌙 Modo Claro';
      draw();
    };

    window.addEventListener('resize', () => { w = innerWidth; h = innerHeight; canvas.width = w; canvas.height = h; draw(); });

    draw();
  </script>
</body>
</html>
