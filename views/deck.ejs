<main class="deck-wrapper">
  <div class="page-container">
    <header class="page-header">
      <h1>Dashboard Geral</h1>
      <p>Visão geral das métricas do sistema TigerFy.</p>
    </header>

    <section class="deck-grid">
      <div class="deck-card"><h2>Total de Vendas</h2><span class="value">R$ 0,00</span></div>
      <div class="deck-card"><h2>Vendas no Mês</h2><span class="value">R$ 0,00</span></div>
      <div class="deck-card"><h2>Vendas no Dia</h2><span class="value">R$ 0,00</span></div>
      <div class="deck-card"><h2>PIX Gerados</h2><span class="value">0</span></div>
      <div class="deck-card"><h2>PIX Pagos</h2><span class="value">0</span></div>
    </section>

    <section class="chart-section">
      <div class="chart-card">
        <div class="chart-header">
          <h2>Histórico de Faturamento</h2>
          <span class="chart-filter">Últimos 7 dias</span>
        </div>
        <div class="chart-placeholder">[ gráfico em breve ]</div>
      </div>
    </section>

    <section class="table-section">
      <div class="table-header">
        <h2>Pagamentos Recentes</h2>
      </div>
      <table class="styled-table">
        <thead>
          <tr>
            <th>ID</th><th>Usuário</th><th>Valor</th><th>Status</th><th>Data</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>–</td><td>–</td><td>–</td><td>–</td><td>–</td></tr>
        </tbody>
      </table>
    </section>
  </div>
</main>
