html,body{
  margin:0;padding:0;height:100%;width:100%;
  overflow:hidden!important;
  background:#0a0a0a;
  -webkit-font-smoothing:antialiased;
}
*{box-sizing:border-box;}
::-webkit-scrollbar{display:none!important;}

#bgParticles{
  position:fixed;inset:0;width:100vw;height:100vh;
  z-index:0;mix-blend-mode:screen;pointer-events:none;
  background-image:radial-gradient(rgba(255,255,255,0.03) 1px,transparent 1px);
  background-size:20px 20px;
}

/* 💎 Ajuste automático levando em conta a sidebar */
main.offers-page{
  position:relative;
  z-index:1;
  height:100vh;
  width:calc(100vw - 240px); /* sidebar ocupa 240px */
  margin-left:240px; /* evita sobreposição */
  display:flex;
  justify-content:center;
  align-items:center;
}

/* Centralização real independente da resolução */
.offers-container{
  text-align:center;
  width:90%;
  max-width:1100px;
  transform:translateY(-2vh); /* sobe levemente */
}

/* Título e descrição */
.offers-header h1{
  color:#ffcc00;
  font-size:2rem;
  margin-bottom:10px;
}
.offers-header p{
  color:#b4b4b4;
  margin-bottom:35px;
}

/* Grid de métricas adaptável */
.offers-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:25px;
  justify-items:center;
  align-items:center;
}

/* Cards */
.offer-card{
  width:260px;height:260px;
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,204,0,0.12);
  border-radius:14px;
  padding:25px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  align-items:center;
  transition:.25s ease-out;
}
.offer-card:hover{
  background:rgba(255,204,0,0.07);
  box-shadow:0 0 15px rgba(255,204,0,0.25);
  transform:translateY(-3px);
}

/* Textos e botões */
.offer-card h3{color:#fff;margin:10px 0 5px;}
.offer-card p{color:#b4b4b4;font-size:.9rem;min-height:45px;}
.offer-btn{
  background:linear-gradient(90deg,#ffcc00,#d4a100);
  color:#000;
  border:none;
  border-radius:8px;
  padding:8px 16px;
  font-weight:600;
  cursor:pointer;
  transition:filter .3s;
}
.offer-btn:hover{filter:brightness(1.15);}
