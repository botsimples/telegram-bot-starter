<div class="deck-container fade-in">
  <header class="deck-header">
    <h1>📈 <span>Estatísticas Gerais</span></h1>
    <p>Visão geral de toda a plataforma.</p>
    <button class="btn-gold">Filtrar Ofertas</button>
  </header>

  <section class="stats-grid">
    <div class="stat-card"><h4>Total de Vendas</h4><p>R$ 0,00</p></div>
    <div class="stat-card"><h4>Vendas no Ano</h4><p>R$ 0,00</p></div>
    <div class="stat-card"><h4>Vendas no Mês</h4><p>R$ 0,00</p></div>
    <div class="stat-card"><h4>Vendas no Dia</h4><p>R$ 0,00</p></div>
    <div class="stat-card"><h4>Total Usuários</h4><p>0</p></div>
    <div class="stat-card"><h4>Usuários no Ano</h4><p>0</p></div>
    <div class="stat-card"><h4>Usuários no Mês</h4><p>0</p></div>
    <div class="stat-card"><h4>Usuários no Dia</h4><p>0</p></div>
    <div class="stat-card"><h4>Conversões Ativas</h4><p>0</p></div>
    <div class="stat-card"><h4>Taxa de Conversão</h4><p>0%</p></div>
    <div class="stat-card"><h4>Ticket Médio</h4><p>R$ 0,00</p></div>
    <div class="stat-card"><h4>Lucro Estimado</h4><p>R$ 0,00</p></div>
  </section>

  <section class="chart-section">
    <h2>📊 Usuários por Horário</h2>
    <div class="chart-placeholder">[ gráfico em breve ]</div>
    <div class="chart-filters">
      <button class="btn-gold small">Hoje</button>
      <button class="btn-gold small">Ontem</button>
      <button class="btn-gold small">Essa Semana</button>
      <button class="btn-gold small">Esse Mês</button>
      <button class="btn-gold small">Personalizado</button>
    </div>
  </section>

  <section class="recent-payments">
    <h2>💸 Pagamentos Recentes</h2>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuário</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Data</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td colspan="5">Nenhum pagamento recente</td>
        </tr>
      </tbody>
    </table>
  </section>
</div>
