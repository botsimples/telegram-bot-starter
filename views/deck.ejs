<%- include('partials/visual_hottrack') %>

<div class="tiger-dashboard">
  <div class="tiger-header">
    <div>
      <h1>Estatísticas Gerais</h1>
      <p>Visão geral de toda a plataforma TigerFy.</p>
    </div>
    <button class="filter-btn">Filtrar Ofertas</button>
  </div>

  <div class="stats-grid">
    <div class="stat-card"><h3>Total de Vendas</h3><span>R$ 0,00</span></div>
    <div class="stat-card"><h3>Vendas no Ano</h3><span>R$ 0,00</span></div>
    <div class="stat-card"><h3>Vendas no Mês</h3><span>R$ 0,00</span></div>
    <div class="stat-card"><h3>Vendas no Dia</h3><span>R$ 0,00</span></div>
    <div class="stat-card"><h3>Total Usuários</h3><span>0</span></div>
    <div class="stat-card"><h3>Usuários no Ano</h3><span>0</span></div>
    <div class="stat-card"><h3>Conversões Ativas</h3><span>0</span></div>
    <div class="stat-card"><h3>Taxa de Conversão</h3><span>0%</span></div>
    <div class="stat-card"><h3>Ticket Médio</h3><span>R$ 0,00</span></div>
    <div class="stat-card"><h3>Lucro Estimado</h3><span>R$ 0,00</span></div>
  </div>

  <div class="chart-block">
    <div class="chart-head">
      <h3>Usuários por Horário</h3>
      <div class="tabs">
        <button class="active">Hoje</button>
        <button>Ontem</button>
        <button>Essa Semana</button>
        <button>Esse Mês</button>
        <button>Personalizado</button>
      </div>
    </div>
    <div class="chart-placeholder">[ gráfico em breve ]</div>
  </div>

  <div class="table-block">
    <h3>Pagamentos Recentes</h3>
    <table>
      <thead>
        <tr>
          <th>ID</th><th>Usuário</th><th>Valor</th><th>Status</th><th>Data</th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="5" style="text-align:center;color:#777;">Nenhum pagamento recente</td></tr>
      </tbody>
    </table>
  </div>
</div>

<style>
  body,html{margin:0;padding:0;background:#0a0a0a;}
  *{box-sizing:border-box;}::-webkit-scrollbar{display:none}
  .tiger-dashboard{
    position:relative;z-index:1;min-height:100vh;
    padding:50px 60px 80px 110px;
    display:flex;flex-direction:column;gap:35px;
    transform:scale(.85) translateY(-20px) translateX(-38px);
    transform-origin:top center;
    margin:0 auto;
  }
  .tiger-header{display:flex;align-items:center;justify-content:space-between}
  .tiger-header h1{color:#ffcc00;font-size:2rem;margin:0}
  .stats-grid{
    display:grid;
    grid-template-columns:repeat(5,minmax(200px,1fr));
    gap:22px;margin-top:10px;
  }
  .stat-card{
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:14px;
    padding:26px 18px;
    text-align:center;
  }
  .stat-card h3{color:#fff;font-size:.95rem;margin:0 0 10px}
  .stat-card span{
    color:#ffd400;font-size:1.35rem;font-weight:700;
    text-shadow:0 0 6px rgba(255,210,0,.5)
  }
  .chart-block{
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:14px;padding:25px;
  }
  .chart-placeholder{
    height:190px;display:flex;align-items:center;justify-content:center;color:#777
  }
  table{width:100%;border-collapse:collapse;color:#fff}
</style>
