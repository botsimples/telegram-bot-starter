<style>
  html,body{
    margin:0;
    padding:0;
    height:100%;
    width:100%;
    overflow-x:hidden;
    overflow-y:auto;
    background:#0a0a0a;
    -webkit-font-smoothing:antialiased;
  }

  *{
    box-sizing:border-box;
    transform:translateZ(0);
    will-change:transform;
  }
  ::-webkit-scrollbar{display:none!important;}

  #bgParticles{
    position:fixed;
    inset:0;
    width:100vw;
    height:100vh;
    z-index:0;
    mix-blend-mode:screen;
    pointer-events:none;
    background-image:radial-gradient(rgba(255,255,255,0.03) 1px,transparent 1px);
    background-size:20px 20px;
  }

  main.offers-page{
    position:relative;
    z-index:1;
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:flex-start;
    padding-left:70px;
    padding-top:2vh; /* 🔼 subiu mais (antes era 5vh) */
  }

  .offers-container{
    text-align:center;
    width:80%;
    max-width:1000px;
    transform:scale(0.95);
    transform-origin:center top;
  }

  .offers-header h1{
    color:#ffcc00;
    font-size:2rem;
    margin-bottom:10px;
  }

  .offers-header p{
    color:#b4b4b4;
    margin-bottom:35px;
  }

  .offers-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:30px;
    justify-items:center;
  }

  .offer-card{
    width:250px;
    height:250px;
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:14px;
    padding:25px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    align-items:center;
    transition:.25s ease-out;
  }

  .offer-card:hover{
    background:rgba(255,204,0,0.07);
    box-shadow:0 0 15px rgba(255,204,0,0.25);
    transform:translateY(-3px);
  }

  .offer-card h3{
    color:#fff;
    margin:10px 0 5px;
  }

  .offer-card p{
    color:#b4b4b4;
    font-size:.9rem;
    min-height:45px;
  }

  .offer-btn{
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    color:#000;
    border:none;
    border-radius:8px;
    padding:8px 16px;
    font-weight:600;
    cursor:pointer;
    transition:filter .3s;
  }

  .offer-btn:hover{filter:brightness(1.15);}
</style>
