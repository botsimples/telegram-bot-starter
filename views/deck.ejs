<div class="deck-wrapper">
  <!-- Efeito dourado suave de fundo -->
  <div class="glow-gold"></div>

  <!-- Cabeçalho -->
  <div class="deck-header">
    <h1>Dashboard Geral</h1>
    <p>Visão geral das métricas do sistema TigerFy.</p>
  </div>

  <!-- Cards de métricas -->
  <div class="deck-cards">
    <div class="metric-card">
      <span class="metric-title">Total de Vendas</span>
      <span class="metric-value">R$ 0,00</span>
    </div>

    <div class="metric-card">
      <span class="metric-title">Vendas no Mês</span>
      <span class="metric-value">R$ 0,00</span>
    </div>

    <div class="metric-card">
      <span class="metric-title">Vendas no Dia</span>
      <span class="metric-value">R$ 0,00</span>
    </div>

    <div class="metric-card">
      <span class="metric-title">PIX Gerados</span>
      <span class="metric-value">0</span>
    </div>

    <div class="metric-card">
      <span class="metric-title">PIX Pagos</span>
      <span class="metric-value">0</span>
    </div>
  </div>

  <!-- Gráfico -->
  <div class="chart-box">
    <div class="chart-header">
      <h2>Histórico de Faturamento</h2>
      <span class="chart-filter">Últimos 7 dias</span>
    </div>
    <div class="chart-placeholder">[ gráfico em breve ]</div>
  </div>

  <!-- Tabela -->
  <div class="table-box">
    <h2>Pagamentos Recentes</h2>
    <table class="styled-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuário</th>
          <th>Valor</th>
          <th>Status</th>
          <th>Data</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>–</td>
          <td>–</td>
          <td>–</td>
          <td>–</td>
          <td>–</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
