<%- include('partials/visual_hottrack') %>

<main class="offers-page">
  <section class="offers-container">
    <header class="offers-header">
      <h1>Estatísticas Gerais</h1>
      <p>Visão geral de toda a plataforma TigerFy.</p>
    </header>

    <div class="offers-grid">
      <div class="offer-card">
        <h3>Total de Vendas</h3>
        <p>R$ 0,00</p>
        <button class="offer-btn">Ver Detalhes</button>
      </div>
      <div class="offer-card">
        <h3>Novos Leads</h3>
        <p>0</p>
        <button class="offer-btn">Verificar</button>
      </div>
      <div class="offer-card">
        <h3>ROI Médio</h3>
        <p>0%</p>
        <button class="offer-btn">Calcular</button>
      </div>
      <div class="offer-card">
        <h3>Campanhas Ativas</h3>
        <p>0</p>
        <button class="offer-btn">Gerenciar</button>
      </div>
    </div>
  </section>
</main>

<script>
  const c = document.createElement('canvas');
  c.id = 'bgParticles';
  document.body.appendChild(c);
  const ctx = c.getContext('2d', { alpha: true });
  let w, h, DPR = window.devicePixelRatio || 1;

  function resize() {
    w = innerWidth;
    h = innerHeight;
    c.width = w * DPR;
    c.height = h * DPR;
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  resize();
  addEventListener('resize', resize, { passive: true });

  const p = [];
  for (let i = 0; i < 25; i++) {
    p.push({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 1.2 + 0.4,
      dx: (Math.random() - 0.5) * 0.25,
      dy: (Math.random() - 0.5) * 0.25
    });
  }

  function draw() {
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = 'rgba(255,204,0,0.15)';
    for (const o of p) {
      ctx.beginPath();
      ctx.arc(o.x, o.y, o.r, 0, Math.PI * 2);
      ctx.fill();
      o.x += o.dx;
      o.y += o.dy;
      if (o.x < 0 || o.x > w) o.dx *= -1;
      if (o.y < 0 || o.y > h) o.dy *= -1;
    }
    requestAnimationFrame(draw);
  }
  draw();
</script>

main.offers-page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column; /* garante o alinhamento vertical correto */
  padding-left: 70px;
  padding-top: clamp(40px, 8vh, 90px); /* sobe suavemente em telas grandes e pequenas */
  padding-bottom: clamp(40px, 8vh, 90px);
}

.offers-container {
  text-align: center;
  width: min(90%, 1100px);
  margin-top: -2vh; /* sobe levemente o conjunto em relação ao centro */
}

.offers-header h1 {
  color: #ffcc00;
  font-size: clamp(1.8rem, 2.5vw, 2.2rem);
  margin-bottom: 10px;
}

.offers-header p {
  color: #b4b4b4;
  margin-bottom: clamp(30px, 5vh, 40px);
}

.offers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: clamp(20px, 3vw, 25px);
  justify-items: center;
}

/* Ajuste final de centralização vertical */
main.offers-page {
  transform: translateY(-35px);
}

