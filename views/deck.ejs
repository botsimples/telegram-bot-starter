<% title = "Dashboard - TigerFy"; %>

<main class="p-8 w-[80%] mx-auto animate-fadeIn">
  <h1 class="text-3xl font-semibold text-hot-primary mb-6">📊 Estatísticas Gerais</h1>
  <p class="text-neutral-400 mb-8">Visão geral de toda a plataforma TigerFy.</p>

  <!-- GRID DE CARDS -->
  <div class="grid grid-cols-5 gap-6 justify-center">
    <% const stats = [
      { label: 'Total de Vendas', value: 'R$ 0,00' },
      { label: 'Vendas no Ano', value: 'R$ 0,00' },
      { label: 'Vendas no Mês', value: 'R$ 0,00' },
      { label: 'Vendas no Dia', value: 'R$ 0,00' },
      { label: 'Total Usuários', value: '0' },
      { label: 'Usuários no Ano', value: '0' },
      { label: 'Conversões Ativas', value: '0' },
      { label: 'Taxa de Conversão', value: '0%' },
      { label: 'Ticket Médio', value: 'R$ 0,00' },
      { label: 'Lucro Estimado', value: 'R$ 0,00' }
    ]; %>

    <% stats.forEach(stat => { %>
      <div class="panel text-center py-6 px-4 border border-neutral-800 bg-neutral-950/30 backdrop-blur-md rounded-xl shadow-[0_0_25px_rgba(255,204,0,0.1)] transition-all hover:shadow-[0_0_40px_rgba(255,204,0,0.35)]">
        <h3 class="text-neutral-400 text-sm font-medium"><%= stat.label %></h3>
        <p class="text-2xl font-bold mt-1 text-[#FFD700] drop-shadow-[0_0_6px_rgba(255,215,0,0.8)]"><%= stat.value %></p>
      </div>
    <% }) %>
  </div>

  <!-- GRÁFICO -->
  <section class="mt-10 panel p-6 border border-neutral-800 rounded-xl bg-neutral-950/40 backdrop-blur-md">
    <div class="flex justify-between items-center mb-4">
      <h2 class="font-semibold text-lg text-hot-primary">📈 Usuários por Horário</h2>
      <div class="space-x-2">
        <button class="btn-yellow">Hoje</button>
        <button class="btn-outline">Ontem</button>
        <button class="btn-outline">Essa Semana</button>
        <button class="btn-outline">Esse Mês</button>
        <button class="btn-outline">Personalizado</button>
      </div>
    </div>
    <div class="h-64 flex items-center justify-center text-neutral-500 italic">[ gráfico em breve ]</div>
  </section>

  <!-- PAGAMENTOS -->
  <section class="mt-10 panel p-6 border border-neutral-800 rounded-xl bg-neutral-950/40 backdrop-blur-md">
    <h3 class="text-lg text-hot-primary mb-3">💰 Pagamentos Recentes</h3>
    <table class="min-w-full text-sm">
      <thead>
        <tr class="bg-neutral-900/70 text-left text-neutral-300">
          <th class="p-2">ID</th>
          <th class="p-2">Usuário</th>
          <th class="p-2">Valor</th>
          <th class="p-2">Status</th>
          <th class="p-2">Data</th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="5" class="p-4 text-center text-neutral-500 italic">Nenhum pagamento recente</td></tr>
      </tbody>
    </table>
  </section>
</main>

<style>
  .btn-yellow {
    background: #FFD700;
    color: #000;
    font-weight: 600;
    border-radius: 6px;
    padding: 5px 10px;
    transition: 0.2s;
  }
  .btn-yellow:hover {
    background: #ffcc00;
  }

  .btn-outline {
    border: 1px solid #FFD700;
    color: #FFD700;
    border-radius: 6px;
    padding: 5px 10px;
    transition: 0.2s;
  }
  .btn-outline:hover {
    background: #FFD70020;
  }

  /* Responsividade sem quebrar layout */
  @media (max-width: 1600px) {
    main { width: 85%; }
  }
  @media (max-width: 1400px) {
    main { width: 90%; }
    .grid-cols-5 { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 1100px) {
    .grid-cols-5 { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 800px) {
    .grid-cols-5 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .grid-cols-5 { grid-template-columns: 1fr; }
  }
</style>
