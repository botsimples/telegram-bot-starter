<%- include('layout', { title: title }) %>

<div class="p-8 w-full">
  <h1 class="text-2xl font-semibold text-blue-400 mb-6 flex items-center">
    <i class="fa-solid fa-chart-line mr-2"></i> Deck
  </h1>

  <!-- Cards principais -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="bg-gray-900 rounded-2xl p-6 shadow-md border border-gray-800">
      <p class="text-gray-400 text-sm">Cliques na Página</p>
      <h2 class="text-3xl font-bold text-blue-400 mt-1">0</h2>
    </div>
    <div class="bg-gray-900 rounded-2xl p-6 shadow-md border border-gray-800">
      <p class="text-gray-400 text-sm">PIX Gerados</p>
      <h2 class="text-3xl font-bold text-blue-400 mt-1">0</h2>
    </div>
    <div class="bg-gray-900 rounded-2xl p-6 shadow-md border border-gray-800">
      <p class="text-gray-400 text-sm">Faturamento Total</p>
      <h2 class="text-3xl font-bold text-green-400 mt-1">R$ 0,00</h2>
    </div>
    <div class="bg-gray-900 rounded-2xl p-6 shadow-md border border-gray-800">
      <p class="text-gray-400 text-sm">PIX Pagos</p>
      <h2 class="text-3xl font-bold text-green-400 mt-1">0</h2>
    </div>
  </div>

  <!-- Tabelas -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-gray-900 rounded-2xl p-6 shadow-md border border-gray-800">
      <h3 class="text-blue-400 text-lg font-semibold mb-3">Usuários Recentes</h3>
      <table class="w-full text-sm text-gray-300">
        <thead>
          <tr class="text-gray-400 text-left border-b border-gray-800">
            <th class="py-2">ID</th>
            <th>Nome</th>
            <th>Username</th>
            <th>Data</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="py-2 text-gray-400">–</td>
            <td>–</td>
            <td>–</td>
            <td>–</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="bg-gray-900 rounded-2xl p-6 shadow-md border border-gray-800">
      <h3 class="text-blue-400 text-lg font-semibold mb-3">Pagamentos Recentes</h3>
      <table class="w-full text-sm text-gray-300">
        <thead>
          <tr class="text-gray-400 text-left border-b border-gray-800">
            <th class="py-2">ID</th>
            <th>Usuário</th>
            <th>Valor</th>
            <th>Status</th>
            <th>Data</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="py-2 text-gray-400">–</td>
            <td>–</td>
            <td>–</td>
            <td>–</td>
            <td>–</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
