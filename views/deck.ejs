<div class="container fade-in">
  <div class="page-head">
    <div class="lhs">
      <h1>Estatísticas Gerais</h1>
      <p>Visão geral de toda a plataforma.</p>
    </div>
    <button class="btn-gold">Filtrar Ofertas</button>
  </div>

  <div class="deck-wrap">
    <!-- KPIs -->
    <div class="kpi-grid">
      <div class="kpi-card"><h4>Total de Vendas</h4><div class="val">R$ 0,00</div></div>
      <div class="kpi-card"><h4>Vendas no Ano</h4><div class="val">R$ 0,00</div></div>
      <div class="kpi-card"><h4>Vendas no Mês</h4><div class="val">R$ 0,00</div></div>
      <div class="kpi-card"><h4>Vendas no Dia</h4><div class="val">R$ 0,00</div></div>

      <div class="kpi-card"><h4>Total Usuários</h4><div class="val">0</div></div>
      <div class="kpi-card"><h4>Usuários no Ano</h4><div class="val">0</div></div>
      <div class="kpi-card"><h4>Usuários no Mês</h4><div class="val">0</div></div>
      <div class="kpi-card"><h4>Usuários no Dia</h4><div class="val">0</div></div>

      <div class="kpi-card"><h4>Conversões Ativas</h4><div class="val">0</div></div>
      <div class="kpi-card"><h4>Taxa de Conversão</h4><div class="val">0%</div></div>
      <div class="kpi-card"><h4>Ticket Médio</h4><div class="val">R$ 0,00</div></div>
      <div class="kpi-card"><h4>Lucro Estimado</h4><div class="val">R$ 0,00</div></div>
    </div>

    <!-- Gráfico -->
    <div class="chart-card">
      <div class="chart-head">
        <h3>Usuários por Horário</h3>
        <div class="tabset">
          <button class="active">Hoje</button>
          <button>Ontem</button>
          <button>Essa Semana</button>
          <button>Esse Mês</button>
          <button>Personalizado</button>
        </div>
      </div>
      <div class="chart-placeholder">[ gráfico em breve ]</div>
    </div>

    <!-- Tabela -->
    <div class="table-card">
      <h3>Pagamentos Recentes</h3>
      <table class="table">
        <thead>
          <tr>
            <th>ID</th><th>Usuário</th><th>Valor</th><th>Status</th><th>Data</th>
          </tr>
        </thead>
        <tbody>
          <tr><td colspan="5" style="text-align:center;color:#8a8a8a">Nenhum pagamento recente</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
