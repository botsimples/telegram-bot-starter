<% title = "Dashboard - TigerFy"; %>

<main style="width:80%;margin:0 auto;padding:60px 0;animation:fadeIn .6s ease;">
  <h1 style="font-size:32px;font-weight:600;color:#FFD700;margin-bottom:6px;">📊 Estatísticas Gerais</h1>
  <p style="color:#a5a5a5;margin-bottom:40px;">Visão geral de toda a plataforma TigerFy.</p>

  <!-- GRID DE MÉTRICAS -->
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:26px;justify-items:center;width:100%;">
    <% const stats = [
      { label: 'Total de Vendas', value: 'R$ 0,00' },
      { label: 'Vendas no Ano', value: 'R$ 0,00' },
      { label: 'Vendas no Mês', value: 'R$ 0,00' },
      { label: 'Vendas no Dia', value: 'R$ 0,00' },
      { label: 'Total Usuários', value: '0' },
      { label: 'Usuários no Ano', value: '0' },
      { label: 'Conversões Ativas', value: '0' },
      { label: 'Taxa de Conversão', value: '0%' },
      { label: 'Ticket Médio', value: 'R$ 0,00' },
      { label: 'Lucro Estimado', value: 'R$ 0,00' }
    ]; %>

    <% stats.forEach(stat => { %>
      <div style="
        text-align:center;
        padding:24px 10px;
        border:1px solid #202020;
        background:rgba(15,15,15,0.65);
        border-radius:14px;
        box-shadow:0 0 22px rgba(255,215,0,0.08);
        width:100%;
        transition:all .25s ease;
        backdrop-filter:blur(4px);
      " 
      onmouseover="this.style.boxShadow='0 0 38px rgba(255,215,0,0.25)'"
      onmouseout="this.style.boxShadow='0 0 22px rgba(255,215,0,0.08)'">
        <h3 style="color:#ccc;font-size:14px;font-weight:500;margin-bottom:5px;"><%= stat.label %></h3>
        <p style="color:#FFD700;font-size:22px;font-weight:700;text-shadow:0 0 6px rgba(255,215,0,0.85);"><%= stat.value %></p>
      </div>
    <% }) %>
  </div>

  <!-- BLOCO DE GRÁFICO -->
  <section style="
    margin-top:50px;
    padding:28px;
    border:1px solid #202020;
    background:rgba(15,15,15,0.6);
    border-radius:14px;
    backdrop-filter:blur(4px);
  ">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
      <h2 style="font-weight:600;color:#FFD700;font-size:18px;">📈 Usuários por Horário</h2>
      <div style="display:flex;gap:8px;">
        <button class="btn-gold">Hoje</button>
        <button class="btn-outline">Ontem</button>
        <button class="btn-outline">Essa Semana</button>
        <button class="btn-outline">Esse Mês</button>
        <button class="btn-outline">Personalizado</button>
      </div>
    </div>
    <div style="height:260px;display:flex;align-items:center;justify-content:center;color:#777;font-style:italic;">
      [ gráfico em breve ]
    </div>
  </section>

  <!-- BLOCO DE PAGAMENTOS -->
  <section style="
    margin-top:40px;
    padding:28px;
    border:1px solid #202020;
    background:rgba(15,15,15,0.6);
    border-radius:14px;
    backdrop-filter:blur(4px);
  ">
    <h3 style="color:#FFD700;font-size:18px;font-weight:600;margin-bottom:14px;">💰 Pagamentos Recentes</h3>
    <table style="width:100%;font-size:14px;border-collapse:collapse;">
      <thead>
        <tr style="background:rgba(25,25,25,0.9);color:#cfcfcf;text-align:left;">
          <th style="padding:8px;">ID</th>
          <th style="padding:8px;">Usuário</th>
          <th style="padding:8px;">Valor</th>
          <th style="padding:8px;">Status</th>
          <th style="padding:8px;">Data</th>
        </tr>
      </thead>
      <tbody>
        <tr><td colspan="5" style="padding:16px;text-align:center;color:#777;font-style:italic;">Nenhum pagamento recente</td></tr>
      </tbody>
    </table>
  </section>
</main>

<!-- ESTILO GLOBAL -->
<style>
  @keyframes fadeIn {
    from {opacity:0;transform:translateY(10px);}
    to {opacity:1;transform:translateY(0);}
  }
  .btn-gold {
    background:#FFD700;
    color:#000;
    font-weight:600;
    border:none;
    border-radius:6px;
    padding:6px 12px;
    cursor:pointer;
    transition:0.2s;
  }
  .btn-gold:hover { background:#ffcc00; }
  .btn-outline {
    border:1px solid #FFD700;
    color:#FFD700;
    background:none;
    border-radius:6px;
    padding:6px 12px;
    cursor:pointer;
    transition:0.2s;
  }
  .btn-outline:hover { background:rgba(255,215,0,0.15); }
  @media(max-width:1600px){ main{width:85%;} }
  @media(max-width:1400px){ main{width:90%;grid-template-columns:repeat(4,1fr);} }
  @media(max-width:1000px){ main{width:95%;grid-template-columns:repeat(3,1fr);} }
  @media(max-width:700px){ main{width:100%;grid-template-columns:repeat(2,1fr);} }
</style>
