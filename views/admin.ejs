<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel BotSimples</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #0f0f0f;
      color: #fff;
      text-align: center;
      margin: 0;
      padding: 40px;
    }
    h1 { color: #ffb347; }
    table { width: 80%; margin: 20px auto; border-collapse: collapse; }
    th, td { border: 1px solid #333; padding: 8px; }
    a, button { background: #ffb347; color: #000; border: none; padding: 8px 14px; margin: 4px; cursor: pointer; text-decoration: none; }
  </style>
</head>
<body>
  <h1>📊 Painel BotSimples</h1>
  <p>Mongo conectado e painel ativo!</p>

  <h2>Planos</h2>
  <table>
    <tr><th>Nome</th><th>Preço</th><th>Descrição</th><th>Ações</th></tr>
    <% plans.forEach(plan => { %>
      <tr>
        <td><%= plan.name %></td>
        <td>R$ <%= plan.price %></td>
        <td><%= plan.description %></td>
        <td>
          <form method="POST" action="/admin/plan/delete">
            <input type="hidden" name="id" value="<%= plan._id %>">
            <button>Excluir</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>

  <h2>Criar novo plano</h2>
  <form method="POST" action="/admin/plan/create">
    <input name="name" placeholder="Nome" required>
    <input name="price" placeholder="Preço" type="number" required>
    <input name="description" placeholder="Descrição" required>
    <button>Criar</button>
  </form>

  <p><a href="/logout">Sair</a></p>
</body>
</html>
