<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>🔥 Painel BotSimples</title>
  <link href="/css/output.css" rel="stylesheet" />
</head>

<body class="bg-neutral-900 text-slate-100 min-h-screen flex flex-col items-center px-4 py-10">
  <div class="panel w-full max-w-6xl p-8">
    <h1 class="text-3xl font-bold text-center text-blue-400 mb-8">⚙️ Painel BotSimples</h1>

    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-4 text-blue-300">💳 Planos</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead class="bg-neutral-800 text-blue-300">
            <tr>
              <th class="p-3 border border-neutral-700">Nome</th>
              <th class="p-3 border border-neutral-700">Preço</th>
              <th class="p-3 border border-neutral-700">Descrição</th>
              <th class="p-3 border border-neutral-700">Entregável</th>
              <th class="p-3 border border-neutral-700">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% (planos || []).forEach(plan => { %>
            <tr class="odd:bg-neutral-800 even:bg-neutral-900 hover:bg-neutral-700/40 transition">
              <td class="p-3 border border-neutral-700">
                <input type="text" id="name_<%= plan._id %>" value="<%= plan.name %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100">
              </td>
              <td class="p-3 border border-neutral-700">
                <input type="text" id="price_<%= plan._id %>" value="<%= plan.price %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100">
              </td>
              <td class="p-3 border border-neutral-700">
                <input type="text" id="desc_<%= plan._id %>" value="<%= plan.description %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100">
              </td>
              <td class="p-3 border border-neutral-700">
                <input type="text" id="deliverable_<%= plan._id %>" value="<%= plan.deliverable || '' %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100">
              </td>
              <td class="p-3 border border-neutral-700 text-center">
                <button onclick="salvarPlano('<%= plan._id %>')" class="btn bg-blue-500/30 hover:bg-blue-500/50">💾</button>
                <button onclick="excluirPlano('<%= plan._id %>')" class="btn bg-red-500/30 hover:bg-red-500/50 ml-2">🗑️</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="mt-8 text-center">
        <h3 class="text-lg mb-2 text-blue-300">Criar novo plano</h3>
        <div class="flex flex-wrap justify-center gap-2">
          <input id="novoNome" placeholder="Nome" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1">
          <input id="novoPreco" placeholder="Preço" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1">
          <input id="novoDesc" placeholder="Descrição" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1 w-48">
          <input id="novoDeliver" placeholder="Entregável (link ou texto)" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1 w-64">
          <button onclick="criarPlano()" class="btn bg-blue-500/30 hover:bg-blue-500/50">➕ Criar</button>
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-semibold mb-4 text-blue-300">🏦 Gateways de Pagamento</h2>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead class="bg-neutral-800 text-blue-300">
            <tr>
              <th class="p-3 border border-neutral-700">Nome</th>
              <th class="p-3 border border-neutral-700">Client ID</th>
              <th class="p-3 border border-neutral-700">Client Secret</th>
              <th class="p-3 border border-neutral-700">Token</th>
              <th class="p-3 border border-neutral-700">Ativo</th>
              <th class="p-3 border border-neutral-700">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% (gateways || []).forEach(gw => { %>
            <tr class="odd:bg-neutral-800 even:bg-neutral-900 hover:bg-neutral-700/40 transition">
              <td class="p-3 border border-neutral-700"><%= gw.name %></td>
              <td class="p-3 border border-neutral-700"><input id="id_<%= gw._id %>" value="<%= gw.clientId %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100"></td>
              <td class="p-3 border border-neutral-700"><input id="secret_<%= gw._id %>" value="<%= gw.clientSecret %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100"></td>
              <td class="p-3 border border-neutral-700"><input id="token_<%= gw._id %>" value="<%= gw.token || '' %>" class="w-full bg-neutral-800 border border-neutral-600 rounded px-2 py-1 text-slate-100"></td>
              <td class="p-3 border border-neutral-700 text-center"><%= gw.active ? '🟢' : '🔴' %></td>
              <td class="p-3 border border-neutral-700 text-center">
                <button onclick="salvarGateway('<%= gw._id %>')" class="btn bg-blue-500/30 hover:bg-blue-500/50">💾</button>
                <button onclick="ativarGateway('<%= gw._id %>')" class="btn bg-green-500/30 hover:bg-green-500/50 ml-2">⚡</button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="mt-8 text-center">
        <h3 class="text-lg mb-2 text-blue-300">Criar novo Gateway</h3>
        <div class="flex flex-wrap justify-center gap-2">
          <input id="novoGatewayNome" placeholder="Nome" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1">
          <input id="novoGatewayClientId" placeholder="Client ID" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1">
          <input id="novoGatewaySecret" placeholder="Client Secret" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1">
          <input id="novoGatewayToken" placeholder="Token (opcional)" class="bg-neutral-800 border border-neutral-600 rounded px-2 py-1 w-48">
          <button onclick="criarGateway()" class="btn bg-blue-500/30 hover:bg-blue-500/50">➕ Criar</button>
        </div>
      </div>
    </section>
  </div>

  <footer class="text-sm mt-8 text-neutral-500">
    © 2025 BotSimples — Estilo HotTrack 🔥
  </footer>

  <script>
    async function criarPlano() {
      const body = {
        name: novoNome.value,
        price: novoPreco.value,
        description: novoDesc.value,
        deliverable: novoDeliver.value
      };
      await fetch('/admin/planos', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      location.reload();
    }

    async function salvarPlano(id) {
      const body = {
        name: document.getElementById(`name_${id}`).value,
        price: document.getElementById(`price_${id}`).value,
        description: document.getElementById(`desc_${id}`).value,
        deliverable: document.getElementById(`deliverable_${id}`).value
      };
      await fetch('/admin/planos/' + id, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
    }

    async function excluirPlano(id) {
      await fetch('/admin/planos/' + id, { method: 'DELETE' });
      document.getElementById(`row_${id}`).remove();
    }

    async function criarGateway() {
      const body = {
        name: novoGatewayNome.value,
        clientId: novoGatewayClientId.value,
        clientSecret: novoGatewaySecret.value,
        token: novoGatewayToken.value
      };
      await fetch('/admin/gateways', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      location.reload();
    }

    async function salvarGateway(id) {
      const body = {
        clientId: document.getElementById(`id_${id}`).value,
        clientSecret: document.getElementById(`secret_${id}`).value,
        token: document.getElementById(`token_${id}`).value
      };
      await fetch('/admin/gateways/' + id, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
    }

    async function ativarGateway(id) {
      await fetch('/admin/gateways/ativar/' + id, { method: 'POST' });
      location.reload();
    }
  </script>
</body>
</html>
