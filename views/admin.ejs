<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>Painel BotSimples</title>
  <style>
    body {
      background-color: #111;
      color: #f5f5f5;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    h1, h2 { text-align: center; color: #ffb400; }
    table {
      width: 90%;
      margin: 20px auto;
      border-collapse: collapse;
      background-color: #1a1a1a;
      border-radius: 12px;
      overflow: hidden;
    }
    th, td {
      border: 1px solid #333;
      padding: 10px;
      text-align: center;
    }
    input {
      padding: 6px;
      border: none;
      border-radius: 5px;
      background-color: #222;
      color: #fff;
      text-align: center;
    }
    button {
      padding: 6px 10px;
      border: none;
      border-radius: 6px;
      background-color: #ffb400;
      color: #000;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover { background-color: #ffcc33; }
    hr { margin: 40px auto; width: 80%; border-color: #333; }

    /* Feedback visual */
    #toast {
      position: fixed;
      top: 30px;
      right: 30px;
      background-color: #1a1a1a;
      color: #fff;
      padding: 15px 20px;
      border-radius: 10px;
      border-left: 6px solid #ffb400;
      opacity: 0;
      transform: translateY(-20px);
      transition: all 0.3s ease;
      box-shadow: 0 0 10px #000;
      z-index: 9999;
    }
    #toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .loader {
      border: 4px solid #222;
      border-top: 4px solid #ffb400;
      border-radius: 50%;
      width: 18px;
      height: 18px;
      animation: spin 0.8s linear infinite;
      display: inline-block;
      margin-left: 8px;
      vertical-align: middle;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>

<body>
  <h1>⚙️ Painel BotSimples</h1>

  <div id="toast"></div>

  <h2>💳 Planos</h2>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Descrição</th>
        <th>Entregável</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody id="planos">
      <% (planos || []).forEach(plan => { %>
      <tr id="row_<%= plan._id %>">
        <td><input type="text" id="name_<%= plan._id %>" value="<%= plan.name %>"></td>
        <td><input type="text" id="price_<%= plan._id %>" value="<%= plan.price %>"></td>
        <td><input type="text" id="desc_<%= plan._id %>" value="<%= plan.description %>"></td>
        <td><input type="text" id="deliverable_<%= plan._id %>" value="<%= plan.deliverable || '' %>"></td>
        <td>
          <button onclick="salvarPlano('<%= plan._id %>')">Salvar</button>
          <button onclick="excluirPlano('<%= plan._id %>')">Excluir</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="text-align:center;">
    <h3>Criar novo plano</h3>
    <input id="novoNome" placeholder="Nome" />
    <input id="novoPreco" placeholder="Preço" />
    <input id="novoDesc" placeholder="Descrição" />
    <input id="novoDeliver" placeholder="Entregável (link ou texto)" />
    <button onclick="criarPlano()">Criar</button>
  </div>

  <hr />

  <h2>🏦 Gateways de Pagamento</h2>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Client ID</th>
        <th>Client Secret</th>
        <th>Token</th>
        <th>Ativo</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody id="gateways">
      <% (gateways || []).forEach(gw => { %>
      <tr id="gw_<%= gw._id %>">
        <td><%= gw.name %></td>
        <td><input id="id_<%= gw._id %>" value="<%= gw.clientId %>" /></td>
        <td><input id="secret_<%= gw._id %>" value="<%= gw.clientSecret %>" /></td>
        <td><input id="token_<%= gw._id %>" value="<%= gw.token || '' %>" /></td>
        <td><%= gw.active ? '🟢' : '🔴' %></td>
        <td>
          <button onclick="salvarGateway('<%= gw._id %>')">Salvar</button>
          <button onclick="ativarGateway('<%= gw._id %>')">Ativar</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="text-align:center;">
    <h3>Criar novo Gateway</h3>
    <input id="novoGatewayNome" placeholder="Nome (ex: WiinPay)" />
    <input id="novoGatewayClientId" placeholder="Client ID" />
    <input id="novoGatewaySecret" placeholder="Client Secret" />
    <input id="novoGatewayToken" placeholder="Token (opcional)" />
    <button onclick="criarGateway()">Criar</button>
  </div>

  <script>
    const showToast = (msg, ok = true) => {
      const toast = document.getElementById("toast");
      toast.textContent = msg;
      toast.style.borderLeftColor = ok ? "#ffb400" : "#ff5555";
      toast.classList.add("show");
      setTimeout(() => toast.classList.remove("show"), 2500);
    };

    const showLoader = (btn) => {
      const loader = document.createElement("span");
      loader.classList.add("loader");
      btn.appendChild(loader);
      return loader;
    };

    async function criarPlano() {
      const name = novoNome.value, price = novoPreco.value, description = novoDesc.value, deliverable = novoDeliver.value;
      const btn = event.target, loader = showLoader(btn);
      try {
        const res = await fetch('/admin/planos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, price, description, deliverable })
        });
        loader.remove();
        if (res.ok) {
          showToast("✅ Plano criado com sucesso!");
          setTimeout(() => location.reload(), 1000);
        } else showToast("❌ Erro ao criar plano", false);
      } catch {
        loader.remove();
        showToast("❌ Erro de conexão", false);
      }
    }

    async function salvarPlano(id) {
      const name = document.getElementById(`name_${id}`).value;
      const price = document.getElementById(`price_${id}`).value;
      const description = document.getElementById(`desc_${id}`).value;
      const deliverable = document.getElementById(`deliverable_${id}`).value;
      const btn = event.target, loader = showLoader(btn);
      try {
        const res = await fetch('/admin/planos/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, price, description, deliverable })
        });
        loader.remove();
        if (res.ok) showToast("✅ Plano atualizado!");
        else showToast("❌ Erro ao salvar plano", false);
      } catch {
        loader.remove();
        showToast("❌ Erro de conexão", false);
      }
    }

    async function excluirPlano(id) {
      if (!confirm("Tem certeza que deseja excluir este plano?")) return;
      const res = await fetch('/admin/planos/' + id, { method: 'DELETE' });
      if (res.ok) {
        showToast("🗑️ Plano excluído");
        document.getElementById(`row_${id}`).remove();
      }
    }

    async function criarGateway() {
      const name = novoGatewayNome.value, clientId = novoGatewayClientId.value, clientSecret = novoGatewaySecret.value, token = novoGatewayToken.value;
      const res = await fetch('/admin/gateways', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, clientId, clientSecret, token })
      });
      if (res.ok) {
        showToast("✅ Gateway criado!");
        setTimeout(() => location.reload(), 1000);
      }
    }

    async function salvarGateway(id) {
      const clientId = document.getElementById(`id_${id}`).value;
      const clientSecret = document.getElementById(`secret_${id}`).value;
      const token = document.getElementById(`token_${id}`).value;
      const res = await fetch('/admin/gateways/' + id, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ clientId, clientSecret, token })
      });
      if (res.ok) showToast("✅ Gateway atualizado!");
      else showToast("❌ Erro ao atualizar gateway", false);
    }

    async function ativarGateway(id) {
      const res = await fetch('/admin/gateways/ativar/' + id, { method: 'POST' });
      if (res.ok) {
        showToast("✅ Gateway ativado!");
        setTimeout(() => location.reload(), 800);
      }
    }
  </script>
</body>
</html>
