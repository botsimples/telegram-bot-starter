<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Painel BotSimples</title>
    <style>
      body {
        background-color: #111;
        color: #f5f5f5;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
      }
      h1, h2 {
        text-align: center;
        color: #ffb400;
      }
      table {
        width: 90%;
        margin: 20px auto;
        border-collapse: collapse;
        background-color: #1a1a1a;
        border-radius: 12px;
        overflow: hidden;
      }
      th, td {
        border: 1px solid #333;
        padding: 10px;
        text-align: center;
      }
      input {
        padding: 6px;
        border: none;
        border-radius: 5px;
        text-align: center;
        background-color: #222;
        color: #fff;
      }
      button {
        padding: 6px 10px;
        border: none;
        border-radius: 6px;
        background-color: #ffb400;
        color: #000;
        cursor: pointer;
        font-weight: bold;
      }
      button:hover {
        background-color: #ffcc33;
      }
      hr {
        margin: 40px auto;
        width: 80%;
        border-color: #333;
      }
    </style>
  </head>

  <body>
    <h1>⚙️ Painel BotSimples</h1>

    <h2>💳 Planos</h2>
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Preço</th>
          <th>Descrição</th>
          <th>Entregável</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody id="planos">
        <% (planos || []).forEach(plan => { %>
        <tr>
          <td><input type="text" id="name_<%= plan._id %>" value="<%= plan.name %>"></td>
          <td><input type="text" id="price_<%= plan._id %>" value="<%= plan.price %>"></td>
          <td><input type="text" id="desc_<%= plan._id %>" value="<%= plan.description %>"></td>
          <td><input type="text" id="deliver_<%= plan._id %>" value="<%= plan.deliverable || '' %>" placeholder="Link ou mensagem de entrega"></td>
          <td>
            <button onclick="salvarPlano('<%= plan._id %>')">Salvar</button>
            <button onclick="excluirPlano('<%= plan._id %>')">Excluir</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <div style="text-align:center;">
      <h3>Criar novo plano</h3>
      <input id="novoNome" placeholder="Nome" />
      <input id="novoPreco" placeholder="Preço" />
      <input id="novoDesc" placeholder="Descrição" />
      <input id="novoEntregavel" placeholder="Link ou mensagem de entrega" />
      <button onclick="criarPlano()">Criar</button>
    </div>

    <script>
      async function criarPlano() {
        const name = document.getElementById('novoNome').value;
        const price = document.getElementById('novoPreco').value;
        const description = document.getElementById('novoDesc').value;
        const deliverable = document.getElementById('novoEntregavel').value;
        await fetch('/admin/planos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, price, description, deliverable })
        });
        location.reload();
      }

      async function salvarPlano(id) {
        const name = document.getElementById('name_' + id).value;
        const price = document.getElementById('price_' + id).value;
        const description = document.getElementById('desc_' + id).value;
        const deliverable = document.getElementById('deliver_' + id).value;
        await fetch('/admin/planos/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, price, description, deliverable })
        });
        location.reload();
      }

      async function excluirPlano(id) {
        await fetch('/admin/planos/' + id, { method: 'DELETE' });
        location.reload();
      }
    </script>
  </body>
</html>
