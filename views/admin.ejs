<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <title>Painel BotSimples</title>
  <style>
    body {
      background-color: #111;
      color: #f5f5f5;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    h1, h2 { text-align: center; color: #ffb400; }
    table {
      width: 90%;
      margin: 20px auto;
      border-collapse: collapse;
      background-color: #1a1a1a;
      border-radius: 12px;
      overflow: hidden;
    }
    th, td {
      border: 1px solid #333;
      padding: 10px;
      text-align: center;
    }
    input {
      padding: 6px;
      border: none;
      border-radius: 5px;
      background-color: #222;
      color: #fff;
      text-align: center;
    }
    button {
      padding: 6px 10px;
      border: none;
      border-radius: 6px;
      background-color: #ffb400;
      color: #000;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover { background-color: #ffcc33; }
    hr { margin: 40px auto; width: 80%; border-color: #333; }
  </style>
</head>

<body>
  <h1>⚙️ Painel BotSimples</h1>

  <h2>💳 Planos</h2>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Descrição</th>
        <th>Entregável</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody id="planos">
      <% (planos || []).forEach(plan => { %>
      <tr>
        <td><input type="text" id="name_<%= plan._id %>" value="<%= plan.name %>"></td>
        <td><input type="text" id="price_<%= plan._id %>" value="<%= plan.price %>"></td>
        <td><input type="text" id="desc_<%= plan._id %>" value="<%= plan.description %>"></td>
        <td><input type="text" id="deliverable_<%= plan._id %>" value="<%= plan.deliverable || '' %>"></td>
        <td>
          <button onclick="salvarPlano('<%= plan._id %>')">Salvar</button>
          <button onclick="excluirPlano('<%= plan._id %>')">Excluir</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="text-align:center;">
    <h3>Criar novo plano</h3>
    <input id="novoNome" placeholder="Nome" />
    <input id="novoPreco" placeholder="Preço" />
    <input id="novoDesc" placeholder="Descrição" />
    <input id="novoDeliver" placeholder="Entregável (link ou texto)" />
    <button onclick="criarPlano()">Criar</button>
  </div>

  <hr />

  <h2>🏦 Gateways de Pagamento</h2>
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Client ID</th>
        <th>Client Secret</th>
        <th>Token</th>
        <th>Ativo</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody id="gateways">
      <% (gateways || []).forEach(gw => { %>
      <tr>
        <td><%= gw.name %></td>
        <td><input id="id_<%= gw._id %>" value="<%= gw.clientId %>" /></td>
        <td><input id="secret_<%= gw._id %>" value="<%= gw.clientSecret %>" /></td>
        <td><input id="token_<%= gw._id %>" value="<%= gw.token || '' %>" /></td>
        <td><%= gw.active ? '🟢' : '🔴' %></td>
        <td>
          <button onclick="salvarGateway('<%= gw._id %>')">Salvar</button>
          <button onclick="ativarGateway('<%= gw._id %>')">Ativar</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="text-align:center;">
    <h3>Criar novo Gateway</h3>
    <input id="novoGatewayNome" placeholder="Nome (ex: WiinPay)" />
    <input id="novoGatewayClientId" placeholder="Client ID" />
    <input id="novoGatewaySecret" placeholder="Client Secret" />
    <input id="novoGatewayToken" placeholder="Token (opcional)" />
    <button onclick="criarGateway()">Criar</button>
  </div>

  <script>
    async function criarPlano() {
      const name = novoNome.value, price = novoPreco.value, description = novoDesc.value, deliverable = novoDeliver.value;
      await fetch('/admin/planos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, price, description, deliverable }) });
      location.reload();
    }

    async function salvarPlano(id) {
      const name = name_[id].value, price = price_[id].value, description = desc_[id].value, deliverable = deliverable_[id].value;
      await fetch('/admin/planos/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, price, description, deliverable }) });
      location.reload();
    }

    async function excluirPlano(id) {
      await fetch('/admin/planos/' + id, { method: 'DELETE' });
      location.reload();
    }

    async function criarGateway() {
      const name = novoGatewayNome.value, clientId = novoGatewayClientId.value, clientSecret = novoGatewaySecret.value, token = novoGatewayToken.value;
      await fetch('/admin/gateways', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, clientId, clientSecret, token }) });
      location.reload();
    }

    async function salvarGateway(id) {
      const clientId = id_[id].value, clientSecret = secret_[id].value, token = token_[id].value;
      await fetch('/admin/gateways/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clientId, clientSecret, token }) });
      location.reload();
    }

    async function ativarGateway(id) {
      await fetch('/admin/gateways/ativar/' + id, { method: 'POST' });
      location.reload();
    }
  </script>
</body>
</html>
