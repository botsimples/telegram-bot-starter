        </div>
      </div>
      <button class="btn-disabled">Em breve</button>
    </div>
  </div>
</main>

<!-- MODAL -->
<div id="gatewayModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span class="close" onclick="closeGatewayModal()">&times;</span>
    <h2 id="gatewayTitle">Integração</h2>
    <form>
      <label>Token API (obrigatório)</label>
      <input type="text" placeholder="Insira o Token API">
      <label>Client ID (opcional)</label>
      <input type="text" placeholder="Insira o Client ID">
      <label>Client Secret (opcional)</label>
      <input type="text" placeholder="Insira o Client Secret">
      <button class="btn-save">Salvar Integração</button>
    </form>
  </div>
</div>

<script>
function openGatewayModal(name){
  document.getElementById('gatewayTitle').innerText="Integração • "+name;
  document.getElementById('gatewayModal').style.display='flex';
}
function closeGatewayModal(){
  document.getElementById('gatewayModal').style.display='none';
}
function activateGateway(gateway,checkbox){
  document.querySelectorAll('.switch input').forEach(s=>{if(s!==checkbox)s.checked=false;});
  document.querySelectorAll('.gateway-card').forEach(card=>{
    card.classList.remove('active');
    if(card.dataset.gateway===gateway && checkbox.checked)card.classList.add('active');
  });
}
</script>

<style>
html,body{
  margin:0;padding:0;background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;
}
.api-header{width:85%;max-width:1200px;margin:40px auto 20px;}
.api-header h1{color:#ffcc00;margin-bottom:8px;}
.api-header p{color:#b4b4b4;}
.gateway-container{
  width:85%;max-width:1200px;margin:0 auto;
  display:flex;flex-direction:column;gap:16px;
}
.gateway-card{
  display:flex;justify-content:space-between;align-items:center;
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.08);
  border-radius:12px;padding:16px 24px;
  backdrop-filter:blur(12px);
  transition:all .3s ease;
}
.gateway-card:hover{
  background:rgba(255,255,255,0.06);
  transform:translateY(-2px);
}
.gateway-card.active{
  border:1px solid #ffcc00;
  box-shadow:0 0 20px rgba(255,204,0,0.35);
  animation:pulse 2s infinite ease-in-out;
}
@keyframes pulse{
  0%,100%{box-shadow:0 0 12px rgba(255,204,0,0.25);}
  50%{box-shadow:0 0 24px rgba(255,204,0,0.5);}
}
.gateway-left{display:flex;align-items:center;gap:16px;}
.gateway-logo{width:44px;height:44px;border-radius:8px;background:#111;padding:4px;}
.gateway-info h3{margin:0;color:#fff;font-size:1rem;font-weight:600;}
.gateway-info p{margin:4px 0 0;color:#b4b4b4;font-size:.88rem;}
.badge{
  background:linear-gradient(90deg,#ffcc00,#d4a100);
  color:#000;font-size:.7rem;font-weight:700;padding:2px 6px;
  border-radius:6px;margin-left:4px;
}
.gateway-right{display:flex;align-items:center;gap:12px;}
.btn-integrar{
  background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.1);
  color:#fff;border-radius:10px;padding:8px 18px;
  cursor:pointer;font-weight:600;transition:all .3s;
}
.btn-integrar:hover{background:rgba(255,255,255,0.12);}
.btn-disabled{
  background:rgba(255,255,255,0.04);color:#999;border:none;border-radius:8px;
  padding:8px 18px;
}
.switch{position:relative;display:inline-block;width:38px;height:20px;}
.switch input{opacity:0;width:0;height:0;}
.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;
  background:rgba(255,255,255,0.1);transition:.4s;border-radius:34px;}
.slider:before{position:absolute;content:"";height:14px;width:14px;left:3px;bottom:3px;background-color:#999;transition:.4s;border-radius:50%;}
input:checked + .slider{background:linear-gradient(90deg,#ffcc00,#d4a100);}
input:checked + .slider:before{transform:translateX(18px);background:#000;}
.modal-overlay{
  position:fixed;top:0;left:0;width:100%;height:100%;
  background:rgba(0,0,0,0.6);display:flex;align-items:center;justify-content:center;
  backdrop-filter:blur(8px);z-index:1000;
}
.modal-content{
  background:rgba(20,20,20,0.9);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:16px;padding:35px 40px;width:95%;max-width:460px;
}
.close{position:absolute;top:10px;right:18px;font-size:1.8rem;cursor:pointer;color:#ffcc00;}
form label{display:block;color:#ffcc00;margin-top:10px;font-size:.9rem;}
form input{
  width:100%;padding:10px;margin-top:5px;border-radius:8px;
  border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.04);
  color:#fff;
}
.btn-save{
  margin-top:20px;width:100%;
  background:linear-gradient(90deg,#ffcc00,#d4a100);
  color:#000;font-weight:700;border:none;border-radius:10px;
  padding:12px;cursor:pointer;transition:filter .3s;
}
.btn-save:hover{filter:brightness(1.1);}
</style>
