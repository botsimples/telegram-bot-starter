      <h3>OasyFy</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('OasyFy')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('OasyFy', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="api-card" data-gateway="PushinPay">
      <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" class="api-logo">
      <h3>PushinPay</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('PushinPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('PushinPay', this)">
