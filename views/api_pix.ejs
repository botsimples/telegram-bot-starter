<%- include('partials/visual_hottrack') %>

<main class="api-pix-page">
  <header class="api-header">
    <h1>API PIX</h1>
    <p>Integre gateways de pagamento ao TigerFy com facilidade e estilo.</p>
  </header>

  <div class="api-list">
    <!-- WIINPAY -->
    <div class="gateway-card top1" data-gateway="WiinPay">
      <div class="gateway-info">
        <img src="https://i.ibb.co/VNDsN1T/wiinpay.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>WiinPay <span class="tag">🔥 TOP 1</span></h3>
          <p>Integração oficial com suporte total ao PIX e automações.</p>
        </div>
      </div>
      <div class="gateway-actions">
        <button class="btn-glass" onclick="openGatewayModal('WiinPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('WiinPay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <!-- OUTROS GATEWAYS -->
    <div class="gateway-card" data-gateway="ParadisePag">
      <div class="gateway-info">
        <img src="https://i.ibb.co/TLvgdVJ/paradisepag.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>ParadisePag</h3>
          <p>Gateway confiável e rápido, ideal para campanhas diretas.</p>
        </div>
      </div>
      <div class="gateway-actions">
        <button class="btn-glass" onclick="openGatewayModal('ParadisePag')">Integrar</button>
        <label class="switch"><input type="checkbox" onchange="activateGateway('ParadisePag', this)"><span class="slider"></span></label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="OasyFy">
      <div class="gateway-info">
        <img src="https://i.ibb.co/MpZ3c8m/oasyfy.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>OasyFy</h3>
          <p>Integração simples e estável com suporte a QR Code dinâmico.</p>
        </div>
      </div>
      <div class="gateway-actions">
        <button class="btn-glass" onclick="openGatewayModal('OasyFy')">Integrar</button>
        <label class="switch"><input type="checkbox" onchange="activateGateway('OasyFy', this)"><span class="slider"></span></label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="PushinPay">
      <div class="gateway-info">
        <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>PushinPay</h3>
          <p>Provedor flexível para automação de cobranças e bots.</p>
        </div>
      </div>
      <div class="gateway-actions">
        <button class="btn-glass" onclick="openGatewayModal('PushinPay')">Integrar</button>
        <label class="switch"><input type="checkbox" onchange="activateGateway('PushinPay', this)"><span class="slider"></span></label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="SyncPay">
      <div class="gateway-info">
        <img src="https://i.ibb.co/Wkmpmfn/syncpay.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>SyncPay</h3>
          <p>Integração rápida para vendas automáticas via PIX.</p>
        </div>
      </div>
      <div class="gateway-actions">
        <button class="btn-glass" onclick="openGatewayModal('SyncPay')">Integrar</button>
        <label class="switch"><input type="checkbox" onchange="activateGateway('SyncPay', this)"><span class="slider"></span></label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="Hoopay">
      <div class="gateway-info">
        <img src="https://i.ibb.co/jvYkkwm/hoopay.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>Hoopay</h3>
          <p>Pagamentos inteligentes com acompanhamento em tempo real.</p>
        </div>
      </div>
      <div class="gateway-actions">
        <button class="btn-glass" onclick="openGatewayModal('Hoopay')">Integrar</button>
        <label class="switch"><input type="checkbox" onchange="activateGateway('Hoopay', this)"><span class="slider"></span></label>
      </div>
    </div>

    <div class="gateway-card soon" data-gateway="ZeroOnePay">
      <div class="gateway-info">
        <img src="https://i.ibb.co/xXW6yVy/zeroone.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>ZeroOnePay <span class="soon-tag">Em breve</span></h3>
        </div>
      </div>
      <button class="btn-disabled">Em breve</button>
    </div>

    <div class="gateway-card soon" data-gateway="HorsePay">
      <div class="gateway-info">
        <img src="https://i.ibb.co/x1bfG8L/horsepay.png" class="gateway-logo">
        <div class="gateway-text">
          <h3>HorsePay <span class="soon-tag">Em breve</span></h3>
        </div>
      </div>
      <button class="btn-disabled">Em breve</button>
    </div>
  </div>
</main>

<!-- MODAL -->
<div id="gatewayModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span class="close" onclick="closeGatewayModal()">&times;</span>
    <h2 id="gatewayTitle">Integração</h2>
    <form id="gatewayForm">
      <label>Token API (obrigatório)</label>
      <input type="text" id="tokenApi" required>
      <label>Client ID (opcional)</label>
      <input type="text" id="clientId">
      <label>Client Secret (opcional)</label>
      <input type="text" id="clientSecret">
      <button type="submit" class="btn-save">Salvar Integração</button>
    </form>
  </div>
</div>

<script>
function openGatewayModal(name){
  document.getElementById('gatewayTitle').innerText="Integração • "+name;
  document.getElementById('gatewayModal').style.display='flex';
}
function closeGatewayModal(){
  document.getElementById('gatewayModal').style.display='none';
}
function activateGateway(gateway,checkbox){
  document.querySelectorAll('.switch input').forEach(s=>{if(s!==checkbox)s.checked=false;});
  document.querySelectorAll('.gateway-card').forEach(card=>{
    card.classList.remove('active');
    if(card.dataset.gateway===gateway && checkbox.checked)card.classList.add('active');
  });
}
</script>

<style>
html,body{margin:0;padding:0;background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;}
*{box-sizing:border-box;}::-webkit-scrollbar{display:none;}
.api-header{width:85%;max-width:1200px;margin:40px auto 20px;}
.api-header h1{color:#ffcc00;margin-bottom:8px;}
.api-header p{color:#b4b4b4;}
.api-list{width:85%;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:20px;}

.gateway-card{
  background:linear-gradient(145deg,rgba(255,255,255,0.05),rgba(0,0,0,0.5));
  border:1px solid rgba(255,255,255,0.08);
  border-radius:14px;padding:22px 30px;
  display:flex;align-items:center;justify-content:space-between;
  transition:all .3s ease;backdrop-filter:blur(10px);
}
.gateway-card:hover{background:rgba(255,255,255,0.08);transform:translateY(-2px);}
.gateway-card.active{box-shadow:0 0 20px rgba(255,204,0,0.4);border-color:#ffcc00;}
.gateway-info{display:flex;align-items:center;gap:18px;}
.gateway-logo{width:52px;height:52px;object-fit:contain;border-radius:8px;background:#111;padding:4px;}
.gateway-text h3{margin:0;color:#fff;font-size:1.1rem;}
.gateway-text p{margin:5px 0 0;color:#aaa;font-size:.9rem;}
.tag{background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;font-weight:700;padding:3px 8px;border-radius:6px;font-size:.7rem;}
.soon-tag{color:#999;font-size:.8rem;}
.gateway-actions{display:flex;align-items:center;gap:12px;}
.btn-glass{
  background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);
  color:#fff;padding:9px 18px;border-radius:10px;font-weight:600;
  cursor:pointer;transition:all .3s ease;backdrop-filter:blur(10px);
}
.btn-glass:hover{background:rgba(255,255,255,0.14);}
.btn-disabled{background:rgba(255,255,255,0.04);color:#777;border:none;padding:9px 18px;border-radius:10px;}
.switch{position:relative;display:inline-block;width:42px;height:22px;}
.switch input{opacity:0;width:0;height:0;}
.slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;
  background:rgba(255,255,255,0.1);transition:.4s;border-radius:34px;}
.slider:before{position:absolute;content:"";height:16px;width:16px;left:3px;bottom:3px;background-color:#999;transition:.4s;border-radius:50%;}
input:checked + .slider{background:linear-gradient(90deg,#ffcc00,#d4a100);}
input:checked + .slider:before{transform:translateX(20px);background:#000;}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:1000;}
.modal-content{background:rgba(20,20,20,0.9);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:35px 40px;width:95%;max-width:460px;position:relative;}
.close{position:absolute;top:10px;right:18px;font-size:1.8rem;cursor:pointer;color:#ffcc00;}
form label{display:block;color:#ffcc00;margin-top:10px;font-size:.9rem;}
form input{width:100%;padding:10px;margin-top:5px;border-radius:8px;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.04);color:#fff;}
.btn-save{margin-top:20px;width:100%;background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;font-weight:700;border:none;border-radius:10px;padding:12px;cursor:pointer;}
</style>
