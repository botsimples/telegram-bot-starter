<%- include('partials/visual_hottrack') %>

<main class="api-pix-page">
  <header class="api-header">
    <h1>API PIX</h1>
    <p>Integre gateways de pagamento ao TigerFy com facilidade.</p>
  </header>

  <div class="api-grid" id="gatewayGrid">

    <!-- WIINPAY -->
