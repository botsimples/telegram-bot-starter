<% title = "Adquirentes - BotSimples"; %>

<main class="p-8 w-full max-w-5xl mx-auto animate-fadeIn">
  <h1 class="text-3xl font-semibold text-hot-primary mb-6">🏦 Adquirentes</h1>

  <div class="panel p-5">
    <p class="text-neutral-300">
      Aqui você poderá configurar suas conexões de gateway (ex: WiinPay, Asaas, Paggue...).
    </p>

    <div class="mt-6 border-t border-neutral-800 pt-6">
      <h3 class="text-lg mb-2">Adicionar novo adquirente</h3>
      <div class="grid md:grid-cols-3 gap-3">
        <input class="input" placeholder="Nome (ex: WiinPay)">
        <input class="input" placeholder="Client ID">
        <input class="input" placeholder="Client Secret">
      </div>
      <button class="btn mt-4">Salvar</button>
    </div>
  </div>
</main>
