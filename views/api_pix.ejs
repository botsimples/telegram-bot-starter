<main class="api-pix">
  <header>
    <h1>Integrações de Gateways</h1>
    <p>Escolha, ative e gerencie seus gateways de pagamento via API PIX.</p>
  </header>

  <section class="gateway-grid">
    <% const gateways = [
      { nome: 'WiinPay', link: 'https://v2.wiinpay.com.br', taxa: '1,89%', ativo: true, temToken: true, top: true },
      { nome: 'ParadisePag', link: '#', taxa: '2,10%', ativo: false },
      { nome: 'OasyFy', link: '#', taxa: '1,97%', ativo: false },
      { nome: 'PushinPay', link: '#', taxa: '1,95%', ativo: false },
      { nome: 'SyncPay', link: '#', taxa: '1,75%', ativo: false },
      { nome: 'Hoopay', link: '#', taxa: '1,85%', ativo: false },
      { nome: 'ZeroOnePay', link: '#', taxa: '—', soon: true },
      { nome: 'HorsePay', link: '#', taxa: '—', soon: true }
    ]; %>

    <% gateways.forEach(g => { %>
      <div class="gateway-card <%= g.soon ? 'soon' : '' %> <%= g.ativo ? 'active' : '' %>">
        <div class="left">
          <div class="logo-box"></div>
          <div class="gateway-info">
            <div class="top-line">
              <h3><%= g.nome %> <% if (g.top) { %><span class="badge">🔥 TOP 1</span><% } %></h3>
              <% if (g.ativo) { %><span class="status">🟢 Ativo</span><% } %>
            </div>
            <div class="bottom-line">
              <span class="method">MÉTODO: API PIX</span>
              <a href="<%= g.link %>" target="_blank" class="taxa">Taxa: <%= g.taxa %></a>
            </div>
          </div>
        </div>

        <div class="right">
          <% if (!g.soon) { %>
            <button class="btn token" onclick="openTokenModal('<%= g.nome %>')">
              <%= g.temToken ? 'Alterar Token' : 'Adicionar Token' %>
            </button>
            <button class="btn toggle <%= g.ativo ? 'on' : '' %>" onclick="toggleGateway(this)">
              <%= g.ativo ? 'Desativar' : 'Ativar Gateway' %>
            </button>
          <% } else { %>
            <button class="btn disabled">Em breve</button>
          <% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>

<script>
function toggleGateway(el){
  const card = el.closest('.gateway-card');
  const isActive = card.classList.contains('active');

  if(isActive){
    card.classList.remove('active');
    el.innerText = 'Ativar Gateway';
    el.classList.remove('on');
    const status = card.querySelector('.status');
    if(status) status.remove();
  } else {
    document.querySelectorAll('.gateway-card').forEach(c => {
      c.classList.remove('active');
      const s = c.querySelector('.status');
      if(s) s.remove();
      const btn = c.querySelector('.btn.toggle');
      if(btn) { btn.classList.remove('on'); btn.innerText = 'Ativar Gateway'; }
    });
    card.classList.add('active');
    el.innerText = 'Desativar';
    el.classList.add('on');
    const topLine = card.querySelector('.top-line');
    const status = document.createElement('span');
    status.className = 'status';
    status.textContent = '🟢 Ativo';
    topLine.appendChild(status);
  }
}

function openTokenModal(name){
  alert(`Gerenciar Token do gateway: ${name}`);
}
</script>

<style>
body {
  background: #0b0b0b;
  color: #fff;
  font-family: "Inter", sans-serif;
  margin: 0;
}

.api-pix header {
  width: 90%;
  margin: 40px auto 20px;
}
.api-pix h1 {
  color: #ffcc00;
  font-size: 1.8rem;
  margin-bottom: 6px;
}
.api-pix p {
  color: #b3b3b3;
  font-size: 1rem;
  margin: 0;
}

.gateway-grid {
  width: 90%;
  margin: 20px auto 60px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
  gap: 22px;
}

.gateway-card {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 22px 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all .3s ease;
}
.gateway-card.active {
  border-color: #ffcc00;
  box-shadow: 0 0 20px rgba(255,204,0,0.3);
}
.left { display: flex; align-items: center; gap: 16px; }

.logo-box {
  width: 45px; height: 45px;
  background: rgba(255,255,255,0.05);
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
}
.logo-box::after {
  content: "Logo";
  color: rgba(255,255,255,0.3);
  font-size: 0.75rem;
}

.gateway-info { display: flex; flex-direction: column; gap: 6px; }
.top-line {
  display: flex;
  align-items: center;
  gap: 8px;
}
.bottom-line {
  display: flex;
  align-items: center;
  gap: 16px;
}
.method {
  font-size: 0.85rem;
  color: #aaa;
}
.taxa {
  color: #ffcc00;
  font-size: 0.85rem;
  text-decoration: none;
  transition: all .3s ease;
}
.taxa:hover { color: #ffe680; }

.status {
  font-size: 0.8rem;
  color: #9fff6d;
  font-weight: 600;
}

.badge {
  background: #ffcc00;
  color: #000;
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 0.7rem;
  margin-left: 5px;
}

.right {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-end;
}

.btn {
  border: none;
  outline: none;
  font-weight: 600;
  color: #000;
  background: linear-gradient(90deg, #ffcc00, #b38a00);
  border-radius: 6px;
  padding: 7px 14px;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all .3s ease;
}
.btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 12px rgba(255,204,0,0.5);
}
.btn.on {
  background: linear-gradient(90deg, #ffe066, #ffcc00);
  color: #000;
}
.btn.token {
  background: linear-gradient(90deg, #ffcc00, #ffae00);
}
.btn.disabled {
  background: rgba(255,255,255,0.08);
  color: #777;
  cursor: not-allowed;
}
</style>
