<!-- ESTILOS -->
<style>
  .gateways-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 50px 20px;
    transform: translateX(-32px);
  }

  .gateways-title {
    color: #ffcc00;
    font-size: 2.1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .gateways-sub {
    color: #bdbdbd;
    margin-bottom: 40px;
  }

  .gateways-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 26px;
  }

  .gateway-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,204,0,0.1);
    padding: 26px;
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: .25s;
  }

  .gateway-card:hover {
    border-color: rgba(255,204,0,0.25);
    box-shadow: 0 0 20px rgba(255,204,0,0.12);
  }

  .gateway-card.disabled {
    opacity: .55;
    pointer-events: none;
  }

  .g-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .g-icon {
    width: 46px;
    height: 46px;
    border-radius: 10px;
  }

  .g-right .btn-gateway {
    display: inline-block;
    background: rgba(255,204,0,0.12);
    padding: 8px 16px;
    border-radius: 10px;
    font-size: .9rem;
    color: #ffcc00;
    text-decoration: none;
    margin-left: 10px;
    transition: .25s;
  }

  .g-right .btn-gateway:hover {
    background: rgba(255,204,0,0.22);
  }

  .btn-gateway.disable {
    background: rgba(255,60,60,0.12);
    color: #ff6969;
  }

  .highlight {
    border-color: rgba(255,204,0,0.35);
    box-shadow: 0 0 24px rgba(255,204,0,0.18);
  }

  .soon {
    color: #ffcc00;
    opacity: .7;
    font-weight: 600;
  }

  /* MONITOR */
  .monitor-title {
    margin-top: 60px;
    margin-bottom: 16px;
    color: #ffcc00;
    font-size: 1.5rem;
  }

  .pix-chart {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,204,0,0.12);
    border-radius: 14px;
    padding: 20px;
  }

  /* ANIMAÇÃO SUAVE */
  .animate-in {
    opacity: 0;
    transform: translateY(22px);
    animation: fadeUp .55s ease forwards;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<!-- CHART -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('pixChart');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['04:00','07:00','10:00','13:00','16:00','19:00','22:00','01:00'],
      datasets: [{
        label: '',
        data: [1,2,4,7,6,12,4,1],
        borderColor: '#ffcc00',
        backgroundColor: 'rgba(255,204,0,0.15)',
        tension: 0.4,
        fill: true,
        borderWidth: 2
      }]
    },
    options: {
      plugins: { legend: { display:false }},
      scales: {
        x: { ticks: { color:'#aaa' }, grid:{ color:'rgba(255,255,255,0.06)' }},
        y: { ticks: { color:'#aaa' }, grid:{ color:'rgba(255,255,255,0.06)' }}
      }
    }
  });
</script>
