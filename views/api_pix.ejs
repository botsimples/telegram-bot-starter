<%- include('partials/visual_hottrack') %>

<main class="api-pix">
  <header>
    <h1>Integrações de Gateways</h1>
    <p>Escolha e ative seu gateway de pagamentos via API PIX.</p>
  </header>

  <section class="gateway-grid">
    <% const gateways = [
      { nome: 'WiinPay', link: 'https://v2.wiinpay.com.br', taxa: '1,89%', ativo: true, temToken: true, top: true },
      { nome: 'ParadisePag', link: '#', taxa: '2,10%', ativo: false },
      { nome: 'OasyFy', link: '#', taxa: '1,97%', ativo: false },
      { nome: 'PushinPay', link: '#', taxa: '1,95%', ativo: false },
      { nome: 'SyncPay', link: '#', taxa: '1,75%', ativo: false },
      { nome: 'Hoopay', link: '#', taxa: '1,85%', ativo: false },
      { nome: 'ZeroOnePay', link: '#', taxa: '—', soon: true },
      { nome: 'HorsePay', link: '#', taxa: '—', soon: true }
    ]; %>

    <% gateways.forEach(g => { %>
      <div class="gateway-card <%= g.soon ? 'soon' : '' %> <%= g.ativo ? 'active' : '' %>">
        <div class="left">
          <div class="logo-box"></div>
          <div class="gateway-info">
            <h3><%= g.nome %> <% if (g.top) { %><span class="badge">🔥 TOP 1</span><% } %></h3>
            <p>MÉTODO: API PIX</p>
            <a href="<%= g.link %>" target="_blank" class="taxa">Taxa: <%= g.taxa %></a>
          </div>
        </div>

        <div class="right">
          <% if (!g.soon) { %>
            <% if (g.ativo) { %>
              <div class="action-badge active">Ativo ✅</div>
            <% } else if (g.temToken) { %>
              <div class="action-badge alterar" onclick="openModal('<%= g.nome %>')">Alterar Token</div>
            <% } else { %>
              <div class="action-badge" onclick="activateGatewayCard(this)">Ativar Gateway</div>
            <% } %>
          <% } else { %>
            <div class="action-badge disabled">Em breve</div>
          <% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>

<script>
function activateGatewayCard(el){
  const allCards = document.querySelectorAll('.gateway-card');
  allCards.forEach(c => {
    c.classList.remove('active');
    const badge = c.querySelector('.action-badge');
    if(badge && !badge.classList.contains('disabled')) badge.innerText = 'Ativar Gateway';
    badge.classList.remove('active');
  });

  const card = el.closest('.gateway-card');
  card.classList.add('active');
  el.innerText = 'Ativo ✅';
  el.classList.add('active');
}

function openModal(name){
  alert(`Abrir modal de integração: ${name}`);
}
</script>

<style>
body {
  background: #0b0b0b;
  color: #fff;
  font-family: "Inter", sans-serif;
  margin: 0;
}

.api-pix header {
  width: 90%;
  margin: 40px auto 20px;
}
.api-pix h1 {
  color: #ffcc00;
  font-size: 1.8rem;
  margin-bottom: 6px;
}
.api-pix p {
  color: #b3b3b3;
  font-size: 1rem;
  margin: 0;
}

.gateway-grid {
  width: 90%;
  margin: 20px auto 60px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 20px;
}

.gateway-card {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 22px 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all .3s ease;
}
.gateway-card:hover {
  background: #181818;
  transform: scale(1.02);
}
.gateway-card.active {
  border-color: #ffcc00;
  box-shadow: 0 0 20px rgba(255,204,0,0.4);
  animation: glow 2s infinite ease-in-out;
}
@keyframes glow {
  0%,100% { box-shadow: 0 0 10px rgba(255,204,0,0.25); }
  50% { box-shadow: 0 0 20px rgba(255,204,0,0.5); }
}

.left { display: flex; align-items: center; gap: 16px; }
.logo-box {
  width: 45px; height: 45px;
  background: rgba(255,255,255,0.05);
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.4s ease;
}
.logo-box:hover {
  border-color: #ffcc00;
  box-shadow: 0 0 10px rgba(255,204,0,0.3);
}
.logo-box::after {
  content: "Logo";
  color: rgba(255,255,255,0.3);
  font-size: 0.75rem;
}

.gateway-info h3 {
  margin: 0;
  font-weight: 600;
  font-size: 1rem;
  color: #fff;
}
.gateway-info p {
  margin: 5px 0 0;
  color: #aaa;
  font-size: 0.85rem;
}
.badge {
  background: #ffcc00;
  color: #000;
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 0.7rem;
  margin-left: 5px;
}
.taxa {
  color: #ffcc00;
  font-size: 0.85rem;
  margin-top: 4px;
  display: inline-block;
  text-decoration: none;
  transition: all .3s ease;
}
.taxa:hover { color: #ffe680; text-shadow: 0 0 8px rgba(255,204,0,0.3); }

.action-badge {
  background: linear-gradient(90deg, #ffcc00, #b38a00);
  color: #000;
  font-weight: 600;
  border-radius: 6px;
  padding: 6px 12px;
  cursor: pointer;
  transition: all .3s ease;
  box-shadow: 0 0 6px rgba(255,204,0,0.2);
  font-size: 0.85rem;
}
.action-badge:hover {
  box-shadow: 0 0 15px rgba(255,204,0,0.5);
  transform: scale(1.05);
}
.action-badge.active {
  background: linear-gradient(90deg, #ffdb4d, #ffd633);
  color: #000;
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%,100% { box-shadow: 0 0 8px rgba(255,204,0,0.3); }
  50% { box-shadow: 0 0 15px rgba(255,204,0,0.6); }
}
.action-badge.alterar {
  background: linear-gradient(90deg, #ffcc00, #ffae00);
}
.action-badge.disabled {
  background: rgba(255,255,255,0.08);
  color: #777;
  cursor: not-allowed;
  box-shadow: none;
}
</style>
