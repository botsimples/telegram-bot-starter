        </div>
      </div>
      <div class="gateway-right">
        <button class="btn-integrar" onclick="openGatewayModal('WiinPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('WiinPay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="ParadisePag">
      <div class="gateway-left">
        <img src="https://i.ibb.co/TLvgdVJ/paradisepag.png" alt="ParadisePag" class="gateway-logo">
        <div class="gateway-info">
          <h3>ParadisePag</h3>
          <p>Gateway confiável e rápido, ideal para campanhas diretas.</p>
        </div>
      </div>
      <div class="gateway-right">
        <button class="btn-integrar" onclick="openGatewayModal('ParadisePag')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('ParadisePag', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="OasyFy">
      <div class="gateway-left">
        <img src="https://i.ibb.co/MpZ3c8m/oasyfy.png" alt="OasyFy" class="gateway-logo">
        <div class="gateway-info">
          <h3>OasyFy</h3>
          <p>Integração simples e estável com suporte a QR Code dinâmico.</p>
        </div>
      </div>
      <div class="gateway-right">
        <button class="btn-integrar" onclick="openGatewayModal('OasyFy')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('OasyFy', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="PushinPay">
      <div class="gateway-left">
        <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" alt="PushinPay" class="gateway-logo">
        <div class="gateway-info">
          <h3>PushinPay</h3>
          <p>Provedor flexível para automação de cobranças e bots.</p>
        </div>
      </div>
      <div class="gateway-right">
        <button class="btn-integrar" onclick="openGatewayModal('PushinPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('PushinPay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="SyncPay">
      <div class="gateway-left">
        <img src="https://i.ibb.co/Wkmpmfn/syncpay.png" alt="SyncPay" class="gateway-logo">
        <div class="gateway-info">
          <h3>SyncPay</h3>
          <p>Integração rápida para vendas automáticas via PIX.</p>
        </div>
      </div>
      <div class="gateway-right">
        <button class="btn-integrar" onclick="openGatewayModal('SyncPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('SyncPay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="gateway-card" data-gateway="Hoopay">
      <div class="gateway-left">
        <img src="https://i.ibb.co/jvYkkwm/hoopay.png" alt="Hoopay" class="gateway-logo">
        <div class="gateway-info">
          <h3>Hoopay</h3>
          <p>Pagamentos inteligentes com acompanhamento em tempo real.</p>
        </div>
      </div>
      <div class="gateway-right">
        <button class="btn-integrar" onclick="openGatewayModal('Hoopay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('Hoopay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="gateway-card soon">
      <div class="gateway-left">
        <img src="https://i.ibb.co/xXW6yVy/zeroone.png" alt="ZeroOnePay" class="gateway-logo">
        <div class="gateway-info">
          <h3>ZeroOnePay <span class="soon-tag">Em breve</span></h3>
        </div>
      </div>
      <button class="btn-disabled">Em breve</button>
    </div>

    <div class="gateway-card soon">
      <div class="gateway-left">
        <img src="https://i.ibb.co/x1bfG8L/horsepay.png" alt="HorsePay" class="gateway-logo">
        <div class="gateway-info">
