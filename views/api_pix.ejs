<main class="api-pix">
  <header>
    <h1>Integrações de Gateways</h1>
    <p>Escolha, ative e gerencie seus gateways de pagamento via API PIX.</p>
  </header>

  <section class="gateway-grid">
    <% const gateways = [
      { nome: 'WiinPay', link: 'https://v2.wiinpay.com.br', taxa: '4,99%', ativo: true, temToken: true, top: true },
      { nome: 'ParadisePag', link: 'https://multi.paradisepags.com/', taxa: '1 Real', ativo: false },
      { nome: 'OasyFy', link: 'https://oasyfy.com/', taxa: '2,90%', ativo: false },
      { nome: 'PushinPay', link: 'https://pushinpay.com.br/', taxa: '0,35 Centavos', ativo: false },
      { nome: 'SyncPay V2', link: 'https://syncpayments.com.br/', taxa: '0,35 Centavos', ativo: false },
      { nome: 'Hoopay', link: '#', taxa: '1,85%', ativo: false },
      { nome: 'ZeroOnePay', link: '#', taxa: '—', soon: true },
      { nome: 'HorsePay', link: '#', taxa: '—', soon: true }
    ]; %>

    <% gateways.forEach(g => { %>
      <div class="gateway-card <%= g.soon ? 'soon' : '' %> <%= g.ativo ? 'active' : '' %>">
        <div class="left">
          <div class="logo-box"></div>
          <div class="gateway-info">
            <div class="top-line">
              <h3><%= g.nome %></h3>
              <% if (g.top) { %><span class="badge">🔥 TOP 1</span><% } %>
              <% if (g.ativo) { %><span class="status">● Ativo</span><% } %>
            </div>
            <div class="bottom-line">
              <span class="method">MÉTODO: API PIX</span>
            </div>
            <div class="taxa-line">
              <a href="<%= g.link %>" target="_blank" class="taxa">Taxa: <%= g.taxa %></a>
            </div>
          </div>
        </div>

        <div class="right">
          <% if (!g.soon) { %>
            <button class="btn glass token" onclick="openTokenModal('<%= g.nome %>')">
              <%= g.temToken ? 'Alterar Token' : 'Adicionar Token' %>
            </button>
            <button class="btn glass toggle <%= g.ativo ? 'on' : '' %>" onclick="toggleGateway(this)">
              <%= g.ativo ? 'Desativar' : 'Ativar Gateway' %>
            </button>
          <% } else { %>
            <button class="btn glass disabled">Em breve</button>
          <% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>

<script>
function toggleGateway(el){
  const card = el.closest('.gateway-card');
  const isActive = card.classList.contains('active');

  if(isActive){
    card.classList.remove('active');
    el.innerText = 'Ativar Gateway';
    el.classList.remove('on');
    const status = card.querySelector('.status');
    if(status) status.remove();
  } else {
    document.querySelectorAll('.gateway-card').forEach(c => {
      c.classList.remove('active');
      const s = c.querySelector('.status');
      if(s) s.remove();
      const btn = c.querySelector('.btn.toggle');
      if(btn){ btn.classList.remove('on'); btn.innerText = 'Ativar Gateway'; }
    });
    card.classList.add('active');
    el.innerText = 'Desativar';
    el.classList.add('on');
    const topLine = card.querySelector('.top-line');
    const status = document.createElement('span');
    status.className = 'status';
    status.textContent = '● Ativo';
    topLine.appendChild(status);
  }
}

function openTokenModal(name){
  alert(`Gerenciar Token do gateway: ${name}`);
}
</script>

<style>
body {
  background: #0b0b0b;
  color: #fff;
  font-family: "Inter", sans-serif;
  margin: 0;
}

.api-pix header {
  width: 90%;
  margin: 40px auto 20px;
}
.api-pix h1 {
  color: #ffcc00;
  font-size: 1.8rem;
  margin-bottom: 6px;
}
.api-pix p {
  color: #b3b3b3;
  font-size: 1rem;
  margin: 0;
}

/* GRID */
.gateway-grid {
  width: 90%;
  margin: 20px auto 60px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
  gap: 22px;
}

/* CARD */
.gateway-card {
  position: relative;
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(18px);
  border-radius: 16px;
  padding: 26px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.08);
  height: 140px;
  transition: all .3s ease;
  outline: 2px solid transparent;
  outline-offset: -2px;
}
.gateway-card.active {
  border-color: rgba(255, 204, 0, 0.5);
  outline: 2px solid rgba(255, 204, 0, 0.35);
  background: rgba(255, 255, 255, 0.06);
}

/* conteúdo esquerdo */
.left { display: flex; align-items: center; gap: 18px; }

.logo-box {
  width: 48px; height: 48px;
  background: rgba(255,255,255,0.08);
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.4);
}
.gateway-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  position: relative;
}

/* nova tag de destaque TOP */
.gateway-info .badge {
  position: absolute;
  top: -16px;
  left: 0;
  background: #ffcc00;
  color: #000;
  padding: 3px 8px;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(255,204,0,0.2);
}

/* nome + status lado a lado */
.top-line {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
}
.top-line h3 {
  margin: 0;
  font-size: 1rem;
  display: flex;
  align-items: center;
}

/* status menor e mais elegante */
.status {
  font-size: 0.7rem;
  color: #ffcc00;
  background: rgba(255, 204, 0, 0.08);
  border: 1px solid rgba(255, 204, 0, 0.25);
  padding: 2px 8px;
  border-radius: 5px;
  line-height: 1;
  letter-spacing: 0.3px;
}

.bottom-line, .taxa-line {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 2px;
}
.method {
  font-size: 0.85rem;
  color: #aaa;
}
.taxa {
  color: #ffcc00;
  font-size: 0.85rem;
  text-decoration: none;
  transition: all .3s ease;
}
.taxa:hover { color: #ffe680; }

/* lado direito */
.right {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-end;
}

/* botões uniformes */
.btn.glass {
  border: 1px solid rgba(255,255,255,0.15);
  background: rgba(255, 255, 255, 0.06);
  color: #ffcc00;
  border-radius: 10px;
  padding: 10px 20px;
  font-weight: 500;
  font-size: 0.85rem;
  cursor: pointer;
  backdrop-filter: blur(16px);
  transition: all .25s ease;
  width: 160px;
  text-align: center;
}
.btn.glass:hover {
  background: rgba(255, 204, 0, 0.08);
  box-shadow: 0 0 10px rgba(255,204,0,0.2);
  transform: scale(1.03);
}
.btn.glass.on {
  background: rgba(255, 204, 0, 0.12);
  color: #fff;
  border-color: rgba(255, 204, 0, 0.5);
}
.btn.glass.disabled {
  opacity: 0.3;
  cursor: not-allowed;
}
</style>
