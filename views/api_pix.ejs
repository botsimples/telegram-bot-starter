<%- include('partials/visual_hottrack') %>

<main class="api-pix">
  <header>
    <h1>Integrações de Gateways</h1>
    <p>Escolha e ative seu gateway de pagamentos e API PIX, simples e fácil.</p>
  </header>

  <section class="gateway-grid">
    <% const gateways = [
      { nome: 'WiinPay', link: 'https://v2.wiinpay.com.br', top: true },
      { nome: 'ParadisePag', link: '#', top: false },
      { nome: 'OasyFy', link: '#', top: false },
      { nome: 'PushinPay', link: '#', top: false },
      { nome: 'SyncPay', link: '#', top: false },
      { nome: 'Hoopay', link: '#', top: false },
      { nome: 'ZeroOnePay', link: '#', top: false, soon: true },
      { nome: 'HorsePay', link: '#', top: false, soon: true },
      { nome: 'FlexionPay', link: '#', top: false }
    ]; %>

    <% gateways.forEach(g => { %>
      <div class="gateway-card <%= g.soon ? 'soon' : '' %>">
        <div class="left">
          <div class="gateway-icon"></div>
          <div class="gateway-info">
            <h3><%= g.nome %> <% if (g.top) { %><span class="badge">🔥 TOP 1</span><% } %></h3>
            <p>Gateway de pagamentos e API PIX, simples e fácil.</p>
          </div>
        </div>
        <div class="right">
          <% if (!g.soon) { %>
            <button class="btn-integrar" onclick="openModal('<%= g.nome %>')">Integrar</button>
            <button class="btn-site" onclick="window.open('<%= g.link %>', '_blank')">Acessar Site</button>
            <label class="switch">
              <input type="checkbox" onchange="activateGateway(this)">
              <span class="slider"></span>
            </label>
          <% } else { %>
            <button class="btn-soon" disabled>Em breve</button>
          <% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>

<!-- Modal de integração -->
<div id="integrationModal" class="modal-overlay" style="display:none;">
  <div class="modal">
    <span class="close" onclick="closeModal()">&times;</span>
    <h2 id="modalTitle">Integração</h2>
    <form>
      <label>Token API (obrigatório)</label>
      <input type="text" placeholder="Insira o Token API">
      <label>Client ID (opcional)</label>
      <input type="text" placeholder="Insira o Client ID">
      <label>Client Secret (opcional)</label>
      <input type="text" placeholder="Insira o Client Secret">
      <button type="button" class="save">Salvar Integração</button>
    </form>
  </div>
</div>

<script>
function openModal(name){
  document.getElementById('integrationModal').style.display='flex';
  document.getElementById('modalTitle').innerText='Integração • '+name;
}
function closeModal(){ document.getElementById('integrationModal').style.display='none'; }
function activateGateway(el){
  document.querySelectorAll('.switch input').forEach(i=>{ if(i!==el) i.checked=false; });
  document.querySelectorAll('.gateway-card').forEach(c=>c.classList.remove('active'));
  if(el.checked) el.closest('.gateway-card').classList.add('active');
}
</script>

<style>
body {
  background: #0b0b0b;
  color: #fff;
  font-family: "Inter", sans-serif;
  margin: 0;
}
.api-pix header {
  width: 90%;
  margin: 40px auto 20px;
}
.api-pix h1 {
  color: #ffcc00;
  font-size: 1.8rem;
  margin-bottom: 6px;
}
.api-pix p {
  color: #b3b3b3;
  font-size: 1rem;
  margin: 0;
}

.gateway-grid {
  width: 90%;
  margin: 20px auto 60px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 18px;
}

.gateway-card {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 20px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all .3s ease;
}
.gateway-card:hover {
  background: #181818;
  transform: scale(1.02);
}
.gateway-card.active {
  border-color: #ffcc00;
  box-shadow: 0 0 15px rgba(255,204,0,0.4);
  animation: glow 2s infinite ease-in-out;
}
@keyframes glow {
  0%,100% { box-shadow: 0 0 10px rgba(255,204,0,0.25); }
  50% { box-shadow: 0 0 20px rgba(255,204,0,0.5); }
}

.left { display: flex; align-items: center; gap: 14px; }
.gateway-icon {
  width: 44px; height: 44px;
  background: linear-gradient(180deg,#ffcc00,#b38a00);
  border-radius: 10px;
}
.gateway-info h3 {
  margin: 0;
  font-weight: 600;
  font-size: 1rem;
  color: #fff;
}
.gateway-info p {
  margin: 5px 0 0;
  color: #999;
  font-size: 0.9rem;
}
.badge {
  background: #ffcc00;
  color: #000;
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 0.7rem;
  margin-left: 5px;
}

.right {
  display: flex;
  align-items: center;
  gap: 10px;
}
button {
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  transition: all .3s ease;
}
.btn-integrar {
  background: rgba(255,255,255,0.1);
  color: #ffcc00;
  padding: 8px 14px;
}
.btn-integrar:hover { background: rgba(255,204,0,0.15); }

.btn-site {
  background: rgba(255,255,255,0.08);
  color: #ccc;
  padding: 8px 14px;
}
.btn-site:hover { background: rgba(255,255,255,0.2); }

.btn-soon {
  background: rgba(255,255,255,0.05);
  color: #777;
  padding: 8px 14px;
  cursor: not-allowed;
}

.switch {
  position: relative;
  display: inline-block;
  width: 40px; height: 22px;
}
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute;
  cursor: pointer;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(255,255,255,0.1);
  border-radius: 34px;
  transition: .4s;
}
.slider:before {
  position: absolute;
  content: "";
  height: 16px; width: 16px;
  left: 3px; bottom: 3px;
  background-color: #999;
  border-radius: 50%;
  transition: .4s;
}
input:checked + .slider {
  background: linear-gradient(90deg,#ffcc00,#d4a100);
}
input:checked + .slider:before {
  transform: translateX(18px);
  background: #000;
}

.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(8px);
}
.modal {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 30px;
  width: 90%; max-width: 450px;
  position: relative;
}
.modal h2 { color: #ffcc00; margin-bottom: 15px; }
.modal label { display: block; margin-top: 10px; }
.modal input {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #fff;
  padding: 10px;
  margin-top: 4px;
}
.save {
  width: 100%;
  background: linear-gradient(90deg,#ffcc00,#d4a100);
  color: #000;
  margin-top: 20px;
  font-weight: 700;
  padding: 10px;
}
.close {
  position: absolute;
  right: 16px;
  top: 10px;
  font-size: 1.8rem;
  color: #ffcc00;
  cursor: pointer;
}
</style>
