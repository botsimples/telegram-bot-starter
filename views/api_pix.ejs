<% layout('layout') %>

<div class="page-container">
  <div class="page-header">
    <h1>Adquirentes</h1>
    <p>Gerencie suas chaves e integrações PIX ativas.</p>
  </div>

  <div class="actions">
    <button onclick="openModal('modalPix')" class="btn-primary">+ Novo Adquirente</button>
  </div>

  <div class="cards-grid">
    <% if (adquirentes && adquirentes.length > 0) { %>
      <% adquirentes.forEach(adq => { %>
        <div class="dash-card wide">
          <div class="card-header">
            <h2><%= adq.provider %></h2>
            <span class="tag">Integrado</span>
          </div>
          <p>Chave: <%= adq.key %></p>
          <div class="card-footer">
            <button class="btn-secondary">Editar</button>
            <button class="btn-danger">Excluir</button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="empty-text">Nenhum adquirente configurado.</p>
    <% } %>
  </div>
</div>

<!-- MODAL NOVO ADQUIRENTE -->
<div id="modalPix" class="modal-bg">
  <div class="modal-box">
    <h2>Novo Adquirente</h2>
    <form action="/api_pix/add" method="POST">
      <input type="text" name="provider" placeholder="Nome da Adquirente (ex: WiinPay)" required />
      <input type="text" name="key" placeholder="Client ID" required />
      <input type="text" name="secret" placeholder="Client Secret" required />
      <div class="modal-actions">
        <button type="submit" class="btn-primary">Salvar</button>
        <button type="button" class="btn-cancel" onclick="closeModal('modalPix')">Cancelar</button>
      </div>
    </form>
  </div>
</div>
