<%- include('partials/visual_hottrack') %>

<main class="api-pix">
  <header>
    <h1>Integrações de Gateways</h1>
    <p>Escolha, ative e gerencie seus gateways de pagamento via API PIX.</p>
  </header>

  <section class="gateway-grid">
    <% const gateways = [
      { nome: 'WiinPay', link: 'https://v2.wiinpay.com.br', taxa: '1,89%', ativo: true, temToken: true, top: true },
      { nome: 'ParadisePag', link: '#', taxa: '2,10%', ativo: false },
      { nome: 'OasyFy', link: '#', taxa: '1,97%', ativo: false },
      { nome: 'PushinPay', link: '#', taxa: '1,95%', ativo: true, temToken: false },
      { nome: 'SyncPay', link: '#', taxa: '1,75%', ativo: false },
      { nome: 'Hoopay', link: '#', taxa: '1,85%', ativo: false },
      { nome: 'ZeroOnePay', link: '#', taxa: '—', soon: true },
      { nome: 'HorsePay', link: '#', taxa: '—', soon: true }
    ]; %>

    <% gateways.forEach(g => { %>
      <div class="gateway-card <%= g.soon ? 'soon' : '' %> <%= g.ativo ? 'active' : '' %>">
        <div class="left">
          <div class="logo-box"></div>
          <div class="gateway-info">
            <h3><%= g.nome %> <% if (g.top) { %><span class="badge">🔥 TOP 1</span><% } %></h3>
            <p>MÉTODO: API PIX</p>
            <a href="<%= g.link %>" target="_blank" class="taxa">Taxa: <%= g.taxa %></a>
          </div>
        </div>

        <div class="right">
          <% if (!g.soon) { %>
            <% if (g.temToken) { %>
              <div class="action-badge small" onclick="openTokenModal('<%= g.nome %>')">Alterar Token</div>
            <% } else { %>
              <div class="action-badge small" onclick="openTokenModal('<%= g.nome %>')">Adicionar Token</div>
            <% } %>

            <% if (g.ativo) { %>
              <div class="action-badge active small" onclick="toggleGateway(this)">Desativar</div>
            <% } else { %>
              <div class="action-badge small" onclick="toggleGateway(this)">Ativar Gateway</div>
            <% } %>
          <% } else { %>
            <div class="action-badge disabled">Em breve</div>
          <% } %>
        </div>
      </div>
    <% }) %>
  </section>
</main>

<!-- Modal fictício -->
<div id="tokenModal" class="modal-overlay" style="display:none;">
  <div class="modal">
    <span class="close" onclick="closeTokenModal()">&times;</span>
    <h2 id="modalTitle">Adicionar Token</h2>
    <form>
      <label>Token API</label>
      <input type="text" placeholder="Insira seu Token">
      <button type="button" class="save">Salvar</button>
    </form>
  </div>
</div>

<script>
function toggleGateway(el){
  const card = el.closest('.gateway-card');
  const isActive = card.classList.contains('active');

  if(isActive){
    card.classList.remove('active');
    el.innerText = 'Ativar Gateway';
    el.classList.remove('active');
  } else {
    document.querySelectorAll('.gateway-card').forEach(c => {
      c.classList.remove('active');
      const btn = c.querySelector('.action-badge.active');
      if(btn) { btn.innerText = 'Ativar Gateway'; btn.classList.remove('active'); }
    });
    card.classList.add('active');
    el.innerText = 'Desativar';
    el.classList.add('active');
  }
}

function openTokenModal(name){
  document.getElementById('tokenModal').style.display = 'flex';
  document.getElementById('modalTitle').innerText = `Token • ${name}`;
}
function closeTokenModal(){
  document.getElementById('tokenModal').style.display = 'none';
}
</script>

<style>
body {
  background: #0b0b0b;
  color: #fff;
  font-family: "Inter", sans-serif;
  margin: 0;
}

.api-pix header {
  width: 90%;
  margin: 40px auto 20px;
}
.api-pix h1 {
  color: #ffcc00;
  font-size: 1.8rem;
  margin-bottom: 6px;
}
.api-pix p {
  color: #b3b3b3;
  font-size: 1rem;
  margin: 0;
}

.gateway-grid {
  width: 90%;
  margin: 20px auto 60px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
  gap: 20px;
}

.gateway-card {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 22px 26px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all .3s ease;
}
.gateway-card.active {
  border-color: #ffcc00;
  box-shadow: 0 0 20px rgba(255,204,0,0.4);
  animation: glow 2s infinite ease-in-out;
}
@keyframes glow {
  0%,100% { box-shadow: 0 0 10px rgba(255,204,0,0.25); }
  50% { box-shadow: 0 0 20px rgba(255,204,0,0.5); }
}

.left { display: flex; align-items: center; gap: 16px; }
.logo-box {
  width: 45px; height: 45px;
  background: rgba(255,255,255,0.05);
  border-radius: 8px;
  border: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.4s ease;
}
.logo-box:hover {
  border-color: #ffcc00;
  box-shadow: 0 0 10px rgba(255,204,0,0.3);
}
.logo-box::after {
  content: "Logo";
  color: rgba(255,255,255,0.3);
  font-size: 0.75rem;
}

.gateway-info h3 {
  margin: 0;
  font-weight: 600;
  font-size: 1rem;
  color: #fff;
}
.gateway-info p {
  margin: 5px 0 0;
  color: #aaa;
  font-size: 0.85rem;
}
.badge {
  background: #ffcc00;
  color: #000;
  padding: 2px 6px;
  border-radius: 5px;
  font-size: 0.7rem;
  margin-left: 5px;
}
.taxa {
  color: #ffcc00;
  font-size: 0.85rem;
  margin-top: 4px;
  display: inline-block;
  text-decoration: none;
  transition: all .3s ease;
}
.taxa:hover { color: #ffe680; text-shadow: 0 0 8px rgba(255,204,0,0.3); }

.right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.action-badge {
  background: linear-gradient(90deg, #ffcc00, #b38a00);
  color: #000;
  font-weight: 600;
  border-radius: 6px;
  padding: 6px 12px;
  cursor: pointer;
  transition: all .3s ease;
  box-shadow: 0 0 6px rgba(255,204,0,0.2);
  font-size: 0.85rem;
  text-align: center;
}
.action-badge.small { padding: 5px 10px; font-size: 0.8rem; }
.action-badge:hover {
  box-shadow: 0 0 15px rgba(255,204,0,0.5);
  transform: scale(1.05);
}
.action-badge.active {
  background: linear-gradient(90deg, #ffdb4d, #ffd633);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%,100% { box-shadow: 0 0 8px rgba(255,204,0,0.3); }
  50% { box-shadow: 0 0 15px rgba(255,204,0,0.6); }
}
.action-badge.disabled {
  background: rgba(255,255,255,0.08);
  color: #777;
  cursor: not-allowed;
  box-shadow: none;
}

/* Modal */
.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(8px);
}
.modal {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 30px;
  width: 90%; max-width: 400px;
  position: relative;
}
.modal h2 { color: #ffcc00; margin-bottom: 15px; }
.modal input {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #fff;
  padding: 10px;
  margin-top: 8px;
}
.save {
  width: 100%;
  background: linear-gradient(90deg,#ffcc00,#d4a100);
  color: #000;
  margin-top: 20px;
  font-weight: 700;
  padding: 10px;
}
.close {
  position: absolute; right: 16px; top: 10px;
  font-size: 1.8rem; color: #ffcc00; cursor: pointer;
}
</style>
