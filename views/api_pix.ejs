<script>
  // Gráfico padrão (não mexi em nada para não quebrar)
  const ctx = document.getElementById('pixChart').getContext('2d');
  new Chart(ctx,{
    type:'line',
    data:{
      labels:['04:00','07:00','10:00','13:00','16:00','19:00','22:00','01:00'],
      datasets:[{
        label:'Status',
        data:[1,2,5,9,8,13,6,2],
        borderColor:'#ffcc00',
        backgroundColor:'rgba(255,204,0,0.25)',
        borderWidth:3,
        fill:true,
        tension:.4,
        pointRadius:5,
        pointBackgroundColor:'#ffcc00'
      }]
    },
    options:{
      plugins:{legend:{display:false}},
      scales:{
        y:{beginAtZero:true,grid:{color:'rgba(255,255,255,0.05)'}},
        x:{grid:{color:'rgba(255,255,255,0.05)'}}
      }
    }
  });
</script>

<style>
/* ============================
   VISUAL GERAL
============================ */
.api-pix {
  padding: 60px 70px 120px 130px;
  transform: scale(0.90) translateX(-25px);
  transform-origin: top center;
  max-width: 1400px;
  margin: 0 auto;
}

/* ============================
   TÍTULOS
============================ */
.api-title {
  font-size: 2.2rem;
  font-weight: 700;
  color: #ffcc00;
  margin-bottom: 6px;
}

.api-sub {
  font-size: 1rem;
  color: #bdbdbd;
  margin-bottom: 35px;
}

/* ============================
   GRID DE GATEWAYS
============================ */
.gateways-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(330px, 1fr));
  gap: 32px;
  width: 100%;
  margin-top: 20px;
}

/* ============================
   CARDS
============================ */
.gateway-card {
  width: 100%;
  min-height: 125px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 26px;
  border-radius: 14px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,204,0,0.10);
  transition: .25s;
}

.gateway-card:hover {
  border-color: rgba(255,204,0,0.30);
  box-shadow: 0 0 18px rgba(255,204,0,0.15);
  transform: translateY(-4px);
}

.gateway-card.disabled {
  opacity: .55;
  filter: grayscale(1);
}

/* INFO */
.gateway-info {
  display: flex;
  align-items: center;
  gap: 18px;
}

.gateway-info h3 {
  margin: 0;
  font-size: 1.15rem;
  color: #fff;
}

.gateway-info p {
  margin: 0;
  font-size: .85rem;
  color: #d5d5d5;
}

.gray-box {
  width: 42px;
  height: 42px;
  border-radius: 6px;
  background: rgba(255,255,255,0.08);
}

/* AÇÕES */
.gateway-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.btn-small {
  background: #ffcc00;
  color: #000;
  font-weight: 700;
  border: none;
  border-radius: 8px;
  padding: 7px 12px;
  cursor: pointer;
}

.btn-small.disabled {
  background: rgba(255,255,255,0.03);
  color: #777;
  cursor: not-allowed;
}

.badge-top {
  font-size: .8rem;
  padding: 2px 8px;
  background: #ffcc00;
  border-radius: 6px;
  color: #000;
  margin-left: 6px;
}

/* ============================
   GRÁFICO
============================ */
.chart-wrapper {
  width: 100%;
  max-width: 1400px;
  margin: 60px auto 0 auto;
  padding: 30px 40px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,204,0,0.12);
  border-radius: 18px;
}

.chart-title {
  color: #ffcc00;
  font-size: 1.6rem;
  margin-bottom: 12px;
}

.chart-container {
  width: 100%;
  height: 370px;
}

/* RESPONSIVIDADE */
@media (max-width: 1450px) {
  .gateways-grid {
    grid-template-columns: repeat(2, minmax(300px, 1fr));
  }
}

@media (max-width: 1100px) {
  .gateways-grid {
    grid-template-columns: repeat(1, 1fr);
  }

  .api-pix {
    transform: scale(1) translateX(0);
    padding: 40px 20px;
  }
}

/* ============================
   CARREGAMENTO RÁPIDO
============================ */
@keyframes pageFadeQuick{
 0%{opacity:0;}
 100%{opacity:1;}
}

.api-pix{animation:pageFadeQuick .25s ease-in forwards;}

</style>
