<%- include('partials/visual_hottrack') %>

<main class="api-pix-page">
  <header class="api-header">
    <h1>API PIX</h1>
    <p>Integre gateways de pagamento ao TigerFy com facilidade.</p>
  </header>

  <div class="api-grid">

    <!-- WIINPAY -->
    <div class="api-card top1">
      <div class="api-card-header">
        <img src="https://i.ibb.co/VNDsN1T/wiinpay.png" alt="WiinPay" class="api-logo">
        <div class="badge-top1">
          <span class="fire">🔥</span> TOP 1 • RECOMENDADO
        </div>
      </div>
      <button class="btn-access">Acessar</button>
    </div>

    <!-- PARADISEPAG -->
    <div class="api-card">
      <img src="https://i.ibb.co/TLvgdVJ/paradisepag.png" alt="ParadisePag" class="api-logo">
      <button class="btn-access">Acessar</button>
    </div>

    <!-- OASYFY -->
    <div class="api-card">
      <img src="https://i.ibb.co/MpZ3c8m/oasyfy.png" alt="OasyFy" class="api-logo">
      <button class="btn-access">Acessar</button>
    </div>

    <!-- PUSHINPAY -->
    <div class="api-card">
      <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" alt="PushinPay" class="api-logo">
      <button class="btn-access">Acessar</button>
    </div>

    <!-- SYNC PAY -->
    <div class="api-card">
      <img src="https://i.ibb.co/Wkmpmfn/syncpay.png" alt="Sync Pay" class="api-logo">
      <button class="btn-access">Acessar</button>
    </div>

    <!-- HOOPAY -->
    <div class="api-card">
      <img src="https://i.ibb.co/jvYkkwm/hoopay.png" alt="Hoopay" class="api-logo">
      <button class="btn-access">Acessar</button>
    </div>

    <!-- ZEROONEPAY -->
    <div class="api-card soon">
      <img src="https://i.ibb.co/xXW6yVy/zeroone.png" alt="ZeroOnePay" class="api-logo">
      <div class="soon-badge">EM BREVE</div>
      <button class="btn-disabled" disabled>Em breve</button>
    </div>

    <!-- HORSEPAY -->
    <div class="api-card soon">
      <img src="https://i.ibb.co/x1bfG8L/horsepay.png" alt="HorsePay" class="api-logo">
      <div class="soon-badge">EM BREVE</div>
      <button class="btn-disabled" disabled>Em breve</button>
    </div>

  </div>
</main>

<style>
  html,body{
    background:#0a0a0a;
    color:#fff;
    font-family:'Inter',sans-serif;
    margin:0;padding:0;
    -webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}::-webkit-scrollbar{display:none;}

  .api-pix-page{
    padding:60px 40px 120px 40px;
    transform:translateX(-38px);
  }

  .api-header h1{
    color:#ffcc00;
    font-size:2rem;
    margin:0 0 8px 0;
  }

  .api-header p{
    color:#b4b4b4;
    margin:0 0 35px 0;
  }

  .api-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
  }

  .api-card{
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.1);
    border-radius:14px;
    padding:25px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    transition:.25s ease;
    position:relative;
  }

  .api-card:hover{
    background:rgba(255,204,0,0.05);
    box-shadow:0 0 15px rgba(255,204,0,0.25);
    transform:translateY(-3px);
  }

  .api-logo{
    width:65px;
    height:65px;
    object-fit:contain;
    margin-bottom:20px;
    border-radius:10px;
    background:#111;
    padding:6px;
  }

  .btn-access{
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    border:none;
    border-radius:8px;
    padding:8px 18px;
    color:#000;
    font-weight:600;
    cursor:pointer;
    transition:filter .3s;
  }
  .btn-access:hover{filter:brightness(1.1);}

  .btn-disabled{
    background:rgba(255,255,255,0.07);
    color:#777;
    border:none;
    border-radius:8px;
    padding:8px 18px;
    cursor:not-allowed;
  }

  .soon-badge{
    position:absolute;
    top:10px;right:12px;
    background:rgba(255,255,255,0.08);
    color:#999;
    font-size:.7rem;
    padding:4px 10px;
    border-radius:6px;
    text-transform:uppercase;
  }

  .badge-top1{
    position:absolute;
    top:10px;right:12px;
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    color:#000;
    font-weight:700;
    font-size:.75rem;
    border-radius:8px;
    padding:5px 10px;
    display:flex;
    align-items:center;
    gap:4px;
    animation:pulse 2s infinite;
  }

  .fire{animation:flame 1s infinite alternate;}

  @keyframes flame{
    from{transform:scale(1);}
    to{transform:scale(1.3) rotate(5deg);}
  }
  @keyframes pulse{
    0%{box-shadow:0 0 10px rgba(255,204,0,0.5);}
    50%{box-shadow:0 0 20px rgba(255,204,0,0.9);}
    100%{box-shadow:0 0 10px rgba(255,204,0,0.5);}
  }

  .top1{border:1px solid rgba(255,204,0,0.3);}
  .soon{opacity:0.8;}
  .soon:hover{transform:none;box-shadow:none;background:rgba(255,255,255,0.03);}
</style>
