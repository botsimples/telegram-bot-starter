<%- include('partials/visual_hottrack') %>

<main class="api-pix">
  <header>
    <h1>API PIX</h1>
    <p>Integre gateways de pagamento ao TigerFy com praticidade e estilo.</p>
  </header>

  <!-- Gateways Disponíveis -->
  <section>
    <h2 class="category-title">🟡 Gateways disponíveis</h2>

    <% const gateways = [
      { nome: 'WiinPay', desc: 'Integração oficial com suporte total ao PIX e automações.', top: true },
      { nome: 'ParadisePag', desc: 'Gateway confiável e rápido, ideal para campanhas diretas.' },
      { nome: 'OasyFy', desc: 'Integração simples e estável com suporte a QR Code dinâmico.' },
      { nome: 'PushinPay', desc: 'Provedor flexível para automação de cobranças e bots.' },
      { nome: 'SyncPay', desc: 'Integração rápida para vendas automáticas via PIX.' },
      { nome: 'Hoopay', desc: 'Pagamentos inteligentes com acompanhamento em tempo real.' },
    ]; %>

    <% gateways.forEach(g => { %>
      <div class="gateway-card" data-name="<%= g.nome %>">
        <div class="left">
          <img src="https://i.ibb.co/vYp9K6L/logo-placeholder.png" alt="<%= g.nome %>">
          <div class="info">
            <h3>
              <%= g.nome %> 
              <% if (g.top) { %><span class="top-badge">🔥 TOP 1</span><% } %>
            </h3>
            <p><%= g.desc %></p>
          </div>
        </div>
        <div class="right">
          <button onclick="openModal('<%= g.nome %>')">Integrar</button>
          <label class="switch">
            <input type="checkbox" onchange="activateGateway(this)">
            <span class="slider"></span>
          </label>
        </div>
      </div>
    <% }) %>
  </section>

  <!-- Gateways em breve -->
  <section>
    <h2 class="category-title">⚫ Em breve</h2>
    <div class="gateway-card soon">
      <div class="left">
        <img src="https://i.ibb.co/xXW6yVy/zeroone.png" alt="ZeroOnePay">
        <div class="info">
          <h3>ZeroOnePay</h3>
          <p>Gateway em desenvolvimento com recursos premium.</p>
        </div>
      </div>
      <button class="disabled">Em breve</button>
    </div>

    <div class="gateway-card soon">
      <div class="left">
        <img src="https://i.ibb.co/x1bfG8L/horsepay.png" alt="HorsePay">
        <div class="info">
          <h3>HorsePay</h3>
          <p>Nova integração exclusiva com suporte avançado.</p>
        </div>
      </div>
      <button class="disabled">Em breve</button>
    </div>
  </section>
</main>

<!-- MODAL -->
<div id="integrationModal" class="modal-overlay" style="display:none;">
  <div class="modal">
    <span class="close" onclick="closeModal()">&times;</span>
    <h2 id="modalTitle">Integração</h2>
    <form>
      <label>Token API (obrigatório)</label>
      <input type="text" placeholder="Insira o Token API">
      <label>Client ID (opcional)</label>
      <input type="text" placeholder="Insira o Client ID">
      <label>Client Secret (opcional)</label>
      <input type="text" placeholder="Insira o Client Secret">
      <button type="button" class="save">Salvar Integração</button>
    </form>
  </div>
</div>

<script>
function activateGateway(el){
  document.querySelectorAll('.switch input').forEach(i=>{ if(i!==el) i.checked=false; });
  document.querySelectorAll('.gateway-card').forEach(c=>c.classList.remove('active'));
  if(el.checked) el.closest('.gateway-card').classList.add('active');
}
function openModal(name){
  document.getElementById('integrationModal').style.display='flex';
  document.getElementById('modalTitle').innerText='Integração • '+name;
}
function closeModal(){ document.getElementById('integrationModal').style.display='none'; }
</script>

<style>
body {
  background: #0a0a0a;
  color: #fff;
  font-family: "Inter", sans-serif;
  margin: 0;
  padding: 0;
}
.api-pix header {
  width: 85%;
  margin: 40px auto 20px;
}
.api-pix h1 {
  color: #ffcc00;
  margin-bottom: 6px;
}
.api-pix p {
  color: #b4b4b4;
  margin: 0;
}
.category-title {
  width: 85%;
  margin: 40px auto 15px;
  color: #ffcc00;
  font-size: 1.1rem;
  font-weight: 600;
}
.gateway-card {
  width: 85%;
  margin: 10px auto;
  background: #111;
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 10px;
  padding: 18px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all .3s;
}
.gateway-card.active {
  box-shadow: 0 0 15px rgba(255,204,0,0.4);
  border-color: #ffcc00;
  animation: glow 2s infinite ease-in-out;
}
@keyframes glow {
  0%,100% { box-shadow: 0 0 10px rgba(255,204,0,0.2); }
  50% { box-shadow: 0 0 20px rgba(255,204,0,0.5); }
}
.gateway-card:hover { background: #161616; }
.left { display: flex; align-items: center; gap: 16px; }
.left img {
  width: 42px; height: 42px; border-radius: 8px;
  background: rgba(255,255,255,0.04);
}
.info h3 {
  margin: 0; font-size: 1rem; font-weight: 600;
}
.info p {
  margin: 4px 0 0; color: #aaa; font-size: 0.9rem;
}
.top-badge {
  background: linear-gradient(90deg,#ffcc00,#d4a100);
  color: #000;
  padding: 2px 6px;
  border-radius: 6px;
  font-size: 0.7rem;
  margin-left: 6px;
}
.right {
  display: flex; align-items: center; gap: 10px;
}
button {
  background: #1a1a1a;
  border: 1px solid rgba(255,255,255,0.08);
  color: #fff;
  border-radius: 8px;
  padding: 8px 16px;
  cursor: pointer;
  font-weight: 600;
  transition: all .3s;
}
button:hover { background: rgba(255,255,255,0.1); }
button.disabled {
  opacity: 0.4;
  cursor: not-allowed;
}
.switch {
  position: relative; display: inline-block; width: 36px; height: 20px;
}
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.1); transition: .4s; border-radius: 34px;
}
.slider:before {
  position: absolute; content: ""; height: 14px; width: 14px; left: 3px; bottom: 3px;
  background: #999; transition: .4s; border-radius: 50%;
}
input:checked + .slider { background: linear-gradient(90deg,#ffcc00,#d4a100); }
input:checked + .slider:before { transform: translateX(16px); background: #000; }
.modal-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(8px);
}
.modal {
  background: #121212;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  padding: 30px;
  width: 90%; max-width: 450px;
  position: relative;
}
.close {
  position: absolute; right: 16px; top: 10px;
  font-size: 1.8rem; color: #ffcc00; cursor: pointer;
}
.modal h2 {
  margin-bottom: 15px;
  color: #ffcc00;
}
.modal label {
  font-size: 0.9rem; margin-top: 10px;
}
.modal input {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  color: #fff;
  padding: 10px;
  margin-top: 4px;
}
.save {
  width: 100%;
  background: linear-gradient(90deg,#ffcc00,#d4a100);
  color: #000;
  margin-top: 20px;
  font-weight: 700;
}
</style>
