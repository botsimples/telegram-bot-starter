<main class="space-y-6">
  <h1 class="text-2xl font-semibold text-hot-primary">Prioridade API PIX</h1>

  <div class="panel p-4">
    <p class="text-sm opacity-80 mb-3">Defina a ordem de fallback dos gateways.</p>
    <div class="grid md:grid-cols-3 gap-3">
      <div>
        <label class="block text-xs mb-1">Primário</label>
        <select id="p1" class="input">
          <option value="">Nenhum</option>
          <% (apipix?.gateways || []).forEach(g => { %>
            <option value="<%= g.name %>" <%= (apipix?.priority?.primary===g.name ? 'selected' : '') %>><%= g.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs mb-1">Secundário</label>
        <select id="p2" class="input">
          <option value="">Nenhum</option>
          <% (apipix?.gateways || []).forEach(g => { %>
            <option value="<%= g.name %>" <%= (apipix?.priority?.secondary===g.name ? 'selected' : '') %>><%= g.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs mb-1">Terciário</label>
        <select id="p3" class="input">
          <option value="">Nenhum</option>
          <% (apipix?.gateways || []).forEach(g => { %>
            <option value="<%= g.name %>" <%= (apipix?.priority?.tertiary===g.name ? 'selected' : '') %>><%= g.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <button class="btn mt-3" onclick="salvar()">Salvar prioridade</button>
  </div>
</main>

<script>
async function salvar(){
  const payload = {
    primary: document.getElementById('p1').value || null,
    secondary: document.getElementById('p2').value || null,
    tertiary: document.getElementById('p3').value || null,
  };
  const res = await fetch('/admin/api-pix/priority',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  alert(res.ok ? 'Prioridade salva!' : 'Erro ao salvar');
}
</script>
