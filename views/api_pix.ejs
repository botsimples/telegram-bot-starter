<%- include('partials/visual_hottrack') %>

<main class="api-pix-page">
  <header class="api-header">
    <h1>API PIX</h1>
    <p>Integre gateways de pagamento ao TigerFy com facilidade.</p>
  </header>

  <div class="api-grid">
    <!-- WIINPAY -->
    <div class="api-card top1">
      <div class="badge-top1"><span class="fire">🔥</span> TOP 1 • RECOMENDADO</div>
      <img src="https://i.ibb.co/VNDsN1T/wiinpay.png" alt="WiinPay" class="api-logo">
      <h3>WiinPay</h3>
      <button class="btn-glass">Integrar</button>
    </div>

    <!-- PARADISEPAG -->
    <div class="api-card">
      <img src="https://i.ibb.co/TLvgdVJ/paradisepag.png" alt="ParadisePag" class="api-logo">
      <h3>ParadisePag</h3>
      <button class="btn-glass">Integrar</button>
    </div>

    <!-- OASYFY -->
    <div class="api-card">
      <img src="https://i.ibb.co/MpZ3c8m/oasyfy.png" alt="OasyFy" class="api-logo">
      <h3>OasyFy</h3>
      <button class="btn-glass">Integrar</button>
    </div>

    <!-- PUSHINPAY -->
    <div class="api-card">
      <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" alt="PushinPay" class="api-logo">
      <h3>PushinPay</h3>
      <button class="btn-glass">Integrar</button>
    </div>

    <!-- SYNC PAY -->
    <div class="api-card">
      <img src="https://i.ibb.co/Wkmpmfn/syncpay.png" alt="Sync Pay" class="api-logo">
      <h3>Sync Pay</h3>
      <button class="btn-glass">Integrar</button>
    </div>

    <!-- HOOPAY -->
    <div class="api-card">
      <img src="https://i.ibb.co/jvYkkwm/hoopay.png" alt="Hoopay" class="api-logo">
      <h3>Hoopay</h3>
      <button class="btn-glass">Integrar</button>
    </div>

    <!-- ZEROONEPAY -->
    <div class="api-card soon">
      <div class="soon-badge">EM BREVE</div>
      <img src="https://i.ibb.co/xXW6yVy/zeroone.png" alt="ZeroOnePay" class="api-logo">
      <h3>ZeroOnePay</h3>
      <button class="btn-disabled" disabled>Em breve</button>
    </div>

    <!-- HORSEPAY -->
    <div class="api-card soon">
      <div class="soon-badge">EM BREVE</div>
      <img src="https://i.ibb.co/x1bfG8L/horsepay.png" alt="HorsePay" class="api-logo">
      <h3>HorsePay</h3>
      <button class="btn-disabled" disabled>Em breve</button>
    </div>
  </div>
</main>

<style>
  html,body{
    background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;
    margin:0;padding:0;-webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}::-webkit-scrollbar{display:none;}

  .api-pix-page{
    padding:60px 0 120px 0;
    display:flex;flex-direction:column;align-items:center;
  }
  .api-header{width:85%;max-width:1300px;margin-bottom:30px;}
  .api-header h1{color:#ffcc00;font-size:2rem;margin:0 0 8px;}
  .api-header p{color:#b4b4b4;margin:0;}

  .api-grid{
    width:85%;max-width:1300px;
    display:grid;
    grid-template-columns:repeat(4, minmax(260px, 1fr));
    gap:28px;
    justify-items:stretch;
  }

  .api-card{
    position:relative;
    height:240px;
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:14px;
    padding:42px 24px 25px;
    display:flex;flex-direction:column;align-items:center;justify-content:space-between;
    text-align:center;transition:.25s ease;
  }
  .api-card:hover{
    background:rgba(255,255,255,0.05);
    box-shadow:0 0 16px rgba(255,204,0,0.22);
    transform:translateY(-3px);
  }

  .badge-top1{
    position:absolute;
    top:-12px;left:50%;transform:translateX(-50%);
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    color:#000;font-weight:800;font-size:.75rem;
    border-radius:10px;padding:6px 12px;
    display:flex;align-items:center;gap:6px;
    box-shadow:0 8px 18px rgba(255,204,0,0.25);
  }
  .fire{animation:flame .9s infinite alternate ease-in-out}
  @keyframes flame{from{transform:translateY(0)}to{transform:translateY(-2px) scale(1.05)}}

  .top1{border-color:rgba(255,204,0,0.35);background:rgba(255,255,255,0.04)}

  .api-logo{
    width:66px;height:66px;object-fit:contain;
    border-radius:10px;background:#111;padding:6px;
  }

  .api-card h3{
    margin:10px 0 0;
    font-size:1rem;
    color:#ffcc00;
    font-weight:600;
  }

  .btn-glass{
    background:rgba(255,255,255,0.08);
    border:1px solid rgba(255,255,255,0.15);
    backdrop-filter:blur(10px);
    border-radius:12px;
    color:#ffcc00;
    font-weight:600;
    padding:10px 20px;
    cursor:pointer;
    transition:all .3s ease;
  }
  .btn-glass:hover{
    background:rgba(255,255,255,0.12);
    border-color:rgba(255,204,0,0.4);
    transform:translateY(-1px);
    box-shadow:0 0 15px rgba(255,204,0,0.2);
  }

  .btn-disabled{
    background:rgba(255,255,255,0.06);
    color:#777;border:none;
    border-radius:10px;padding:10px 20px;
    cursor:not-allowed;
  }

  .soon-badge{
    position:absolute;top:10px;right:12px;
    background:rgba(255,255,255,0.09);
    color:#9a9a9a;
    font-size:.72rem;
    padding:4px 10px;
    border-radius:8px;
    text-transform:uppercase;
  }

  @media (max-width:1250px){
    .api-grid{grid-template-columns:repeat(3,minmax(260px,1fr));}
  }
  @media (max-width:950px){
    .api-grid{grid-template-columns:repeat(2,minmax(260px,1fr));}
  }
  @media (max-width:620px){
    .api-grid{grid-template-columns:1fr;width:92%;}
    .api-header{width:92%;}
  }
</style>
