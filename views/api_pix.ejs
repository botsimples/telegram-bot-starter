<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <title>API PIX</title>
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="bg-hot-bg text-slate-100 min-h-screen">
  <div class="max-w-6xl mx-auto py-10 px-4">
    <h1 class="text-2xl font-semibold mb-6">⚡ API PIX</h1>

    <!-- Prioridade -->
    <div class="panel p-5 mb-8">
      <h2 class="text-lg font-medium mb-4">Ordem de Prioridade</h2>
      <div class="grid gap-3 md:grid-cols-3">
        <select id="p1" class="input">
          <option value="">Nenhum</option>
          <% apipix.gateways.forEach(g => { %><option value="<%= g.name %>" <%= apipix.priority?.primary===g.name ? 'selected' : '' %>><%= g.name %></option><% }) %>
        </select>
        <select id="p2" class="input">
          <option value="">Nenhum</option>
          <% apipix.gateways.forEach(g => { %><option value="<%= g.name %>" <%= apipix.priority?.secondary===g.name ? 'selected' : '' %>><%= g.name %></option><% }) %>
        </select>
        <select id="p3" class="input">
          <option value="">Nenhum</option>
          <% apipix.gateways.forEach(g => { %><option value="<%= g.name %>" <%= apipix.priority?.tertiary===g.name ? 'selected' : '' %>><%= g.name %></option><% }) %>
        </select>
      </div>
      <button class="btn mt-4" onclick="savePriority()">Salvar Prioridade</button>
    </div>

    <!-- Gateways -->
    <div class="panel p-5">
      <h2 class="text-lg font-medium mb-4">Chaves de API</h2>

      <!-- Add -->
      <div class="grid gap-3 md:grid-cols-4 mb-4">
        <input id="gw_name" class="input" placeholder="Nome (ex: WiinPay)" />
        <input id="gw_id" class="input" placeholder="Client ID" />
        <input id="gw_secret" class="input" placeholder="Client Secret" />
        <input id="gw_token" class="input" placeholder="Token (opcional)" />
      </div>
      <button class="btn mb-6" onclick="addGateway()">Adicionar Gateway</button>

      <!-- List -->
      <div class="space-y-3">
        <% apipix.gateways.forEach(g => { %>
          <div class="border border-white/10 rounded-lg p-3">
            <div class="font-semibold mb-2"><%= g.name %> <span class="text-xs text-white/50"><%= g.active ? '🟢 ativo' : '🔴 inativo' %></span></div>
            <div class="grid gap-2 md:grid-cols-4">
              <input class="input" id="id_<%= g._id %>" value="<%= g.clientId %>" placeholder="Client ID" />
              <input class="input" id="sec_<%= g._id %>" value="<%= g.clientSecret %>" placeholder="Client Secret" />
              <input class="input" id="tok_<%= g._id %>" value="<%= g.token %>" placeholder="Token (opcional)" />
              <select class="input" id="act_<%= g._id %>">
                <option value="false" <%= !g.active ? 'selected' : '' %>>Inativo</option>
                <option value="true" <%= g.active ? 'selected' : '' %>>Ativo</option>
              </select>
            </div>
            <div class="mt-3 flex gap-2">
              <button class="btn" onclick="saveGw('<%= g._id %>')">Salvar</button>
              <button class="btn bg-red-500 hover:bg-red-400" onclick="delGw('<%= g._id %>')">Excluir</button>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <script>
    async function addGateway() {
      const body = {
        name: document.getElementById('gw_name').value.trim(),
        clientId: document.getElementById('gw_id').value.trim(),
        clientSecret: document.getElementById('gw_secret').value.trim(),
        token: document.getElementById('gw_token').value.trim(),
      };
      if (!body.name) return alert('Informe o nome do gateway.');
      const r = await fetch('/api-pix/gateways', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      if (r.ok) location.reload(); else alert('Erro ao criar gateway');
    }
    async function saveGw(id) {
      const body = {
        clientId: document.getElementById('id_' + id).value,
        clientSecret: document.getElementById('sec_' + id).value,
        token: document.getElementById('tok_' + id).value,
        active: document.getElementById('act_' + id).value === 'true'
      };
      const r = await fetch('/api-pix/gateways/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      if (r.ok) location.reload(); else alert('Erro ao salvar gateway');
    }
    async function delGw(id) {
      if (!confirm('Excluir este gateway?')) return;
      const r = await fetch('/api-pix/gateways/' + id, { method:'DELETE' });
      if (r.ok) location.reload();
    }
    async function savePriority() {
      const body = {
        primary: document.getElementById('p1').value,
        secondary: document.getElementById('p2').value,
        tertiary: document.getElementById('p3').value,
      };
      const r = await fetch('/api-pix/priority', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      if (r.ok) alert('Prioridade salva!'); else alert('Erro ao salvar prioridade');
    }
  </script>
</body>
</html>
