      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('ParadisePag')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('ParadisePag', this)">
          <span class="slider"></span>
