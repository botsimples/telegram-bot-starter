    <div class="api-card">
      <img src="https://i.ibb.co/TLvgdVJ/paradisepag.png" alt="ParadisePag" class="api-logo">
      <h3>ParadisePag</h3>
      <button class="btn-glass" onclick="openGatewayModal('ParadisePag')">Integrar</button>
    </div>

    <div class="api-card">
      <img src="https://i.ibb.co/MpZ3c8m/oasyfy.png" alt="OasyFy" class="api-logo">
      <h3>OasyFy</h3>
      <button class="btn-glass" onclick="openGatewayModal('OasyFy')">Integrar</button>
    </div>

    <div class="api-card">
      <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" alt="PushinPay" class="api-logo">
      <h3>PushinPay</h3>
      <button class="btn-glass" onclick="openGatewayModal('PushinPay')">Integrar</button>
    </div>

    <div class="api-card">
      <img src="https://i.ibb.co/Wkmpmfn/syncpay.png" alt="Sync Pay" class="api-logo">
      <h3>Sync Pay</h3>
      <button class="btn-glass" onclick="openGatewayModal('Sync Pay')">Integrar</button>
    </div>

    <div class="api-card">
      <img src="https://i.ibb.co/jvYkkwm/hoopay.png" alt="Hoopay" class="api-logo">
      <h3>Hoopay</h3>
      <button class="btn-glass" onclick="openGatewayModal('Hoopay')">Integrar</button>
    </div>

    <div class="api-card soon">
      <div class="soon-badge">EM BREVE</div>
      <img src="https://i.ibb.co/xXW6yVy/zeroone.png" alt="ZeroOnePay" class="api-logo">
      <h3>ZeroOnePay</h3>
      <button class="btn-disabled" disabled>Em breve</button>
    </div>

    <div class="api-card soon">
      <div class="soon-badge">EM BREVE</div>
      <img src="https://i.ibb.co/x1bfG8L/horsepay.png" alt="HorsePay" class="api-logo">
      <h3>HorsePay</h3>
      <button class="btn-disabled" disabled>Em breve</button>
    </div>
  </div>
</main>

<!-- MODAL DE INTEGRAÇÃO -->
<div id="gatewayModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span class="close" onclick="closeGatewayModal()">&times;</span>
    <h2 id="gatewayTitle">Integração</h2>

    <p class="modal-sub">Preencha as credenciais do gateway selecionado abaixo.</p>

    <form id="gatewayForm">
      <label>Token API (obrigatório)</label>
      <input type="text" id="tokenApi" placeholder="Insira o token da API" required>

      <label>Client ID (opcional)</label>
      <input type="text" id="clientId" placeholder="Insira o Client ID (se houver)">

      <label>Client Secret (opcional)</label>
      <input type="text" id="clientSecret" placeholder="Insira o Client Secret (se houver)">

      <button type="submit" class="btn-save">Salvar Integração</button>
    </form>
  </div>
</div>

<script>
function openGatewayModal(name) {
  document.getElementById('gatewayTitle').innerText = "Integração • " + name;
  document.getElementById('gatewayModal').style.display = 'flex';

  // Configuração inicial: WiinPay tem token obrigatório
  const token = document.getElementById('tokenApi');
  if (name === 'WiinPay') token.required = true;
  else token.required = false;
}

function closeGatewayModal() {
  document.getElementById('gatewayModal').style.display = 'none';
}

document.getElementById('gatewayForm').addEventListener('submit', function(e) {
  e.preventDefault();
  const data = {
    token: document.getElementById('tokenApi').value,
    clientId: document.getElementById('clientId').value,
    clientSecret: document.getElementById('clientSecret').value
  };
  console.log("Credenciais salvas:", data);
  closeGatewayModal();
});
</script>

<style>
html,body{
  background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;
  margin:0;padding:0;-webkit-font-smoothing:antialiased;
}
*{box-sizing:border-box;}::-webkit-scrollbar{display:none;}

.api-pix-page{padding:60px 0 120px 0;display:flex;flex-direction:column;align-items:center;}
.api-header{width:85%;max-width:1300px;margin-bottom:30px;}
.api-header h1{color:#ffcc00;font-size:2rem;margin:0 0 8px;}
.api-header p{color:#b4b4b4;margin:0;}
.api-grid{width:85%;max-width:1300px;display:grid;grid-template-columns:repeat(4,minmax(260px,1fr));gap:28px;}

.api-card{
  position:relative;height:240px;background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,204,0,0.12);border-radius:14px;
  padding:42px 24px 25px;display:flex;flex-direction:column;
  align-items:center;justify-content:space-between;text-align:center;
  transition:.25s ease;
}
.api-card:hover{background:rgba(255,255,255,0.05);box-shadow:0 0 16px rgba(255,204,0,0.22);}
.api-logo{width:66px;height:66px;object-fit:contain;border-radius:10px;background:#111;padding:6px;}
.api-card h3{margin:10px 0 0;font-size:1rem;color:#ffcc00;font-weight:600;}
.badge-top1{position:absolute;top:-12px;left:50%;transform:translateX(-50%);
  background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;font-weight:800;
  font-size:.75rem;border-radius:10px;padding:6px 12px;display:flex;align-items:center;gap:6px;}
.fire{animation:flame .9s infinite alternate ease-in-out}
@keyframes flame{from{transform:translateY(0)}to{transform:translateY(-2px) scale(1.05)}}
.btn-glass{
  background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);
  backdrop-filter:blur(10px);border-radius:12px;color:#ffcc00;
  font-weight:600;padding:10px 20px;cursor:pointer;transition:all .3s ease;
}
.btn-glass:hover{background:rgba(255,255,255,0.12);border-color:rgba(255,204,0,0.4);
  transform:translateY(-1px);box-shadow:0 0 15px rgba(255,204,0,0.2);}
.btn-disabled{background:rgba(255,255,255,0.06);color:#777;border:none;
  border-radius:10px;padding:10px 20px;cursor:not-allowed;}
.soon-badge{position:absolute;top:10px;right:12px;background:rgba(255,255,255,0.09);
  color:#9a9a9a;font-size:.72rem;padding:4px 10px;border-radius:8px;text-transform:uppercase;}

/* Modal */
.modal-overlay{
  position:fixed;top:0;left:0;width:100%;height:100%;
  background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);
  display:flex;align-items:center;justify-content:center;z-index:1000;
}
.modal-content{
  background:rgba(20,20,20,0.85);border:1px solid rgba(255,204,0,0.15);
  border-radius:16px;padding:35px 40px;width:95%;max-width:460px;
  box-shadow:0 0 25px rgba(255,204,0,0.1);position:relative;
}
.close{position:absolute;top:10px;right:18px;font-size:1.8rem;cursor:pointer;color:#ffcc00;}
.modal-content h2{color:#ffcc00;margin:0 0 8px;}
.modal-sub{color:#b4b4b4;margin-bottom:20px;font-size:.9rem;}
form label{display:block;color:#ffcc00;margin-top:10px;font-size:.9rem;}
form input{
  width:100%;padding:10px;margin-top:5px;border-radius:8px;
  border:1px solid rgba(255,204,0,0.2);
  background:rgba(255,255,255,0.04);color:#fff;font-size:.9rem;
}
.btn-save{
  margin-top:22px;width:100%;
  background:linear-gradient(90deg,#ffcc00,#d4a100);
  color:#000;font-weight:700;border:none;border-radius:10px;
  padding:12px;cursor:pointer;transition:filter .3s;
}
.btn-save:hover{filter:brightness(1.1);}
</style>
