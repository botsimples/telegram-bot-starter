<style>
  html,body{
    background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;
    margin:0;padding:0;-webkit-font-smoothing:antialiased;
  }
  *{box-sizing:border-box;}::-webkit-scrollbar{display:none;}

  /* Centralização exata (alinha com dashboard/ofertas) */
  .api-pix-page{
    padding:60px 0 120px 0;
    display:flex;flex-direction:column;align-items:center;
  }
  .api-header{width:85%;max-width:1300px;margin-bottom:30px;}
  .api-header h1{color:#ffcc00;font-size:2rem;margin:0 0 8px;}
  .api-header p{color:#b4b4b4;margin:0;}

  /* Grid com “toque esticado” igual WiinPay */
  .api-grid{
    width:85%;max-width:1300px;
    display:grid;
    grid-template-columns:repeat(4, minmax(260px, 1fr));
    gap:28px;
    justify-items:stretch;
  }

  /* Card base */
  .api-card{
    position:relative;
    height:230px; /* altura uniforme, sensação de card esticado */
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,204,0,0.12);
    border-radius:14px;
    padding:48px 24px 22px; /* espaço p/ badge sem colidir com o logo */
    display:flex;flex-direction:column;align-items:center;justify-content:space-between;
    text-align:center;transition:.25s ease;
  }
  .api-card:hover{
    background:rgba(255,255,255,0.05);
    box-shadow:0 0 16px rgba(255,204,0,0.22);
    transform:translateY(-3px);
  }

  /* Badge TOP 1 (agora não sobrepõe mais o logo) */
  .badge-top1{
    position:absolute;top:-12px;left:50%;transform:translateX(-50%);
    background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;
    font-weight:800;font-size:.75rem;border-radius:10px;
    padding:6px 12px;display:flex;align-items:center;gap:6px;
    box-shadow:0 8px 18px rgba(255,204,0,0.25);
    white-space:nowrap;
  }
  .fire{animation:flame .9s infinite alternate ease-in-out}
  @keyframes flame{from{transform:translateY(0)}to{transform:translateY(-2px) scale(1.05)}}

  /* Destaque do card TOP 1 */
  .top1{border-color:rgba(255,204,0,0.35);background:rgba(255,255,255,0.04)}

  /* Logos */
  .api-logo{
    width:66px;height:66px;object-fit:contain;border-radius:10px;
    background:#111;padding:6px;
  }

  /* Botões */
  .btn-access{
    display:inline-flex;align-items:center;gap:8px;
    background:linear-gradient(90deg,#ffcc00,#d4a100);
    color:#000;border:none;border-radius:10px;
    padding:10px 18px;font-weight:800;cursor:pointer;
    transition:transform .15s ease, filter .2s;
  }
  .btn-access:hover{filter:brightness(1.05);transform:translateY(-1px)}
  .btn-disabled{
    background:rgba(255,255,255,0.07);color:#777;border:none;
    border-radius:10px;padding:10px 18px;cursor:not-allowed;
  }

  /* Em breve */
  .soon{opacity:.85}
  .soon-badge{
    position:absolute;top:10px;right:12px;
    background:rgba(255,255,255,0.09);color:#9a9a9a;
    font-size:.72rem;padding:4px 10px;border-radius:8px;text-transform:uppercase;
  }

  /* Responsivo */
  @media (max-width:1250px){
    .api-grid{grid-template-columns:repeat(3, minmax(260px,1fr));}
  }
  @media (max-width:950px){
    .api-grid{grid-template-columns:repeat(2, minmax(260px,1fr));}
  }
  @media (max-width:620px){
    .api-grid{grid-template-columns:1fr;width:92%}
    .api-header{width:92%}
  }
</style>
