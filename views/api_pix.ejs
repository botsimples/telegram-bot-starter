    <div class="api-card" data-gateway="Hoopay">
      <img src="https://i.ibb.co/jvYkkwm/hoopay.png" class="api-logo">
      <h3>Hoopay</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('Hoopay')">Integrar</button>
