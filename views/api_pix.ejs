        </label>
      </div>
    </div>

    <div class="api-card" data-gateway="SyncPay">
      <img src="https://i.ibb.co/Wkmpmfn/syncpay.png" class="api-logo">
      <h3>SyncPay</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('SyncPay')">Integrar</button>
