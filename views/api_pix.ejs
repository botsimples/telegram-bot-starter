<%- include('partials/visual_hottrack') %>

<main class="api-pix-page">
  <header class="api-header">
    <h1>API PIX</h1>
    <p>Integre gateways de pagamento ao TigerFy com facilidade.</p>
  </header>

  <div class="api-grid" id="gatewayGrid">
    <div class="api-card top1" data-gateway="WiinPay">
      <div class="badge-top1"><span class="fire">🔥</span> TOP 1 • RECOMENDADO</div>
      <img src="https://i.ibb.co/VNDsN1T/wiinpay.png" class="api-logo">
      <h3>WiinPay</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('WiinPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('WiinPay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="api-card" data-gateway="ParadisePag">
      <img src="https://i.ibb.co/TLvgdVJ/paradisepag.png" class="api-logo">
      <h3>ParadisePag</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('ParadisePag')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('ParadisePag', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="api-card" data-gateway="OasyFy">
      <img src="https://i.ibb.co/MpZ3c8m/oasyfy.png" class="api-logo">
      <h3>OasyFy</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('OasyFy')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('OasyFy', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="api-card" data-gateway="PushinPay">
      <img src="https://i.ibb.co/gJ2vHtH/pushinpay.png" class="api-logo">
      <h3>PushinPay</h3>
      <div class="action-row">
        <button class="btn-glass" onclick="openGatewayModal('PushinPay')">Integrar</button>
        <label class="switch">
          <input type="checkbox" onchange="activateGateway('PushinPay', this)">
          <span class="slider"></span>
        </label>
      </div>
    </div>

    <div class="api-card soon" data-gateway="ZeroOnePay">
      <div class="soon-badge">EM BREVE</div>
      <img src="https://i.ibb.co/xXW6yVy/zeroone.png" class="api-logo">
      <h3>ZeroOnePay</h3>
      <div class="action-row">
        <button class="btn-disabled" disabled>Em breve</button>
      </div>
    </div>
  </div>
</main>

<!-- Modal de Integração -->
<div id="gatewayModal" class="modal-overlay" style="display:none;">
  <div class="modal-content">
    <span class="close" onclick="closeGatewayModal()">&times;</span>
    <h2 id="gatewayTitle">Integração</h2>
    <p class="modal-sub">Preencha as credenciais do gateway abaixo:</p>
    <form id="gatewayForm">
      <label>Token API (obrigatório)</label>
      <input type="text" id="tokenApi" placeholder="Insira o token da API" required>
      <label>Client ID (opcional)</label>
      <input type="text" id="clientId" placeholder="Insira o Client ID (se houver)">
      <label>Client Secret (opcional)</label>
      <input type="text" id="clientSecret" placeholder="Insira o Client Secret (se houver)">
      <button type="submit" class="btn-save">Salvar Integração</button>
    </form>
  </div>
</div>

<script>
function openGatewayModal(name) {
  document.getElementById('gatewayTitle').innerText = "Integração • " + name;
  document.getElementById('gatewayModal').style.display = 'flex';
}
function closeGatewayModal() {
  document.getElementById('gatewayModal').style.display = 'none';
}

// Ativação única
function activateGateway(gateway, checkbox) {
  const allSwitches = document.querySelectorAll('.switch input');
  allSwitches.forEach(s => {
    if (s !== checkbox) s.checked = false;
  });

  const cards = document.querySelectorAll('.api-card');
  cards.forEach(card => {
    if (card.dataset.gateway === gateway && checkbox.checked) {
      card.classList.add('active');
    } else {
      card.classList.remove('active');
    }
  });

  console.log(`Gateway ativo: ${checkbox.checked ? gateway : 'nenhum'}`);
}
</script>

<style>
html,body{background:#0a0a0a;color:#fff;font-family:'Inter',sans-serif;margin:0;padding:0;}
*{box-sizing:border-box;}::-webkit-scrollbar{display:none;}

.api-pix-page{padding:60px 0 120px 0;display:flex;flex-direction:column;align-items:center;}
.api-header{width:85%;max-width:1300px;margin-bottom:30px;}
.api-header h1{color:#ffcc00;font-size:2rem;margin:0 0 8px;}
.api-header p{color:#b4b4b4;margin:0;}
.api-grid{width:85%;max-width:1300px;display:grid;grid-template-columns:repeat(4,minmax(260px,1fr));gap:28px;}

.api-card{
  position:relative;height:250px;background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,204,0,0.12);border-radius:14px;
  padding:42px 24px 25px;display:flex;flex-direction:column;
  align-items:center;justify-content:space-between;text-align:center;
  transition:.25s ease;
}
.api-card:hover{background:rgba(255,255,255,0.05);}
.api-card.active{box-shadow:0 0 25px rgba(255,204,0,0.4);border-color:#ffcc00;}
.api-logo{width:66px;height:66px;object-fit:contain;border-radius:10px;background:#111;padding:6px;}
.api-card h3{margin:10px 0 0;font-size:1rem;color:#ffcc00;font-weight:600;}
.badge-top1{position:absolute;top:-12px;left:50%;transform:translateX(-50%);
  background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;font-weight:800;
  font-size:.75rem;border-radius:10px;padding:6px 12px;display:flex;align-items:center;gap:6px;}
.fire{animation:flame .9s infinite alternate ease-in-out}
@keyframes flame{from{transform:translateY(0)}to{transform:translateY(-2px) scale(1.05)}}

.action-row{display:flex;align-items:center;gap:12px;justify-content:center;}
.btn-glass{
  background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);
  backdrop-filter:blur(10px);border-radius:12px;color:#ffcc00;
  font-weight:600;padding:10px 20px;cursor:pointer;transition:all .3s ease;
}
.btn-glass:hover{background:rgba(255,255,255,0.12);border-color:rgba(255,204,0,0.4);}
.switch{position:relative;display:inline-block;width:40px;height:20px;}
.switch input{opacity:0;width:0;height:0;}
.slider{
  position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;
  background-color:rgba(255,255,255,0.1);transition:.4s;border-radius:34px;
}
.slider:before{
  position:absolute;content:"";height:14px;width:14px;left:3px;bottom:3px;
  background-color:#ffcc00;transition:.4s;border-radius:50%;
}
input:checked + .slider{background-color:#ffcc00;}
input:checked + .slider:before{transform:translateX(20px);background:#000;}
</style>
