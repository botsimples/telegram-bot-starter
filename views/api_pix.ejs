    <div class="api-card soon" data-gateway="ZeroOnePay">
      <div class="soon-badge">EM BREVE</div>
      <img src="https://i.ibb.co/xXW6yVy/zeroone.png" class="api-logo">
      <h3>ZeroOnePay</h3>
      <button class="btn-disabled" disabled>Em breve</button>
