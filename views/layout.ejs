<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <!-- Tema principal (AGORA UNIFICADO: theme.gold.css + tigerfy.css) -->
  <link rel="stylesheet" href="/css/theme.gold.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    /* =======================
       FUNDO PREMIUM PONTILHADO
    ======================= */
    body {
      margin: 0;
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;

      background-color: #050505;
      background-image:
        radial-gradient(circle at 0 0, rgba(255, 204, 0, 0.18) 0, transparent 55%),
        radial-gradient(circle at 100% 0, rgba(255, 204, 0, 0.09) 0, transparent 55%),
        radial-gradient(circle at 50% 100%, rgba(255, 204, 0, 0.11) 0, transparent 55%),
        radial-gradient(circle, rgba(255, 204, 0, 0.12) 1px, transparent 0);
      background-repeat: no-repeat, no-repeat, no-repeat, repeat;
      background-size: auto, auto, auto, 4px 4px;
      display: flex;
    }

    /* força sempre tema escuro no HTML raiz */
    html, body {
      background-color: #050505;
    }

    /* Remove quaisquer toggles de tema que existam em algum lugar */
    .theme-toggle,
    #themeToggle,
    #theme-toggle,
    .mode-toggle,
    [data-theme-toggle] {
      display: none !important;
      visibility: hidden !important;
    }

    /* Ajuste pra garantir que o conteúdo principal respeite a margem da sidebar
       (o grid e os detalhes vêm do CSS unificado) */
    .main-content {
      min-height: 100vh;
      box-sizing: border-box;
    }

    /* =======================
       LOADER TOPO DIREITO
    ======================= */
    #loaderBox {
      position: fixed;
      top: 24px;
      right: 32px;
      padding: 8px 18px;
      background: rgba(0, 0, 0, 0.78);
      border: 1px solid rgba(255, 204, 0, 0.4);
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #ffcc00;
      backdrop-filter: blur(6px);
      display: none;
      z-index: 9999;
      min-width: 150px;
      text-align: center;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    #loaderBox.success {
      color: #ffe46a;
      border-color: rgba(255, 215, 0, 0.85);
    }
  </style>
</head>

<body>
  <!-- LOADER -->
  <div id="loaderBox">Processando…</div>

  <script>
    // animação do loader rápido ao carregar a página
    document.addEventListener("DOMContentLoaded", () => {
      const loader = document.getElementById("loaderBox");
      if (!loader) return;

      loader.style.display = "block";
      loader.textContent = "Processando…";
      loader.classList.remove("success");

      requestAnimationFrame(() => {
        loader.style.opacity = "1";

        setTimeout(() => {
          loader.textContent = "Concluído!";
          loader.classList.add("success");

          setTimeout(() => {
            loader.style.opacity = "0";
            setTimeout(() => loader.style.display = "none", 300);
          }, 900);
        }, 900);
      });
    });
  </script>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <!-- LOGO SVG DO TIGRE -->
      <div class="logo-mark">
        <svg viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="29" cy="29" r="27" stroke="#FFCC00" stroke-width="3"/>
          <path d="M20.5 34C20.5 28 24 23 29 23C34 23 37.5 28 37.5 34"
                stroke="#FFCC00" stroke-width="3" stroke-linecap="round"/>
          <path d="M23 28C23 26 24.5 24.5 26.5 24.5"
                stroke="#FFCC00" stroke-width="3" stroke-linecap="round"/>
          <path d="M35 28C35 26 33.5 24.5 31.5 24.5"
                stroke="#FFCC00" stroke-width="3" stroke-linecap="round"/>
          <circle cx="25.5" cy="31.5" r="1.5" fill="#FFCC00"/>
          <circle cx="32.5" cy="31.5" r="1.5" fill="#FFCC00"/>
        </svg>
      </div>

      <div class="brand-name">TigerFy</div>
    </div>

    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Dashboard
      </a>

      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Ofertas
      </a>

      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Adquirentes
      </a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4s-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 1.79-8 4v2h16v-2c0-2.21-3.58-4-8-4z"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Perfil
      </a>

      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path d="M8 4h8v3a4 4 0 01-4 4 4 4 0 01-4-4V4z" stroke-width="1.8"
                stroke-linecap="round" stroke-linejoin="round" />
          <path d="M6 4h12" stroke-width="1.8" stroke-linecap="round" />
          <path d="M9 15h6" stroke-width="1.8" stroke-linecap="round" />
          <path d="M10 19h4" stroke-width="1.8" stroke-linecap="round" />
          <path d="M5 7a3 3 0 003 3" stroke-width="1.5" stroke-linecap="round" />
          <path d="M19 7a3 3 0 01-3 3" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        Conquistas
      </a>

      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy⚡" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 20.5c4.694 0 8.5-3.806 8.5-8.5S16.694 3.5 12 3.5 3.5 7.306 3.5 12c0 1.293.293 2.517.818 3.607L3 21l5.548-1.414A8.468 8.468 0 0012 20.5z"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Suporte
      </a>
    </nav>

    <div class="menu-bottom">
      <a href="/logout">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Sair
      </a>
    </div>
  </aside>

  <main class="main-content">
    <%- body %>
  </main>

  <script>
    // Pré-carrega páginas internas pra navegação parecer instantânea
    document.addEventListener("DOMContentLoaded", () => {
      const links = document.querySelectorAll('a[href^="/"]');

      links.forEach(link => {
        const url = link.getAttribute("href");
        if (!url || url === window.location.pathname) return;

        fetch(url, { method: "GET" })
          .then(() => console.log("Pré-carregado:", url))
          .catch(() => {});
      });
    });
  </script>

  <!-- Dependências JS do painel -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/tigerfy.js"></script>
</body>
</html>
