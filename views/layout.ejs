<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title><%= title || "Painel BotSimples" %></title>
  <link rel="stylesheet" href="/css/output.css">
  <style>
    body {
      background: #0f0f10;
      color: #e2e2e2;
      font-family: 'Inter', sans-serif;
      display: flex;
      margin: 0;
    }

    /* Sidebar */
    .sidebar {
      width: 230px;
      background: #131316;
      height: 100vh;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: fixed;
      left: 0;
      top: 0;
      border-right: 1px solid #25252a;
    }

    .sidebar h1 {
      color: #ffcc00;
      font-size: 20px;
      text-align: center;
      margin-bottom: 40px;
    }

    .sidebar a {
      display: block;
      color: #cfcfcf;
      text-decoration: none;
      margin: 10px 0;
      padding: 10px;
      border-radius: 6px;
      transition: 0.2s;
    }

    .sidebar a:hover, .sidebar a.active {
      background: #1e1e25;
      color: #ffcc00;
    }

    /* Conteúdo */
    .content {
      margin-left: 230px;
      flex: 1;
      padding: 40px;
      min-height: 100vh;
      opacity: 0;
      animation: fadeIn 0.6s ease forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); opacity: 1; }
    }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div>
      <h1>⚙️ BotSimples</h1>
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">🏠 Dashboard</a>
      <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">📦 Planos</a>
      <a href="/bots" class="<%= path === '/bots' ? 'active' : '' %>">🤖 Bots</a>
      <a href="/api-pix" class="<%= path === '/api-pix' ? 'active' : '' %>">💸 Gateways</a>
    </div>
    <div>
      <a href="/login">🚪 Sair</a>
    </div>
  </aside>

  <main class="content">
    <%- body %>
  </main>
</body>
</html>
