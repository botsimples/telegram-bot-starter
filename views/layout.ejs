<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --gold1: #ffcc00;
      --gold2: #d4a100;
      --bg: #000;
      --muted: #b4b4b4;
      --divider: rgba(255, 204, 0, 0.08);
      --hover: rgba(255, 204, 0, 0.07);
    }

    body {
      margin: 0;
      display: flex;
      background: var(--bg);
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .sidebar {
      width: 260px;
      background: #000;
      border-right: 1px solid var(--divider);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      padding-top: 24px;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 24px 24px;
    }

    .logo-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: url('/img/tigerfy-icon.png') center/cover no-repeat;
      flex-shrink: 0;
    }

    .logo-text {
      font-family: "Poppins", sans-serif;
      font-weight: 700;
      font-size: 1.3rem;
      background: linear-gradient(90deg, var(--gold1), var(--gold2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: goldshine 3s infinite linear;
    }

    @keyframes goldshine {
      0% { background-position: 0% 50%; }
      100% { background-position: 200% 50%; }
    }

    .menu {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 10px 20px 0;
      flex-grow: 1;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 18px;
      border-radius: 8px;
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.25s ease;
      position: relative;
      font-size: 0.95rem;
    }

    .menu a svg {
      width: 18px;
      height: 18px;
      stroke: var(--muted);
      stroke-width: 1.8;
      transition: stroke 0.25s ease, transform 0.2s ease;
    }

    .menu a:hover {
      background: var(--hover);
      color: var(--gold1);
    }

    .menu a:hover svg {
      stroke: var(--gold1);
      transform: scale(1.1);
    }

    .menu a.active {
      background: linear-gradient(90deg, rgba(255, 204, 0, 0.1), rgba(255, 204, 0, 0.05));
      color: var(--gold1);
      box-shadow: inset 0 0 8px rgba(255, 204, 0, 0.15);
      font-weight: 600;
    }

    .menu-divider {
      height: 1px;
      width: calc(100% - 40px);
      background: linear-gradient(to right, rgba(255, 204, 0, 0.05), rgba(255, 204, 0, 0.25), rgba(255, 204, 0, 0.05));
      margin: 18px auto;
    }

    .menu-bottom {
      margin-top: auto;
      padding: 20px 25px 30px;
    }

    .menu-bottom a {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--gold1);
      font-weight: 500;
      text-decoration: none;
      opacity: 0.8;
      transition: opacity 0.3s;
    }

    .menu-bottom a svg {
      width: 18px;
      height: 18px;
      stroke: var(--gold1);
      stroke-width: 2;
    }

    .menu-bottom a:hover {
      opacity: 1;
    }

    .main-content {
      margin-left: 260px;
      flex: 1;
      padding: 40px;
      min-height: 100vh;
      box-sizing: border-box;
      position: relative;
    }

    /* Remove completamente o botão de modo claro */
    .theme-toggle {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  </style>
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="logo-icon"></div>
      <div class="logo-text">TigerFy</div>
    </div>

    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z"/>
        </svg>
        Dashboard
      </a>

      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z"/>
        </svg>
        Bots
      </a>

      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>
        </svg>
        Adquirentes
      </a>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 1.79-8 4v2h16v-2c0-2.21-3.58-4-8-4z"/>
        </svg>
        Perfil
      </a>

      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m0-4c3.314 0 6-2.686 6-6V5H6v6c0 3.314 2.686 6 6 6zM4 5h16M9 3h6"/>
        </svg>
        Conquistas
      </a>

      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy%20⚡" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.5c4.694 0 8.5-3.806 8.5-8.5S16.694 3.5 12 3.5 3.5 7.306 3.5 12c0 1.293.293 2.517.818 3.607L3 21l5.548-1.414A8.468 8.468 0 0012 20.5z"/>
        </svg>
        Suporte
      </a>
    </nav>

    <div class="menu-divider"></div>

    <div class="menu-bottom">
      <a href="/logout">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5"/>
        </svg>
        Sair
      </a>
    </div>
  </aside>

  <main class="main-content">
    <%- body %>
  </main>
</body>
</html>
