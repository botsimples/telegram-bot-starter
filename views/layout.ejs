<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | TigerFy</title>

    <!-- CSS base e tema dourado -->
    <link rel="stylesheet" href="/css/tigerfy.css" />
    <link rel="stylesheet" href="/css/deck.theme.gold.css" />

    <!-- Fonte -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --gold: #ffcc00;
        --bg-dark: #0d0d0d;
        --bg-sidebar: #111;
        --text-muted: #b3b3b3;
        --border-dark: #1c1c1c;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        background: radial-gradient(circle at top left, #111 0%, #000 100%);
        color: #fff;
        display: flex;
        min-height: 100vh;
      }

      .tigerfy-app {
        display: flex;
        width: 100%;
      }

      /* Sidebar moderna */
      .sidebar {
        width: 240px;
        background: var(--bg-sidebar);
        border-right: 1px solid var(--border-dark);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 25px 0;
      }

      .sidebar-header {
        text-align: center;
        margin-bottom: 25px;
      }

      .logo {
        font-size: 22px;
        font-weight: 800;
        color: var(--gold);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }

      .menu {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 0 20px;
      }

      .menu a {
        text-decoration: none;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 8px;
        transition: all 0.2s ease;
        font-weight: 500;
      }

      .menu a:hover {
        background: #1a1a1a;
        color: var(--gold);
      }

      .menu a.active {
        background: linear-gradient(90deg, var(--gold), #e6b800);
        color: #000;
        font-weight: 700;
      }

      .menu-divider {
        height: 1px;
        background: var(--border-dark);
        margin: 16px 0;
      }

      .sidebar-footer {
        padding: 0 20px;
      }

      .logout-btn {
        width: 100%;
        background: none;
        border: 1px solid var(--border-dark);
        color: var(--text-muted);
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.2s;
      }

      .logout-btn:hover {
        background: #1a1a1a;
        color: var(--gold);
      }

      /* Conteúdo principal */
      .main-content {
        flex: 1;
        padding: 40px;
        overflow-y: auto;
      }

      h1, h2 {
        color: var(--gold);
        font-weight: 800;
      }

      .card {
        background: #111;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 20px;
        border: 1px solid #222;
        box-shadow: 0 0 15px rgba(255, 204, 0, 0.05);
      }

      .card h3 {
        color: var(--gold);
        margin-bottom: 10px;
      }

      .card p {
        color: #ccc;
      }

      ::-webkit-scrollbar {
        width: 8px;
      }

      ::-webkit-scrollbar-thumb {
        background: var(--gold);
        border-radius: 4px;
      }
    </style>
  </head>

  <body>
    <div class="tigerfy-app fade-in">
      <% if (!title.includes('Login')) { %>
      <!-- Sidebar -->
      <aside class="sidebar">
        <div>
          <div class="sidebar-header">
            <div class="logo">⚡ <span>TigerFy</span></div>
          </div>

          <nav class="menu">
            <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">📊 <span>Deck</span></a>
            <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">🔥 <span>Ofertas</span></a>
            <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">💳 <span>Adquirentes</span></a>

            <div class="menu-divider"></div>

            <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">🏆 <span>Conquistas</span></a>
            <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">👤 <span>Meu Perfil</span></a>
          </nav>
        </div>

        <div class="sidebar-footer">
          <button onclick="window.location.href='/logout'" class="logout-btn">
            🚪 <span>Sair</span>
          </button>
        </div>
      </aside>
      <% } %>

      <!-- Main -->
      <main class="<%= title.includes('Login') ? 'login-bg' : 'main-content' %>">
        <%- body %>
      </main>
    </div>

    <script>
      function openModal(id) {
        document.getElementById(id).classList.add("active");
      }
      function closeModal(id) {
        document.getElementById(id).classList.remove("active");
      }
    </script>
  </body>
</html>
