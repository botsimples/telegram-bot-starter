<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    body {
      margin: 0;
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
      background-color: #050505;
      background-image:
        radial-gradient(circle at 0 0, rgba(255,204,0,0.18) 0, transparent 55%),
        radial-gradient(circle at 100% 0, rgba(255,204,0,0.09) 0, transparent 55%),
        radial-gradient(circle at 50% 100%, rgba(255,204,0,0.11) 0, transparent 55%),
        radial-gradient(circle, rgba(255,204,0,0.12) 1px, transparent 0);
      background-repeat: no-repeat, no-repeat, no-repeat, repeat;
      background-size: auto, auto, auto, 4px 4px;
      display: flex;
    }

    html, body {
      background-color: #050505;
    }

    /* tema claro removido */
    .theme-toggle,
    #themeToggle,
    [data-theme-toggle] {
      display: none !important;
    }

    /* SIDEBAR */
    .sidebar {
      width: 250px;
      background: #050505;
      border-right: 1px solid rgba(255, 204, 0, 0.08);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 10;
    }

    .sidebar-header {
      padding: 26px 22px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-mark svg {
      width: 42px;
      height: 42px;
    }

    .brand-name {
      font-family: "Poppins", sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      background: linear-gradient(90deg, #ffcc00, #d4a100);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .menu { display: flex; flex-direction: column; padding: 10px 20px 0; }
    .menu a {
      display: flex; align-items: center; gap: 12px;
      padding: 11px 18px; border-radius: 10px;
      text-decoration: none; color: #b4b4b4;
      transition: .25s; font-size: .95rem;
    }
    .menu a:hover { background: rgba(255,204,0,0.08); color: #ffcc00; }
    .menu a.active {
      background: rgba(255,204,0,0.14);
      color: #fff; font-weight: 600;
      box-shadow: inset 0 0 14px rgba(255,204,0,0.18);
    }

    .menu-bottom { margin-top: auto; padding: 22px 26px 24px; }

    /* MAIN CONTENT */
    .main-content {
      margin-left: 250px;
      padding: 40px;
      min-height: 100vh;
      width: 100%;
      box-sizing: border-box;
      animation: fadeIn .2s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
  </style>
</head>

<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="logo-mark">
        <img src="/img/tigerfy_logo.svg" width="42" />
      </div>
      <div class="brand-name">TigerFy</div>
    </div>

    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
        Dashboard
      </a>

      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
        Ofertas
      </a>

      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
        Adquirentes
      </a>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
        Perfil
      </a>

      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
        Conquistas
      </a>

      <a href="https://wa.me/5543999562213" target="_blank">Suporte</a>
    </nav>

    <div class="menu-bottom">
      <a href="/logout">Sair</a>
    </div>
  </aside>

  <main class="main-content">
    <%- body %>
  </main>

</body>
</html>
