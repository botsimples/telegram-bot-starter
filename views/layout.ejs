<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | TigerFy</title>

    <link rel="stylesheet" href="/css/tigerfy.css" />
    <link rel="stylesheet" href="/css/deck.theme.gold.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --gold: #ffcc00;
        --sidebar-bg: #0b0b0b;
        --hover-bg: #161616;
        --text-muted: #b4b4b4;
        --text-active: #000;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        display: flex;
        background: radial-gradient(circle at top left, #111 0%, #000 100%);
        color: #fff;
        min-height: 100vh;
      }

      .tigerfy-app {
        display: flex;
        width: 100%;
      }

      /* SIDEBAR */
      .sidebar {
        width: 250px;
        background: var(--sidebar-bg);
        border-right: 1px solid #1c1c1c;
        display: flex;
        flex-direction: column;
        padding: 25px 0 20px;
      }

      /* LOGO */
      .sidebar-header {
        padding: 0 24px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .logo-icon svg {
        width: 20px;
        height: 20px;
        stroke: var(--gold);
      }

      .logo-text {
        font-size: 20px;
        font-weight: 800;
        color: var(--gold);
        letter-spacing: 0.5px;
      }

      /* MENU */
      nav.menu {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex-grow: 1;
      }

      .menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 500;
        padding: 10px 24px;
        border-radius: 8px;
        transition: all 0.2s ease;
      }

      .menu a:hover {
        background: var(--hover-bg);
        color: var(--gold);
        box-shadow: 0 0 8px rgba(255, 204, 0, 0.15);
      }

      .menu a.active {
        background: linear-gradient(90deg, var(--gold), #e6b800);
        color: var(--text-active);
        font-weight: 600;
      }

      .menu svg {
        width: 18px;
        height: 18px;
        stroke-width: 1.8;
      }

      .menu-divider {
        height: 1px;
        background: #1c1c1c;
        margin: 15px 24px;
      }

      /* FOOTER */
      .sidebar-footer {
        padding: 0 24px;
        margin-top: 10px;
      }

      .logout-btn {
        width: 100%;
        background: none;
        border: 1px solid #2a2a2a;
        color: #aaa;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }

      .logout-btn:hover {
        background: #1a1a1a;
        color: var(--gold);
        box-shadow: 0 0 8px rgba(255, 204, 0, 0.2);
      }

      .main-content {
        flex: 1;
        padding: 40px;
        overflow-y: auto;
      }
    </style>
  </head>

  <body>
    <div class="tigerfy-app">
      <% if (!title.includes('Login')) { %>
      <aside class="sidebar">
        <div>
          <!-- LOGO -->
          <div class="sidebar-header">
            <div class="logo-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
              </svg>
            </div>
            <span class="logo-text">TigerFy</span>
          </div>

          <!-- MENU -->
          <nav class="menu">
            <!-- DASHBOARD -->
            <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z" />
              </svg>
              <span>Deck</span>
            </a>

            <!-- OFERTAS (ícone de pasta elegante) -->
            <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z" />
              </svg>
              <span>Ofertas</span>
            </a>

            <!-- ADQUIRENTES (ícone de código/programação) -->
            <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
              </svg>
              <span>Adquirentes</span>
            </a>

            <div class="menu-divider"></div>

            <!-- CONQUISTAS (troféu refinado) -->
            <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m0-4c3.314 0 6-2.686 6-6V5H6v6c0 3.314 2.686 6 6 6zM4 5h16M9 3h6" />
              </svg>
              <span>Conquistas</span>
            </a>

            <!-- PERFIL -->
            <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4s-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 1.79-8 4v2h16v-2c0-2.21-3.58-4-8-4z" />
              </svg>
              <span>Meu Perfil</span>
            </a>
          </nav>
        </div>

        <!-- FOOTER -->
        <div class="sidebar-footer">
          <button onclick="window.location.href='/logout'" class="logout-btn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5" />
            </svg>
            <span>Sair da Conta</span>
          </button>
        </div>
      </aside>
      <% } %>

      <main class="<%= title.includes('Login') ? 'login-bg' : 'main-content' %>">
        <%- body %>
      </main>
    </div>
  </body>
</html>
