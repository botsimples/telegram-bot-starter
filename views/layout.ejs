<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --gold: #ffcc00;
      --gold-deep: #d4a100;
      --bg: #000000;
      --muted: #b4b4b4;
      --divider: rgba(255, 204, 0, 0.08);
      --hover: rgba(255, 204, 0, 0.07);
    }

    body {
      margin: 0;
      display: flex;
      background: var(--bg);
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    /* SIDEBAR */
    .sidebar {
      width: 250px;
      background: #000;
      border-right: 1px solid var(--divider);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 10;
    }

    /* LOGO */
    .sidebar-header {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 28px 0 24px;
    }

    .logo-img {
      width: 140px;
      height: auto;
      object-fit: contain;
      filter: none;
      transition: transform 0.3s ease;
    }

    .logo-img:hover {
      transform: scale(1.05);
    }

    /* MENU */
    .menu {
      display: flex;
      flex-direction: column;
      padding: 10px 20px 0;
      flex-grow: 1;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 18px;
      border-radius: 8px;
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.25s ease;
      position: relative;
    }

    .menu a svg {
      width: 18px;
      height: 18px;
      stroke: var(--muted);
      stroke-width: 1.8;
      transition: stroke 0.25s ease;
    }

    .menu a:hover {
      background: var(--hover);
      color: var(--gold);
    }

    .menu a:hover svg {
      stroke: var(--gold);
    }

    .menu a.active {
      background: linear-gradient(90deg, rgba(255, 204, 0, 0.12), rgba(255, 204, 0, 0.05));
      color: #fff;
      font-weight: 600;
      box-shadow: inset 0 0 10px rgba(255, 204, 0, 0.15);
    }

    .menu a.active::before {
      content: "";
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 2px;
      background: linear-gradient(to bottom, #ffea70, #ffcc00, #d3a900);
      box-shadow: 0 0 6px rgba(255, 204, 0, 0.4);
    }

    .menu-divider {
      height: 1px;
      width: calc(100% - 40px);
      background: linear-gradient(to right, rgba(255, 204, 0, 0.05), rgba(255, 204, 0, 0.25), rgba(255, 204, 0, 0.05));
      margin: 18px auto;
    }

    .menu-bottom {
      margin-top: auto;
      padding: 20px 25px 30px;
    }

    .menu-bottom a {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-weight: 500;
      text-decoration: none;
      opacity: 0.8;
      transition: opacity 0.3s;
    }

    .menu-bottom a:hover {
      opacity: 1;
    }

    .main-content {
      margin-left: 250px;
      flex: 1;
      padding: 40px;
      min-height: 100vh;
      box-sizing: border-box;
    }
  </style>
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-header">
      <img src="/img/logo-tigerfy.png" alt="TigerFy" class="logo-img" />
    </div>

    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">Dashboard</a>
      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">Ofertas</a>
      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">Adquirentes</a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">Meu Perfil</a>
      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">Conquistas</a>
      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy%20⚡" target="_blank">Suporte</a>
    </nav>

    <div class="menu-bottom">
      <a href="/logout">Sair</a>
    </div>
  </aside>

  <main class="main-content">
    <%- body %>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      requestAnimationFrame(() => { document.body.style.opacity = "1"; });
    });
  </script>

  <!-- ⚡ Navegação instantânea -->
  <script src="https://cdn.jsdelivr.net/npm/instant.page@5.2.0/instantpage.min.js" type="module"></script>
</body>
</html>
