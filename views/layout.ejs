<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | TigerFy</title>

    <!-- CSS base -->
    <link rel="stylesheet" href="/css/tigerfy.css" />
    <link rel="stylesheet" href="/css/deck.theme.gold.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --gold: #ffcc00;
        --bg-sidebar: #0d0d0d;
        --bg-hover: #1a1a1a;
        --text-muted: #b3b3b3;
        --text-active: #000;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        display: flex;
        background: radial-gradient(circle at top left, #111 0%, #000 100%);
        color: #fff;
        min-height: 100vh;
      }

      .tigerfy-app {
        display: flex;
        width: 100%;
      }

      /* Sidebar estilo HotTrack dourado */
      .sidebar {
        width: 250px;
        background: var(--bg-sidebar);
        border-right: 1px solid #1c1c1c;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 25px 0;
      }

      .sidebar-header {
        padding: 0 24px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .logo-icon {
        color: var(--gold);
        font-size: 22px;
      }

      .logo-text {
        font-size: 22px;
        font-weight: 800;
        color: var(--gold);
      }

      nav.menu {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 500;
        padding: 10px 24px;
        border-radius: 8px;
        transition: 0.2s ease;
      }

      .menu a:hover {
        background: var(--bg-hover);
        color: var(--gold);
      }

      .menu a.active {
        background: linear-gradient(90deg, var(--gold), #e6b800);
        color: var(--text-active);
        font-weight: 700;
      }

      .menu svg {
        width: 18px;
        height: 18px;
      }

      .menu-divider {
        height: 1px;
        background: #1c1c1c;
        margin: 15px 24px;
      }

      .sidebar-footer {
        padding: 0 24px;
      }

      .logout-btn {
        width: 100%;
        background: none;
        border: 1px solid #2a2a2a;
        color: #aaa;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.2s;
      }

      .logout-btn:hover {
        background: #1a1a1a;
        color: var(--gold);
      }

      .main-content {
        flex: 1;
        padding: 40px;
        overflow-y: auto;
      }
    </style>
  </head>

  <body>
    <div class="tigerfy-app">
      <% if (!title.includes('Login')) { %>
      <aside class="sidebar">
        <div>
          <div class="sidebar-header">
            <span class="logo-icon">⚡</span>
            <span class="logo-text">TigerFy</span>
          </div>

          <nav class="menu">
            <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z" />
              </svg>
              <span>Deck</span>
            </a>

            <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c1.657 0 3 1.343 3 3v2H9v-2c0-1.657 1.343-3 3-3zm0 0V4m0 7v9m8-9a8 8 0 11-16 0 8 8 0 0116 0z" />
              </svg>
              <span>Ofertas</span>
            </a>

            <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.125 1.125 0 011.592 0L21.75 12m-19.5 0l8.954 8.955a1.125 1.125 0 001.592 0L21.75 12" />
              </svg>
              <span>Adquirentes</span>
            </a>

            <div class="menu-divider"></div>

            <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m9-9H3" />
              </svg>
              <span>Conquistas</span>
            </a>

            <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 12a5 5 0 100-10 5 5 0 000 10zm7 8a7 7 0 10-14 0h14z" />
              </svg>
              <span>Meu Perfil</span>
            </a>
          </nav>
        </div>

        <div class="sidebar-footer">
          <button onclick="window.location.href='/logout'" class="logout-btn">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:16px;height:16px;margin-right:8px;">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5" />
            </svg>
            Sair
          </button>
        </div>
      </aside>
      <% } %>

      <main class="<%= title.includes('Login') ? 'login-bg' : 'main-content' %>">
        <%- body %>
      </main>
    </div>
  </body>
</html>
