<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    /* =======================
       ⚡ FUNDO PREMIUM PONTILHADO
    ======================= */
    body {
      background: #0d0d0d url('/img/pattern.png') repeat !important;
      background-size: 260px;
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* =======================
       SIDEBAR
    ======================= */
    .sidebar {
      width: 250px;
      background: #0a0a0a;
      border-right: 1px solid rgba(255, 204, 0, 0.08);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 10;
    }

    /* LOGO */
    .sidebar-header {
      padding: 25px 0 15px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    .logo-round {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #111;
      padding: 6px;
      object-fit: contain;
      box-shadow: 0 0 12px rgba(255, 204, 0, 0.25);
    }

    .brand-name {
      font-family: "Poppins", sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      background: linear-gradient(90deg, #ffcc00, #d4a100);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* MENU */
    .menu {
      display: flex;
      flex-direction: column;
      padding: 10px 20px 0;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 18px;
      border-radius: 10px;
      text-decoration: none;
      color: #b4b4b4;
      font-weight: 500;
      transition: 0.25s ease;
      font-size: 0.95rem;
    }

    .menu a svg {
      width: 19px;
      height: 19px;
      stroke: #b4b4b4;
      stroke-width: 1.8;
    }

    .menu a:hover {
      background: rgba(255, 204, 0, 0.08);
      color: #ffcc00;
    }

    .menu a:hover svg {
      stroke: #ffcc00;
    }

    .menu a.active {
      background: rgba(255, 204, 0, 0.14);
      color: #fff;
      font-weight: 600;
      box-shadow: inset 0 0 14px rgba(255, 204, 0, 0.18);
      position: relative;
    }

    .menu a.active svg {
      stroke: #ffcc00;
    }

    .menu a.active::before {
      content: "";
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      background: linear-gradient(#ffea70, #ffcc00, #d4a100);
      border-radius: 2px;
    }

    .menu-divider {
      height: 1px;
      width: 100%;
      margin: 18px 0;
      background: linear-gradient(to right, transparent, rgba(255, 204, 0, 0.25), transparent);
    }

    /* LOGOUT */
    .menu-bottom {
      margin-top: auto;
      padding: 20px 25px 30px;
    }

    .menu-bottom a {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #ffcc00;
      font-weight: 600;
      opacity: 0.85;
      transition: 0.2s;
    }

    .menu-bottom a:hover {
      opacity: 1;
    }

    .menu-bottom svg {
      width: 22px;
      height: 22px;
      stroke: #ffcc00;
    }

    /* =======================
       MAIN CONTENT
    ======================= */
    .main-content {
      margin-left: 250px;
      padding: 40px;
      min-height: 100vh;
      animation: fadeIn 0.25s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px);}
      to   { opacity: 1; transform: translateY(0);}
    }

    /* =======================
       CARREGAMENTO PREMIUM
    ======================= */
    #loaderBox {
      position: fixed;
      top: 22px;
      left: 50%;
      transform: translateX(-50%);
      padding: 8px 18px;
      background: rgba(0, 0, 0, 0.65);
      border: 1px solid rgba(255, 204, 0, 0.25);
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #ffcc00;
      backdrop-filter: blur(6px);
      display: none;
      z-index: 9999;
      animation: fadeIn .3s ease;
    }

    #loaderBox.success {
      color: #ffe46a;
      border-color: rgba(255, 215, 0, 0.4);
    }
  </style>
</head>

<body>

  <!-- LOADER -->
  <div id="loaderBox">Processando…</div>

  <script>
    // Ativa loader ao trocar rota
    document.addEventListener("DOMContentLoaded", () => {
      const loader = document.getElementById("loaderBox");

      loader.style.display = "block";

      setTimeout(() => {
        loader.innerText = "Concluído!";
        loader.classList.add("success");

        setTimeout(() => { loader.style.display = "none"; }, 700);

      }, 450);
    });
  </script>

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="sidebar-header">
      <img src="/img/logo-tigerfy.png" class="logo-round" />
      <div class="brand-name">TigerFy</div>
    </div>

    <nav class="menu">

      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Dashboard
      </a>

      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Bots
      </a>

      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M16 18l6-6-6-6M8 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Adquirentes
      </a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4s-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 1.79-8 4v2h16v-2c0-2.21-3.58-4-8-4z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Perfil
      </a>

      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M8 21h8m-4-4v4m0-4c3.314 0 6-2.686 6-6V5H6v6c0 3.314 2.686 6 6 6zM4 5h16M9 3h6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Conquistas
      </a>

      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy⚡" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 20.5c4.694 0 8.5-3.806 8.5-8.5S16.694 3.5 12 3.5 3.5 7.306 3.5 12c0 1.293.293 2.517.818 3.607L3 21l5.548-1.414A8.468 8.468 0 0012 20.5z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Suporte
      </a>

    </nav>

    <div class="menu-bottom">
      <a href="/logout">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Sair
      </a>
    </div>

  </aside>

  <main class="main-content">
    <%- body %>
  </main>

</body>
</html>
