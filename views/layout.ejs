<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | TigerFy</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
      /* ===========================================================
         ⚡ TIGERFY GLOBAL THEME — GOLD PULSE EDITION
         =========================================================== */
      :root {
        --gold: #ffcc00;
        --gold-dark: #b38f00;
        --bg-dark: #0a0a0a;
        --text-muted: #b4b4b4;
        --text-light: #fff;
        --transition: 0.25s ease;
      }

      html, body {
        margin: 0;
        padding: 0;
        font-family: "Inter", sans-serif;
        color: var(--text-light);
        background: radial-gradient(ellipse at top left, #111 0%, #000 100%);
        overflow-x: hidden;
        position: relative;
        min-height: 100vh;
      }

      /* FUNDO ANIMADO */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image:
          radial-gradient(rgba(255, 204, 0, 0.04) 1px, transparent 1px),
          radial-gradient(rgba(255, 204, 0, 0.02) 1px, transparent 1px);
        background-size: 80px 80px, 40px 40px;
        animation: starsMove 90s linear infinite;
        z-index: -2;
        opacity: 0.8;
      }
      @keyframes starsMove {
        0% { background-position: 0 0, 50px 50px; }
        100% { background-position: 500px 1000px, 550px 1050px; }
      }
      body::after {
        content: "";
        position: fixed;
        width: 800px;
        height: 800px;
        top: -300px;
        right: -300px;
        background: radial-gradient(circle, rgba(255,204,0,0.08), transparent 70%);
        filter: blur(180px);
        animation: pulseGlow 8s ease-in-out infinite alternate;
        z-index: -1;
      }
      @keyframes pulseGlow {
        0% { opacity: 0.4; transform: scale(1); }
        100% { opacity: 1; transform: scale(1.15); }
      }

      .tigerfy-app {
        display: flex;
        width: 100%;
      }

      /* SIDEBAR */
      .sidebar {
        width: 240px;
        backdrop-filter: blur(8px);
        background: rgba(10, 10, 10, 0.95);
        border-right: 1px solid rgba(255, 204, 0, 0.1);
        display: flex;
        flex-direction: column;
        padding: 30px 0;
        box-shadow: inset -1px 0 0 rgba(255, 255, 255, 0.02);
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding-left: 18px;
        margin-bottom: 26px;
      }

      .sidebar-header svg {
        width: 20px;
        height: 20px;
        stroke: var(--gold);
      }

      .sidebar-header span {
        font-size: 19px;
        font-weight: 800;
        color: var(--gold);
        letter-spacing: 0.4px;
      }

      nav.menu {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .menu a {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-weight: 500;
        padding: 10px 26px;
        border-radius: 8px;
        transition: var(--transition);
        position: relative;
      }

      .menu a:hover {
        background: rgba(255, 204, 0, 0.07);
        color: var(--gold);
      }

      .menu a.active {
        background: linear-gradient(to right, rgba(255, 204, 0, 0.15), rgba(255, 204, 0, 0.05));
        color: var(--text-light);
        font-weight: 600;
      }

      .menu a.active::before {
        content: "";
        position: absolute;
        left: 0;
        top: 6px;
        bottom: 6px;
        width: 3px;
        border-radius: 2px;
        background: linear-gradient(to bottom, #ffea70, #ffcc00, #d3a900);
        box-shadow: 0 0 6px rgba(255, 204, 0, 0.4);
      }

      .menu-divider {
        height: 1px;
        width: calc(100% - 48px);
        align-self: center;
        background: linear-gradient(to right, rgba(255, 204, 0, 0.05), rgba(255, 204, 0, 0.25), rgba(255, 204, 0, 0.05));
        margin: 16px 0;
        border-radius: 1px;
      }

      .menu svg {
        width: 18px;
        height: 18px;
        stroke-width: 1.8;
        transition: transform 0.2s ease;
      }

      .menu a:hover svg {
        transform: translateX(2px);
      }

      .main-content {
        flex: 1;
        margin-left: 240px;
        padding: 40px;
        overflow-y: auto;
        animation: fadeIn 0.8s ease;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* CARDS E PAINÉIS */
      .stat-card, .deck-card {
        background: rgba(18, 18, 18, 0.85);
        border: 1px solid rgba(255, 204, 0, 0.12);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 0 10px rgba(255, 204, 0, 0.05);
        transition: var(--transition);
      }

      .stat-card:hover, .deck-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 18px rgba(255, 204, 0, 0.15);
      }

      .stat-card h3 {
        color: #ccc;
        font-size: 13px;
        margin-bottom: 8px;
      }

      .stat-card span {
        color: var(--gold);
        font-weight: 800;
        font-size: 22px;
      }

      /* BOTÕES */
      .filter-btn {
        background: linear-gradient(135deg, var(--gold), var(--gold-dark));
        border: none;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 700;
        color: #000;
        cursor: pointer;
        box-shadow: 0 0 12px rgba(255, 204, 0, 0.3);
        transition: var(--transition);
      }

      .filter-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 20px rgba(255, 204, 0, 0.6);
      }

      /* LOGIN */
      .login-bg {
        background: radial-gradient(circle at top, #0a0a0a 0%, #000 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
      }

      .login-box {
        background: rgba(20, 20, 20, 0.9);
        border: 1px solid rgba(255, 204, 0, 0.15);
        border-radius: 12px;
        padding: 50px 60px;
        text-align: center;
        box-shadow: 0 0 25px rgba(255, 204, 0, 0.08);
        animation: fadeIn 0.8s ease;
      }

      /* SCROLLBAR */
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-thumb {
        background: var(--gold);
        border-radius: 4px;
      }
    </style>
  </head>

  <body>
    <div class="tigerfy-app">
      <% if (!title.includes('Login')) { %>
      <aside class="sidebar">
        <div class="sidebar-header">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
          <span>TigerFy</span>
        </div>

        <nav class="menu">
          <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z" />
            </svg>
            <span>Deck</span>
          </a>

          <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z" />
            </svg>
            <span>Ofertas</span>
          </a>

          <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
            </svg>
            <span>Adquirentes</span>
          </a>

          <div class="menu-divider"></div>

          <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4s-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 1.79-8 4v2h16v-2c0-2.21-3.58-4-8-4z" />
            </svg>
            <span>Meu Perfil</span>
          </a>

          <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m0-4c3.314 0 6-2.686 6-6V5H6v6c0 3.314 2.686 6 6 6zM4 5h16M9 3h6" />
            </svg>
            <span>Conquistas</span>
          </a>

          <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy%20⚡" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.5c4.694 0 8.5-3.806 8.5-8.5S16.694 3.5 12 3.5 3.5 7.306 3.5 12c0 1.293.293 2.517.818 3.607L3 21l5.548-1.414A8.468 8.468 0 0012 20.5z" />
            </svg>
            <span>Suporte</span>
          </a>

          <a href="/logout">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5" />
            </svg>
            <span>Sair</span>
          </a>
        </nav>
      </aside>
      <% } %>

      <main class="<%= title.includes('Login') ? 'login-bg' : 'main-content' %>">
        <%- body %>
      </main>
    </div>
  </body>
</html>
