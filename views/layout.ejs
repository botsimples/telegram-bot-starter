<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    body {
      margin: 0;
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
      background-color: #050505;
      background-image:
        radial-gradient(circle at 0 0, rgba(255, 204, 0, 0.18) 0, transparent 55%),
        radial-gradient(circle at 100% 0, rgba(255, 204, 0, 0.09) 0, transparent 55%),
        radial-gradient(circle at 50% 100%, rgba(255, 204, 0, 0.11) 0, transparent 55%),
        radial-gradient(circle, rgba(255, 204, 0, 0.12) 1px, transparent 0);
      background-repeat: no-repeat, no-repeat, no-repeat, repeat;
      background-size: auto, auto, auto, 4px 4px;
      display: flex;
    }

    html, body {
      background-color: #050505;
    }

    .theme-toggle,
    #themeToggle,
    .mode-toggle {
      display: none !important;
    }

    .sidebar {
      width: 250px;
      background: #050505;
      border-right: 1px solid rgba(255, 204, 0, 0.08);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 10;
    }

    .main-content {
      margin-left: 250px;
      padding: 40px;
      min-height: 100vh;
      width: 100%;
      box-sizing: border-box;
      animation: fadeIn 0.25s ease-out;
    }

    .no-sidebar {
      margin-left: 0 !important;
      width: 100% !important;
      padding: 0 !important;
    }
  </style>
</head>

<body>

  <% if (userId) { %>
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-header">

      <div class="logo-mark">
        <svg viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="29" cy="29" r="27" stroke="#FFCC00" stroke-width="3"/>
          <path d="M20.5 34C20.5 28 24 23 29 23C34 23 37.5 28 37.5 34"
                stroke="#FFCC00" stroke-width="3" stroke-linecap="round"/>
          <path d="M23 28C23 26 24.5 24.5 26.5 24.5"
                stroke="#FFCC00" stroke-width="3" stroke-linecap="round"/>
          <path d="M35 28C35 26 33.5 24.5 31.5 24.5"
                stroke="#FFCC00" stroke-width="3" stroke-linecap="round"/>
          <circle cx="25.5" cy="31.5" r="1.5" fill="#FFCC00"/>
          <circle cx="32.5" cy="31.5" r="1.5" fill="#FFCC00"/>
        </svg>
      </div>

      <div class="brand-name">TigerFy</div>
    </div>

    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">Dashboard</a>
      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">Ofertas</a>
      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">Adquirentes</a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">Perfil</a>
      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">Conquistas</a>

      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy⚡" target="_blank">Suporte</a>
    </nav>

    <div class="menu-bottom">
      <a href="/logout">Sair</a>
    </div>
  </aside>
  <% } %>

  <main class="main-content <%= userId ? '' : 'no-sidebar' %>">
    <%- body %>
  </main>

</body>
</html>
