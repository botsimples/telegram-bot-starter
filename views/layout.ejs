<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root {
      --gold: #ffcc00;
      --gold-deep: #d4a100;
      --bg: #000000;
      --muted: #b4b4b4;
      --divider: rgba(255, 204, 0, 0.08);
      --hover: rgba(255, 204, 0, 0.07);
    }

    body {
      margin: 0;
      display: flex;
      background: var(--bg);
      color: #fff;
      font-family: "Inter", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* SIDEBAR */
    .sidebar {
      width: 250px;
      background: rgba(10, 10, 10, 0.95);
      border-right: 1px solid var(--divider);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(8px);
    }

    /* LOGO */
    .sidebar-header {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 28px 0 24px;
    }

    .logo-img {
      width: 140px;
      height: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 10px rgba(255,204,0,0.3));
      transition: transform .3s ease, filter .3s ease;
    }

    .logo-img:hover {
      transform: scale(1.05);
      filter: drop-shadow(0 0 14px rgba(255,204,0,0.5));
    }

    /* MENU */
    .menu {
      display: flex;
      flex-direction: column;
      padding: 10px 20px 0;
      flex-grow: 1;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 18px;
      border-radius: 8px;
      color: var(--muted);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.25s ease;
      position: relative;
    }

    .menu a svg {
      width: 18px;
      height: 18px;
      stroke: var(--muted);
      stroke-width: 1.8;
      transition: stroke 0.25s ease;
    }

    .menu a:hover {
      background: var(--hover);
      color: var(--gold);
    }

    .menu a:hover svg {
      stroke: var(--gold);
    }

    .menu a.active {
      background: linear-gradient(90deg, rgba(255, 204, 0, 0.12), rgba(255, 204, 0, 0.05));
      color: #fff;
      font-weight: 600;
      box-shadow: inset 0 0 10px rgba(255, 204, 0, 0.15);
    }

    .menu a.active::before {
      content: "";
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 2px;
      background: linear-gradient(to bottom, #ffea70, #ffcc00, #d3a900);
      box-shadow: 0 0 6px rgba(255, 204, 0, 0.4);
    }

    .menu a.active svg {
      stroke: var(--gold);
    }

    .menu-divider {
      height: 1px;
      width: calc(100% - 40px);
      background: linear-gradient(to right, rgba(255, 204, 0, 0.05), rgba(255, 204, 0, 0.25), rgba(255, 204, 0, 0.05));
      margin: 18px auto;
    }

    /* RODAPÉ SIDEBAR */
    .menu-bottom {
      margin-top: auto;
      padding: 20px 25px 30px;
    }

    .menu-bottom a {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--gold);
      font-weight: 500;
      text-decoration: none;
      opacity: 0.8;
      transition: opacity 0.3s;
    }

    .menu-bottom a svg {
      width: 18px;
      height: 18px;
      stroke: var(--gold);
      stroke-width: 2;
    }

    .menu-bottom a:hover {
      opacity: 1;
    }

    /* MAIN CONTENT */
    .main-content {
      margin-left: 250px;
      flex: 1;
      padding: 40px;
      min-height: 100vh;
      box-sizing: border-box;
      position: relative;
    }

    /* Fade suave ao trocar de aba */
    @keyframes pageFadeQuick {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }

    body,
    main,
    .tiger-dashboard,
    .tiger-offers,
    .journey,
    .api-pix,
    .offers-page {
      animation: pageFadeQuick .25s ease-in forwards;
      will-change: opacity;
    }
  </style>
</head>

<body>
  <aside class="sidebar">
    <!-- LOGO -->
    <div class="sidebar-header">
      <img src="/img/logo-tigerfy.png" alt="TigerFy" class="logo-img" />
    </div>

    <!-- MENU -->
    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z" />
        </svg>
        Dashboard
      </a>

      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z" />
        </svg>
        Ofertas
      </a>

      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 18l6-6-6-6M8 6l-6 6 6 6" />
        </svg>
        Adquirentes
      </a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4s-4 1.79-4 4 1.79 4 4 4zm0 2c-4.42 0-8 1.79-8 4v2h16v-2c0-2.21-3.58-4-8-4z" />
        </svg>
        Meu Perfil
      </a>

      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4m0-4c3.314 0 6-2.686 6-6V5H6v6c0 3.314 2.686 6 6 6zM4 5h16M9 3h6" />
        </svg>
        Conquistas
      </a>

      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy%20⚡" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.5c4.694 0 8.5-3.806 8.5-8.5S16.694 3.5 12 3.5 3.5 7.306 3.5 12c0 1.293.293 2.517.818 3.607L3 21l5.548-1.414A8.468 8.468 0 0012 20.5z" />
        </svg>
        Suporte
      </a>
    </nav>

    <!-- LOGOUT -->
    <div class="menu-bottom">
      <a href="/logout">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5" />
        </svg>
        Sair
      </a>
    </div>
  </aside>

  <main class="main-content">
    <%- body %>
  </main>
</body>
</html>
