<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    /* FUNDO PONTILHADO PREMIUM */
    body {
      background: radial-gradient(circle, rgba(255,215,0,0.06) 1px, transparent 1px),
                  radial-gradient(circle, rgba(255,215,0,0.03) 1px, transparent 1px),
                  #0d0d0d !important;
      background-size: 90px 90px, 180px 180px;
      color: #fff;
      font-family: "Inter", sans-serif;
    }

    /* REMOVE MODO CLARO TOTAL */
    [data-theme="light"] {
      background: #0d0d0d !important;
      color: #fff !important;
    }

    /* SIDEBAR */
    .sidebar {
      width: 250px;
      background: #0a0a0a;
      border-right: 1px solid rgba(255, 204, 0, 0.08);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
    }

    /* LOGO TEXTO + SVG */
    .sidebar-header {
      padding: 26px 0 20px;
      text-align: center;
    }

    .tiger-logo {
      width: 40px;
      margin-bottom: 6px;
      opacity: 0.95;
    }

    .brand-name {
      font-family: "Poppins", sans-serif;
      font-size: 1.45rem;
      font-weight: 700;
      background: linear-gradient(90deg, #ffcc00, #d4a100);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* MENU */
    .menu {
      display: flex;
      flex-direction: column;
      padding: 10px 20px 0;
    }

    .menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 18px;
      border-radius: 10px;
      text-decoration: none;
      color: #b4b4b4;
      font-weight: 500;
      transition: 0.25s;
    }

    .menu a svg {
      width: 19px;
      height: 19px;
      stroke: #b4b4b4;
    }

    .menu a.active {
      background: rgba(255, 204, 0, 0.14);
      color: #fff;
      font-weight: 600;
      box-shadow: inset 0 0 14px rgba(255, 204, 0, 0.18);
      position: relative;
    }

    .menu a.active svg {
      stroke: #ffcc00;
    }

    .menu-divider {
      height: 1px;
      width: 100%;
      margin: 18px 0;
      background: linear-gradient(to right, transparent, rgba(255, 204, 0, 0.25), transparent);
    }

    /* SVG Estilo iOS para Conquistas */
    .trophy-icon {
      width: 21px;
      height: 21px;
      stroke: #b4b4b4;
      stroke-width: 1.8;
    }

    /* SVG Sair alinhado */
    .logout-icon {
      width: 20px;
      height: 20px;
      stroke-width: 2.3;
      margin-bottom: -1px; /* alinhar vertical */
    }

    /* CONTEÚDO PRINCIPAL */
    .main-content {
      margin-left: 250px;
      padding: 40px;
      min-height: 100vh;
      animation: fadeIn .25s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* LOADER CANTO DIREITO */
    #loaderBox {
      position: fixed;
      top: 24px;
      right: 32px;
      padding: 8px 18px;
      background: rgba(0,0,0,0.75);
      border: 1px solid rgba(255, 204, 0, 0.35);
      border-radius: 10px;
      font-size: .88rem;
      font-weight: 600;
      color: #ffcc00;
      display: none;
      z-index: 9999;
    }
  </style>
</head>

<body>

  <!-- LOADER -->
  <div id="loaderBox">Processando…</div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const loader = document.getElementById("loaderBox");

      loader.style.display = "block";

      setTimeout(() => {
        loader.innerText = "Concluído!";
        loader.classList.add("success");

        setTimeout(() => {
          loader.style.opacity = "0";
          setTimeout(() => {
            loader.style.display = "none";
            loader.style.opacity = "1";
          }, 300);
        }, 900);
      }, 450);
    });
  </script>

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="sidebar-header">
      <!-- Novo SVG do logo TigerFy -->
      <svg class="tiger-logo" viewBox="0 0 24 24" fill="none" stroke="#ffcc00" stroke-width="1.6">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M8 15c1.5-1 3.5-1 5 0M9 10h.01M15 10h.01"></path>
      </svg>

      <div class="brand-name">TigerFy</div>
    </div>

    <nav class="menu">

      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M3 3h7v7H3V3zm11 0h7v4h-7V3zm0 8h7v10h-7V11zM3 14h7v7H3v-7z"/>
        </svg>
        Dashboard
      </a>

      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M3 6a2 2 0 012-2h5l2 2h7a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6z"/>
        </svg>
        Ofertas
      </a>

      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>
        </svg>
        Adquirentes
      </a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 12c2.2 0 4-1.8 4-4s-1.8-4-4-4-4 1.8-4 4 1.8 4 4 4zm0 2c-4.4 0-8 1.8-8 4v2h16v-2c0-2.2-3.6-4-8-4z"/>
        </svg>
        Perfil
      </a>

      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">
        <svg class="trophy-icon" viewBox="0 0 24 24" fill="none">
          <path d="M8 21h8m-4-4v4m0-4c3.3 0 6-2.7 6-6V5H6v6c0 3.3 2.7 6 6 6zM4 5h16M9 3h6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Conquistas
      </a>

      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy⚡" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M12 20.5c4.7 0 8.5-3.8 8.5-8.5S16.7 3.5 12 3.5 3.5 7.3 3.5 12c0 1.3.3 2.5.8 3.6L3 21l5.5-1.4A8.4 8.4 0 0012 20.5z"/>
        </svg>
        Suporte
      </a>

    </nav>

    <div class="menu-bottom">
      <a href="/logout">
        <svg class="logout-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path d="M15 12H3m0 0l4-4m-4 4l4 4m8-8h5a2 2 0 012 2v6a2 2 0 01-2 2h-5"/>
        </svg>
        Sair
      </a>
    </div>

  </aside>


  <main class="main-content">
    <%- body %>
  </main>

</body>
</html>
