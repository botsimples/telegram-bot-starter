<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/tigerfy.css" />
  <script src="https://kit.fontawesome.com/4ac4b9c31e.js" crossorigin="anonymous"></script>
</head>

<body class="fade-in">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <i class="fa-solid fa-bolt"></i>
      <span>TigerFy</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/deck" class="<%= (title && title.includes('Deck')) ? 'active' : '' %>">
        <i class="fa-solid fa-chart-line"></i> Deck
      </a>
      <a href="/bots" class="<%= (title && title.includes('Ofertas')) ? 'active' : '' %>">
        <i class="fa-solid fa-layer-group"></i> Ofertas
      </a>
      <a href="/api_pix" class="<%= (title && title.includes('Adquirentes')) ? 'active' : '' %>">
        <i class="fa-solid fa-building-columns"></i> Adquirentes
      </a>
    </nav>

    <div class="sidebar-footer">
      <a href="/login"><i class="fa-solid fa-right-from-bracket"></i> Sair</a>
    </div>
  </aside>

  <main class="content">
    <%- body %>
  </main>
</body>
</html>
