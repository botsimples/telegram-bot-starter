<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title><%= title || "Painel BotSimples" %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-neutral-950 text-white flex h-screen">
  <% if (title && !title.includes("Login")) { %>
  <!-- Sidebar -->
  <aside class="w-64 bg-neutral-900 border-r border-neutral-800 flex flex-col justify-between">
    <div>
      <h1 class="text-hot-primary font-bold text-xl p-4">⚙️ BotSimples</h1>
      <nav class="flex flex-col">
        <a href="/dashboard" class="nav-link"><i>📊</i> Dashboard</a>
        <a href="/bots" class="nav-link"><i>💼</i> Ofertas</a>
        <a href="/api_pix" class="nav-link"><i>🏦</i> Adquirentes</a>
      </nav>
    </div>
    <div class="p-4 border-t border-neutral-800">
      <a href="/logout" class="text-red-400 hover:text-red-300">⛔ Sair</a>
    </div>
  </aside>
  <% } %>

  <!-- Conteúdo principal -->
  <main class="flex-1 overflow-y-auto p-8 flex items-center justify-center">
    <%- body %>
  </main>

  <style>
    .nav-link {
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: #ccc;
      transition: 0.2s;
    }
    .nav-link:hover {
      background: rgba(255,255,255,0.05);
      color: #fff;
    }
    .active {
      background: rgba(255,255,255,0.1);
      color: #ffb400;
    }
  </style>
</body>
</html>
