<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | TigerFy</title>

    <link rel="stylesheet" href="/css/tigerfy.css" />
    <link rel="stylesheet" href="/css/deck.theme.gold.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
      :root {
        --gold: #ffcc00;
        --sidebar-bg: rgba(10, 10, 10, 0.85);
        --hover-bg: rgba(255, 204, 0, 0.07);
        --divider: #1c1c1c;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        display: flex;
        color: #fff;
        background: radial-gradient(circle at top left, #111 0%, #000 100%);
        background-image:
          radial-gradient(rgba(255,204,0,0.07) 1px, transparent 1px),
          radial-gradient(rgba(255,204,0,0.04) 1px, transparent 1px);
        background-size: 60px 60px, 120px 120px;
        background-position: 0 0, 30px 30px;
        transition: background-position 120s linear infinite;
        animation: moveDots 220s linear infinite;
      }

      @keyframes moveDots {
        0% { background-position: 0 0, 30px 30px; }
        100% { background-position: 500px 500px, 530px 530px; }
      }

      .sidebar {
        width: 250px;
        backdrop-filter: blur(8px);
        background: var(--sidebar-bg);
        border-right: 1px solid var(--divider);
        display: flex;
        flex-direction: column;
        padding: 25px 0;
        position: fixed;
        height: 100vh;
        left: 0;
        top: 0;
        z-index: 5;
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding-left: 24px;
        margin-bottom: 30px;
      }

      .logo-icon { font-size: 22px; filter: drop-shadow(0 0 6px rgba(255, 204, 0, 0.6)); }
      .logo-text { font-family: "Poppins"; font-weight: 700; font-size: 21px; color: var(--gold); text-shadow: 0 0 6px rgba(255, 204, 0, 0.3); }

      nav.menu { display: flex; flex-direction: column; gap: 5px; }

      .menu a {
        display: flex; align-items: center; gap: 12px;
        text-decoration: none; color: #b4b4b4; font-weight: 500;
        padding: 10px 28px; border-radius: 8px; transition: all .25s;
      }

      .menu a:hover { background: var(--hover-bg); color: var(--gold); }

      .menu a.active {
        background: linear-gradient(to bottom, rgba(255, 204, 0, 0.18), rgba(255, 204, 0, 0.05));
        color: #fff; font-weight: 600;
      }

      .menu a.active::before {
        content: ""; position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px;
        border-radius: 2px; background: linear-gradient(to bottom, #ffea70, #ffcc00, #d3a900);
        box-shadow: 0 0 6px rgba(255, 204, 0, 0.4);
      }

      .menu-divider {
        height: 1px; width: calc(100% - 48px); align-self: center;
        background: linear-gradient(to right, rgba(255, 204, 0, 0.05), rgba(255, 204, 0, 0.25), rgba(255, 204, 0, 0.05));
        margin: 16px 0; border-radius: 1px;
      }

      .menu svg { width: 18px; height: 18px; stroke-width: 1.8; }

      .main-content {
        flex: 1; margin-left: 250px; padding: 40px;
        overflow-y: auto; min-height: 100vh;
        position: relative; z-index: 1;
      }

      body.ofertas-page { overflow: hidden !important; }
      body.ofertas-page .main-content { overflow: hidden !important; }
    </style>
  </head>

  <body class="<%= active === 'bots' ? 'ofertas-page' : '' %>">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo-icon">⚡</div>
        <span class="logo-text">TigerFy</span>
      </div>

      <nav class="menu">
        <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">📊 Deck</a>
        <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">⚡ Ofertas</a>
        <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">💳 Adquirentes</a>
        <div class="menu-divider"></div>
        <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">👤 Meu Perfil</a>
        <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">🏆 Conquistas</a>
        <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy%20⚡" target="_blank">💬 Suporte</a>
        <a href="/logout">🚪 Sair</a>
      </nav>
    </aside>

    <main class="main-content">
      <%- body %>
    </main>
  </body>
</html>
