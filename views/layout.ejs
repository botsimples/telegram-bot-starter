<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | TigerFy</title>

  <link rel="stylesheet" href="/css/theme.gold.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style>
    body, html {
      margin: 0;
      padding: 0;
      color: #fff;
      font-family: "Inter", sans-serif;
      background: #050505;
      height: 100%;
      overflow-x: hidden;
    }

    /* CANVAS DOS PONTINHOS */
    #bgParticles {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
    }

    .theme-toggle,
    #themeToggle,
    .mode-toggle {
      display: none !important;
    }

    .sidebar {
      width: 250px;
      background: #050505;
      border-right: 1px solid rgba(255, 204, 0, 0.08);
      display: flex;
      flex-direction: column;
      height: 100vh;
      position: fixed;
      left: 0;
      top: 0;
      z-index: 10;
    }

    .main-content {
      margin-left: 250px;
      padding: 40px;
      min-height: 100vh;
      width: 100%;
      box-sizing: border-box;
      animation: fadeIn 0.25s ease-out;
      position: relative;
      z-index: 5;
    }
  </style>
</head>

<body>
  <!-- CANVAS DOS PONTINHOS -->
  <canvas id="bgParticles"></canvas>

  <% if (userId) { %>
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="logo-mark">
        <svg viewBox="0 0 58 58"><circle cx="29" cy="29" r="27" stroke="#FFCC00" stroke-width="3"/></svg>
      </div>
      <div class="brand-name">TigerFy</div>
    </div>

    <nav class="menu">
      <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">Dashboard</a>
      <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">Ofertas</a>
      <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">Adquirentes</a>

      <div class="menu-divider"></div>

      <a href="/perfil" class="<%= active === 'perfil' ? 'active' : '' %>">Perfil</a>
      <a href="/conquistas" class="<%= active === 'conquistas' ? 'active' : '' %>">Conquistas</a>
      <a href="https://wa.me/5543999562213?text=Olá!%20Preciso%20de%20ajuda%20no%20TigerFy⚡" target="_blank">Suporte</a>
    </nav>

    <div class="menu-bottom">
      <a href="/logout">Sair</a>
    </div>
  </aside>
  <% } %>

  <main class="main-content <%= userId ? '' : 'no-sidebar' %>">
    <%- body %>
  </main>

  <!-- SCRIPT GLOBAL DO TIGERFY (animação + gráficos) -->
  <script src="/js/tigerfy.js"></script>

  <!-- Chart.js para gráficos -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- SCRIPT DAS PARTÍCULAS DO FUNDO -->
  <script>
    const canvas = document.getElementById("bgParticles");
    const ctx = canvas.getContext("2d");

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    const particles = Array.from({ length: 110 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: Math.random() * 1.4 + 0.4,
      s: Math.random() * 0.6 + 0.2
    }));

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = "rgba(255, 204, 0, 0.18)";
      particles.forEach(p => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
        p.y += p.s;
        if (p.y > canvas.height) p.y = -10;
      });
      requestAnimationFrame(draw);
    }
    draw();
  </script>

</body>
</html>
