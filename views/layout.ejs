<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tigerfy.css" />
  </head>
  <body>
    <% if (!title.includes('Login')) { %>
      <div class="sidebar">
        <div class="logo">
          ⚡ TigerFy
        </div>
        <nav class="menu">
          <a href="/deck" class="<%= active === 'deck' ? 'active' : '' %>">Deck</a>
          <a href="/bots" class="<%= active === 'bots' ? 'active' : '' %>">Ofertas</a>
          <a href="/api_pix" class="<%= active === 'api_pix' ? 'active' : '' %>">Adquirentes</a>
        </nav>
      </div>
    <% } %>

    <main class="<%= title.includes('Login') ? 'login-bg' : 'main-content' %>">

<script>
  // === Abrir e fechar modal ===
  function openModal(id) {
    document.getElementById(id).classList.add('active');
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }
</script>

      <%- body %>
    </main>
  </body>
</html>
