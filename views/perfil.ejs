<%- include('partials/visual_hottrack') %>

<main class="perfil-page">

  <!-- HEADER PREMIUM -->
  <section class="perfil-header">
    
    <!-- Avatar -->
    <div class="perfil-avatar">
      <img src="https://i.imgur.com/5iL8Llx.png" alt="TigerFy Avatar">
    </div>

    <!-- Nome + Info -->
    <h1 class="perfil-nome">Meu Perfil</h1>
    <p class="perfil-desc">Gerencie suas informações pessoais e preferências da sua conta.</p>

    <!-- TAXA FIXA -->
    <div class="perfil-taxa-card">
      <h3>Taxa Fixa por Venda</h3>
      <span>R$ 1,00</span>
    </div>

    <!-- BOTÕES SOCIAIS -->
    <div class="perfil-social-row">

      <a href="https://instagram.com/tigerfy_br" target="_blank" class="perfil-social-btn">
        <svg width="22" height="22" stroke="currentColor" fill="none" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="5" stroke-width="2"/>
          <circle cx="12" cy="12" r="4.5" stroke-width="2"/>
          <circle cx="17" cy="7" r="1.5" fill="currentColor"/>
        </svg>
        Instagram
      </a>

      <a href="https://discord.gg/tigerfy" target="_blank" class="perfil-social-btn">
        <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20 4.5a19.8 19.8 0 00-4.73-1.48.07.07 0 00-.08.04c-.2.35-.43.81-.59 1.17a18.3 18.3 0 00-5.21 0c-.16-.39-.39-.85-.6-1.17a.07.07 0 00-.08-.04A19.6 19.6 0 003 4.5a.06.06 0 00-.03.02C1.4 7.06 1 9.55 1.07 12c0 .02.01.04.03.05A19.9 19.9 0 007 17.5a.07.07 0 00.08-.02c.6-.82 1.13-1.7 1.59-2.62a.07.07 0 00-.04-.1 13 13 0 01-2.06-.98.07.07 0 01-.01-.11c.14-.1.28-.2.41-.3a.06.06 0 01.06-.01 13.1 13.1 0 0012.18 0 .06.06 0 01.06.01c.13.1.27.2.41.3a.07.07 0 010 .11c-.66.39-1.35.72-2.06.98a.07.07 0 00-.04.1c.46.92.99 1.8 1.59 2.62a.07.07 0 00.08.02 19.9 19.9 0 005.9-5.45A.07.07 0 0023 12c.08-2.45-.33-4.94-1.97-7.48a.06.06 0 00-.03-.02z"/>
        </svg>
        Discord
      </a>

      <a href="https://wa.me/5543999562213" target="_blank" class="perfil-social-btn">
        <svg width="22" height="22" stroke="currentColor" fill="none" viewBox="0 0 24 24">
          <path d="M20 11.5a8.5 8.5 0 11-15.54 4.76L3 21l4.03-1.41A8.5 8.5 0 1120 11.5z" stroke-width="2" stroke-linecap="round" />
          <path d="M9 9.5c.2 1.8 1.8 3.4 3.6 3.6l1-.8c.2-.2.6-.2.8.1l1 1c.2.3.2.7-.1.9-.8.7-1.7 1.2-2.8 1.2A6 6 0 018 9.5c0-1.1.4-2 1.1-2.8.2-.3.6-.3.9-.1l1 1c.3.3.3.7.1.9l-.9 1z" fill="currentColor"/>
        </svg>
        WhatsApp
      </a>

    </div>
  </section>

  <!-- CARDS SECUNDÁRIOS -->
  <section class="perfil-grid">

    <div class="perfil-card">
      <h3>Editar Dados</h3>
      <p>Atualize nome, e-mail e senha.</p>
      <button>Editar</button>
    </div>

    <div class="perfil-card">
      <h3>Configurações</h3>
      <p>Ajuste preferências de aparência e alertas.</p>
      <button>Configurar</button>
    </div>

    <div class="perfil-card">
      <h3>Planos</h3>
      <p>Gerencie seu plano atual e benefícios.</p>
      <button>Gerenciar</button>
    </div>

    <div class="perfil-card">
      <h3>Excluir Conta</h3>
      <p>Remova permanentemente seu acesso.</p>
      <button class="danger">Excluir</button>
    </div>

  </section>

</main>

<style>
/* ======================================
   BASE
====================================== */
html, body {
  background: #050505;
  margin: 0;
  padding: 0;
  color: #fff;
  font-family: "Inter", sans-serif;
  overflow-x: hidden;
}

/* ======================================
   HEADER — AVATAR + TAXA + SOCIAL
====================================== */
.perfil-page {
  width: 100%;
  padding-left: 250px;
  padding-top: 40px;
}

.perfil-header {
  text-align: center;
  margin: 0 auto;
  margin-bottom: 40px;
}

.perfil-avatar img {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  filter: drop-shadow(0 0 18px rgba(255, 204, 0, 0.35));
}

.perfil-nome {
  margin-top: 18px;
  font-size: 2.1rem;
  background: linear-gradient(90deg, #ffcc00, #d4a100);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.perfil-desc {
  color: #b4b4b4;
  margin-top: 6px;
}

/* TAXA FIXA CARD */
.perfil-taxa-card {
  margin: 25px auto;
  width: 260px;
  padding: 16px;
  border-radius: 14px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,204,0,0.18);
  box-shadow: 0 0 18px rgba(255,204,0,0.15);
}

.perfil-taxa-card h3 {
  margin: 0;
  font-weight: 600;
}

.perfil-taxa-card span {
  font-size: 1.6rem;
  font-weight: 700;
  color: #ffcc00;
}

/* SOCIAL BUTTONS */
.perfil-social-row {
  margin-top: 25px;
  display: flex;
  justify-content: center;
  gap: 20px;
}

.perfil-social-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  padding: 10px 18px;
  border-radius: 10px;
  color: #ffcc00;
  font-weight: 600;
  border: 1px solid rgba(255,204,0,0.25);
  transition: 0.25s;
}

.perfil-social-btn:hover {
  background: rgba(255,204,0,0.13);
  transform: translateY(-3px);
}

/* ======================================
   GRID DE CARDS SECUNDÁRIOS
====================================== */
.perfil-grid {
  display: grid;
  margin: 0 auto;
  max-width: 950px;
  gap: 25px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.perfil-card {
  background: rgba(255,255,255,0.03);
  padding: 25px;
  border-radius: 14px;
  border: 1px solid rgba(255,204,0,0.15);
  text-align: center;
  transition: 0.25s ease;
}

.perfil-card:hover {
  background: rgba(255,204,0,0.07);
  box-shadow: 0 0 15px rgba(255,204,0,0.25);
  transform: translateY(-3px);
}

.perfil-card button {
  margin-top: 15px;
  background: linear-gradient(90deg, #ffcc00, #d4a100);
  border: none;
  padding: 8px 16px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.perfil-card button.danger {
  background: linear-gradient(90deg, #ff5d5d, #ff3838);
}
</style>
