<%- include('layout', { title: 'Meu Perfil', active: 'perfil', body: `
  <canvas id="bgParticles"></canvas>

  <main class="offers-page">
    <section class="offers-container">
      <header class="offers-header">
        <h1>👤 Meu Perfil</h1>
        <p>Gerencie suas informações pessoais e preferências da conta.</p>
      </header>

      <div class="offers-grid">
        <div class="offer-card">
          <h3>Editar Informações</h3>
          <p>Atualize seu nome, e-mail ou senha com segurança.</p>
          <button class="offer-btn">Editar</button>
        </div>

        <div class="offer-card">
          <h3>Segurança</h3>
          <p>Gerencie autenticação e dispositivos conectados.</p>
          <button class="offer-btn">Configurar</button>
        </div>

        <div class="offer-card">
          <h3>Preferências</h3>
          <p>Personalize notificações e aparência do painel.</p>
          <button class="offer-btn">Abrir</button>
        </div>

        <div class="offer-card">
          <h3>Assinatura</h3>
          <p>Gerencie seu plano e histórico de pagamento.</p>
          <button class="offer-btn">Gerenciar</button>
        </div>
      </div>
    </section>
  </main>

  <script>
    const c=document.getElementById('bgParticles');const ctx=c.getContext('2d',{alpha:true});
    let w,h,DPR=window.devicePixelRatio||1;function resize(){w=innerWidth;h=innerHeight;c.width=w*DPR;c.height=h*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);}resize();
    addEventListener('resize',resize,{passive:true});
    const p=[];for(let i=0;i<60;i++)p.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.2+0.4,dx:(Math.random()-.5)*.25,dy:(Math.random()-.5)*.25});
    function draw(){ctx.clearRect(0,0,w,h);ctx.fillStyle='rgba(255,204,0,0.25)';
      for(const o of p){ctx.beginPath();ctx.arc(o.x,o.y,o.r,0,Math.PI*2);ctx.fill();o.x+=o.dx;o.y+=o.dy;if(o.x<0||o.x>w)o.dx*=-1;if(o.y<0||o.y>h)o.dy*=-1;}requestAnimationFrame(draw);}draw();
  </script>

  <style>
    html,body{margin:0;padding:0;height:100%;width:100%;overflow:hidden!important;background:#0a0a0a;-webkit-font-smoothing:antialiased;}
    *{box-sizing:border-box;}::-webkit-scrollbar{display:none!important;}
    #bgParticles{position:fixed;inset:0;width:100vw;height:100vh;z-index:0;mix-blend-mode:screen;pointer-events:none;background-image:radial-gradient(rgba(255,255,255,0.03) 1px,transparent 1px);background-size:20px 20px;}
    main.offers-page{position:relative;z-index:1;height:100vh;display:flex;justify-content:center;align-items:center;padding-left:70px;}
    .offers-container{text-align:center;width:90%;max-width:1100px;}
    .offers-header h1{color:#ffcc00;font-size:2rem;margin-bottom:10px;}
    .offers-header p{color:#b4b4b4;margin-bottom:40px;}
    .offers-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:25px;justify-items:center;}
    .offer-card{width:260px;height:260px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,204,0,0.12);border-radius:14px;padding:25px;display:flex;flex-direction:column;justify-content:space-between;align-items:center;transition:.25s ease-out;will-change:transform,box-shadow,background;}
    .offer-card:hover:not(.disabled){background:rgba(255,204,0,0.07);box-shadow:0 0 15px rgba(255,204,0,0.25);transform:translateY(-3px);}
    .offer-card h3{color:#fff;margin:10px 0 5px;}
    .offer-card p{color:#b4b4b4;font-size:.9rem;min-height:45px;}
    .offer-btn{background:linear-gradient(90deg,#ffcc00,#d4a100);color:#000;border:none;border-radius:8px;padding:8px 16px;font-weight:600;cursor:pointer;transition:filter .3s;}
    .offer-btn:hover{filter:brightness(1.15);}
  </style>
` }) %>
