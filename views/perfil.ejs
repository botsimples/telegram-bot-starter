<%- include('layout', { title: 'Perfil', active: 'perfil', body: `
  <canvas id="bgParticles"></canvas>

  <div class="tiger-dashboard fade-in">
    <h1>👤 Meu Perfil</h1>
    <p>Gerencie suas informações pessoais e preferências.</p>

    <div class="profile-container">
      <div class="profile-card">
        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="avatar" class="profile-avatar">
        <h2>Usuário TigerFy</h2>
        <p>Email: usuario@tigerfy.com</p>
        <button class="edit-btn">Editar Perfil</button>
      </div>
    </div>
  </div>

  <script>
    const c=document.getElementById('bgParticles');
    const ctx=c.getContext('2d',{alpha:true});
    let w,h,DPR=window.devicePixelRatio||1;
    function resize(){w=innerWidth;h=innerHeight;c.width=w*DPR;c.height=h*DPR;ctx.setTransform(DPR,0,0,DPR,0,0);}
    resize();addEventListener('resize',resize,{passive:true});
    const p=[];for(let i=0;i<60;i++)p.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.2+0.4,dx:(Math.random()-.5)*.25,dy:(Math.random()-.5)*.25});
    function draw(){ctx.clearRect(0,0,w,h);ctx.fillStyle='rgba(255,204,0,0.25)';
      for(const o of p){ctx.beginPath();ctx.arc(o.x,o.y,o.r,0,Math.PI*2);ctx.fill();o.x+=o.dx;o.y+=o.dy;if(o.x<0||o.x>w)o.dx*=-1;if(o.y<0||o.y>h)o.dy*=-1;}
      requestAnimationFrame(draw);}
    draw();
  </script>
` }) %>
