<%- include('partials/visual_hottrack') %>

<main class="perfil-page">

  <!-- HEADER -->
  <section class="perfil-header">
    <h1>Meu Perfil</h1>
    <p>Gerencie suas informações pessoais, plano e acessos.</p>
  </section>

  <!-- GRID PRINCIPAL -->
  <section class="perfil-grid">

    <!-- Editar Dados -->
    <div class="perfil-card">
      <h3>Editar Dados</h3>
      <p>Atualize nome, e-mail e senha.</p>
      <button class="perfil-btn">Editar</button>
    </div>

    <!-- Configurações -->
    <div class="perfil-card">
      <h3>Configurações</h3>
      <p>Personalize notificações e preferências da conta.</p>
      <button class="perfil-btn">Configurar</button>
    </div>

    <!-- Planos -->
    <div class="perfil-card">
      <h3>Planos</h3>
      <p>Veja e altere seu plano atual.</p>
      <button class="perfil-btn">Gerenciar</button>
    </div>

    <!-- Ofertas cadastradas -->
    <div class="perfil-card">
      <h3>Ofertas</h3>
      <p>Total de ofertas cadastradas.</p>
      <div class="perfil-counter"><%= ofertasCount || 0 %></div>
    </div>

    <!-- Instagram -->
    <div class="perfil-card">
      <h3>Instagram</h3>
      <p>Siga a TigerFy e acompanhe as novidades.</p>
      <a href="https://instagram.com/TigerFyApp" target="_blank" class="perfil-btn">Acessar</a>
    </div>

    <!-- Discord -->
    <div class="perfil-card">
      <h3>Discord</h3>
      <p>Entre no servidor oficial da TigerFy.</p>
      <a href="https://discord.gg/tigerfy" target="_blank" class="perfil-btn">Entrar</a>
    </div>

    <!-- WhatsApp -->
    <div class="perfil-card">
      <h3>WhatsApp</h3>
      <p>Fale conosco rapidamente pelo WhatsApp.</p>
      <a href="https://wa.me/5543999562213" target="_blank" class="perfil-btn">Abrir</a>
    </div>

    <!-- Excluir Conta -->
    <div class="perfil-card delete">
      <h3>Excluir Conta</h3>
      <p>Remova permanentemente seu acesso.</p>
      <button class="perfil-btn delete-btn">Excluir</button>
    </div>

  </section>
</main>

<style>

html,body {
  margin:0;
  padding:0;
  overflow-x:hidden;
  -webkit-font-smoothing: antialiased;
  background:#000;
}

.perfil-page {
  min-height:100vh;
  width:100%;
  position:relative;
  z-index:1;
  padding-left:70px;
  padding-top:60px;
  text-align:center;
}

.perfil-header h1 {
  color:#ffcc00;
  font-size:2.2rem;
  margin-bottom:8px;
}

.perfil-header p {
  color:#b4b4b4;
  margin-bottom:40px;
}

/* GRID */
.perfil-grid {
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap:28px;
  width:90%;
  max-width:1100px;
  margin:0 auto;
}

/* CARDS */
.perfil-card {
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,204,0,0.12);
  border-radius:14px;
  padding:28px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  align-items:center;
  height:260px;
  transition:.25s cubic-bezier(.25,.1,.25,1);
}

.perfil-card:hover {
  background:rgba(255,204,0,0.07);
  transform:translateY(-3px);
  box-shadow:0 0 16px rgba(255,204,0,0.25);
}

.perfil-card h3 {
  color:#fff;
  margin:10px 0 5px;
}

.perfil-card p {
  color:#b4b4b4;
  font-size:.9rem;
  min-height:40px;
}

/* BOTÃO */
.perfil-btn {
  background:linear-gradient(90deg,#ffcc00,#d4a100);
  color:#000;
  border:none;
  padding:10px 18px;
  border-radius:8px;
  cursor:pointer;
  font-weight:700;
  transition:filter .25s;
  text-decoration:none;
  display:inline-block;
}

.perfil-btn:hover {
  filter:brightness(1.15);
}

/* COUNTER */
.perfil-counter {
  font-size:2.2rem;
  font-weight:700;
  color:#ffcc00;
  margin-top:10px;
}

/* DELETE */
.delete {
  border:1px solid rgba(255,80,80,0.25);
}

.delete-btn {
  background:#ff4444;
  color:#fff;
}

.delete-btn:hover {
  filter:brightness(1.15);
}

/* Fade rápido */
@keyframes pageFadeQuick {
  0% { opacity:0; }
  100% { opacity:1; }
}

.perfil-page {
  animation: pageFadeQuick .25s ease-out forwards;
}

</style>

