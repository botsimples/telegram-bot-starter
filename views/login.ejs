<% title = "Login - BotSimples"; %>
<main class="max-w-sm mx-auto space-y-4">
  <h1 class="text-2xl font-semibold text-hot-primary">Entrar</h1>
  <form method="post" action="/login" class="panel p-4 space-y-3">
    <input class="input w-full" type="text" name="user" placeholder="Usuário">
    <input class="input w-full" type="password" name="pass" placeholder="Senha">
    <button class="btn w-full" type="submit">Entrar</button>
  </form>
  <% if (typeof message !== 'undefined' && message) { %>
    <p class="text-red-400 text-sm"><%= message %></p>
  <% } %>
</main>
