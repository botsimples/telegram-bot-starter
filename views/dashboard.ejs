<% title = "Deck - BotSimples"; %>

<main class="p-8 w-full max-w-7xl mx-auto animate-fadeIn">
  <h1 class="text-3xl font-semibold text-hot-primary mb-6">📊 Deck</h1>

  <!-- Cards superiores -->
  <div class="grid md:grid-cols-4 gap-5">
    <div class="panel text-center py-5">
      <h3 class="text-neutral-400 text-sm">Cliques na Página</h3>
      <p class="text-2xl font-bold mt-1 text-white">0</p>
    </div>
    <div class="panel text-center py-5">
      <h3 class="text-neutral-400 text-sm">PIX Gerados</h3>
      <p class="text-2xl font-bold mt-1 text-white">0</p>
    </div>
    <div class="panel text-center py-5">
      <h3 class="text-neutral-400 text-sm">Faturamento Total</h3>
      <p class="text-2xl font-bold mt-1 text-green-400">R$0,00</p>
    </div>
    <div class="panel text-center py-5">
      <h3 class="text-neutral-400 text-sm">PIX Pagos</h3>
      <p class="text-2xl font-bold mt-1 text-green-400">0</p>
    </div>
  </div>

  <!-- Gráfico -->
  <section class="mt-8 panel p-6">
    <h2 class="font-semibold text-lg text-hot-primary mb-3">📈 Desempenho de Faturamento</h2>
    <div class="h-64 flex items-center justify-center text-neutral-500 italic">
      (gráfico aqui futuramente)
    </div>
  </section>

  <!-- Tabelas -->
  <div class="grid md:grid-cols-2 gap-6 mt-8">
    <div class="panel p-4">
      <h3 class="text-lg text-white mb-3">👥 Usuários</h3>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-neutral-800 text-left">
            <th class="p-2">ID</th>
            <th class="p-2">Nome</th>
            <th class="p-2">Username</th>
            <th class="p-2">Data</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>

    <div class="panel p-4">
      <h3 class="text-lg text-white mb-3">💰 Pagamentos</h3>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-neutral-800 text-left">
            <th class="p-2">ID Pagamento</th>
            <th class="p-2">Usuário</th>
            <th class="p-2">Valor</th>
            <th class="p-2">Status</th>
            <th class="p-2">Data</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</main>
