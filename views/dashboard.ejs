<% title = "Deck - BotSimples"; %>
<main class="space-y-6">
  <h1 class="text-2xl font-semibold text-hot-primary">Dashboard</h1>

  <section class="panel p-4">
    <h3 class="font-medium mb-3">Usuários</h3>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-neutral-800">
            <th class="p-3 text-left">ID</th>
            <th class="p-3 text-left">Nome</th>
            <th class="p-3 text-left">Username</th>
            <th class="p-3 text-left">Data</th>
          </tr>
        </thead>
        <tbody>
          <% (users || []).forEach(u => { %>
          <tr class="odd:bg-neutral-900/40">
            <td class="p-3"><%= u.telegramId %></td>
            <td class="p-3"><%= (u.firstName||'') %> <%= (u.lastName||'') %></td>
            <td class="p-3">@<%= u.username || '' %></td>
            <td class="p-3"><%= (u.dateJoined && u.dateJoined.toLocaleDateString) ? u.dateJoined.toLocaleDateString() : '' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel p-4">
    <h3 class="font-medium mb-3">Pagamentos</h3>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="bg-neutral-800">
            <th class="p-3 text-left">ID Pagamento</th>
            <th class="p-3 text-left">ID Usuário</th>
            <th class="p-3 text-left">Valor</th>
            <th class="p-3 text-left">Status</th>
            <th class="p-3 text-left">Data</th>
          </tr>
        </thead>
        <tbody>
          <% (payments || []).forEach(p => { %>
          <tr class="odd:bg-neutral-900/40">
            <td class="p-3"><%= p.paymentId %></td>
            <td class="p-3"><%= p.telegramId %></td>
            <td class="p-3">R$ <%= (p.amount||0).toFixed ? p.amount.toFixed(2) : p.amount %></td>
            <td class="p-3"><%= p.status %></td>
            <td class="p-3"><%= (p.date && p.date.toLocaleDateString) ? p.date.toLocaleDateString() : '' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>
